<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI awareness is declared in app.manifest, not here - see the comment
         there. ApplicationHighDpiMode used to be set to PerMonitorV2 at this
         spot and did nothing at all, because it only reaches the WinForms
         entry point this app doesn't use; it just made the setting look
         handled. WFAC010 is the WinForms SDK objecting to the manifest owning
         this instead, which is correct for a WPF-entry app. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>2.9.0</Version>
    <!-- Explicit rather than left to default from the .csproj filename, so a
         future file rename can't silently change the shipped exe/dll name
         again - the C# namespace stays SidebarExplorer.App throughout the
         source (an app-identity rename, not a source-level one). -->
    <AssemblyName>Edgetree</AssemblyName>
    <Product>Edgetree</Product>
  </PropertyGroup>

  <!-- MEASURING BUILD: Release code generation with the instruments still in.
       Every instrument in this app is [Conditional("DEBUG")] or #if DEBUG, so
       a Release build carries none of them - which left every performance
       figure on file measured in Debug, where the app's own code runs
       unoptimised. A Debug number cannot say what a user gets.

       Defining DEBUG here does not touch Optimize; it only puts the
       instruments back. The root label reads "(계측)" instead of "(DEBUG)" so a
       measuring build is never mistaken for either of the other two.

         dotnet build -c Release -p:EdgetreeInstrument=true

       Never pass this for a release asset. The property is NOT called
       "Instrument": that name is already MSBuild's, and it reaches the
       compiler as /instrument:true - "error CS8111: Invalid instrumentation
       kind: true". -->
  <PropertyGroup Condition="'$(EdgetreeInstrument)' == 'true'">
    <DefineConstants>$(DefineConstants);DEBUG;INSTRUMENT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\**\*.png" />
    <Resource Include="Resources\icon-map.json" />
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\icon.png" />
    <!-- Apache-2.0 section 4a wants a copy of the licence IN the distribution,
         which a link cannot satisfy - and this app ships as a single exe with no
         folder to drop a text file into. So it rides inside the exe, and the
         About window writes it out and opens it on request. -->
    <Resource Include="Resources\APACHE-2.0.txt" />
    <!-- The same reasoning for MIT, which asks for the copyright and permission
         notice in every copy: AvalonEdit's (the text view) and the icon theme's,
         opened from the About window the same way. -->
    <Resource Include="Resources\THIRD-PARTY-NOTICES.txt" />
    <!-- Compiled ps_2_0 bytecode for the HDR tone map, committed rather than
         built: WPF's ShaderEffect wants a .ps blob, and producing one needs an
         HLSL compiler that is not part of this toolchain (no Windows SDK on the
         build machine, and the project carried no package dependencies when
         this was decided - AvalonEdit below, added later, is a runtime one).
         The .hlsl beside it is the source of truth for a human; regenerate the
         blob with tools\compile-shader.ps1, which borrows the D3DCompile that
         already ships inside Windows. -->
    <Resource Include="Resources\HdrToneMap.ps" />
    <None Include="Resources\HdrToneMap.hlsl" />
    <!-- The panel's Markdown highlighting; colours and sizes are written in at
         load time (see the file's header and ViewerTextEditor). -->
    <Resource Include="Resources\Markdown.xshd" />
  </ItemGroup>

  <!-- THE PROJECT'S FIRST PACKAGE (2026-10-11), for the panel's TXT/MD view.
       AvalonEdit draws only the lines on screen, where a WPF TextBox lays out
       the whole text - the sluggishness on long files that started the round.
       MIT, no dependencies of its own, one 622,592-byte DLL; the light exe
       grows by about that much. -->
  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>
  <!-- PDFium for the panel's PDF view (2026-10-27), as a FILE WE EMBED rather
       than a package asset. With its assets on, the native DLL is copied beside
       the exe, and the light build (single file, no native self-extract) would
       then lose PDFs the moment the exe is moved on its own. So the package is
       only a pinned download: nothing of it reaches the build output, and the
       x64 DLL rides inside the exe to be written out on the first PDF - see
       PdfRenderService. 157.0.8100 = chromium/8100 (2026-10-12), no V8; the
       x64 DLL is 7,512,064 bytes. -->
  <ItemGroup>
    <PackageReference Include="bblanchon.PDFium.Win32" Version="157.0.8100"
                      IncludeAssets="none" PrivateAssets="all" GeneratePathProperty="true" />
    <EmbeddedResource Include="$(Pkgbblanchon_PDFium_Win32)\runtimes\win-x64\native\pdfium.dll"
                      LogicalName="Edgetree.Native.pdfium.dll"
                      Visible="false" />
  </ItemGroup>

  <!-- Microsoft.VisualBasic.FileIO.FileSystem.Delete*(..., RecycleOption.SendToRecycleBin)
       (the simplest reliable way to send deleted items to the Recycle Bin) is
       already available transitively via UseWindowsForms above - an explicit
       <Reference> here just duplicates and conflicts with it. -->

</Project>
