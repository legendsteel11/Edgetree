<Window x:Class="SidebarExplorer.App.FilterExtensionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SidebarExplorer.App.Services"
        SizeToContent="Height"
        Width="{DynamicResource DialogWidth}"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        FontSize="{DynamicResource DialogFontSize}"
        Background="{DynamicResource DialogBackground}">
    <!-- Chrome copied from AboutWindow rather than shared: the two close
         buttons are eight lines of template each and a shared dictionary for
         them would be a third file to keep in step. Everything that has to
         follow Ctrl +/- (font size, title bar height, button width) comes from
         App-level resources, which is what makes the zoom reach a window drawn
         outside the tree. -->
    <Window.Resources>
        <Style x:Key="DialogCloseButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Width"
                    Value="28"/>
            <Setter Property="Height"
                    Value="28"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource DialogForeground}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource DialogFontSize}"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,6"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackground}"/>
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ControlHoverBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Bar and title both grow with the font and both stop on the
                     way down - see HelpWindow, where the missing floor under
                     the title was caught. -->
                <RowDefinition Height="{DynamicResource DialogTitleBarHeight}"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                    x:Name="HeaderGrid"
                    Background="{DynamicResource DialogHeaderBackground}"
                    MouseLeftButtonDown="HeaderGrid_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText"
                        Foreground="{DynamicResource DialogForeground}"
                        FontSize="{DynamicResource DialogTitleTextSize}"
                        VerticalAlignment="Center"
                        Margin="{DynamicResource DialogTitleIndent}"/>
                <Button Style="{StaticResource DialogCloseButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        ToolTip="{x:Static services:Strings.ButtonClose}"
                        Click="CancelButton_Click">
                    <Path Data="M4,4 L12,12 M12,4 L4,12"
                            Stroke="{DynamicResource DialogForeground}"
                            StrokeThickness="1.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1"
                    Margin="16">
                <TextBox x:Name="ExtensionsBox"
                        Background="{DynamicResource ControlBackground}"
                        Foreground="{DynamicResource DialogForeground}"
                        CaretBrush="{DynamicResource DialogForeground}"
                        BorderBrush="{DynamicResource ControlBorder}"
                        BorderThickness="1"
                        FontSize="{DynamicResource DialogFontSize}"
                        Padding="6,5"
                        Loaded="ExtensionsBox_Loaded"
                        TextChanged="ExtensionsBox_TextChanged"
                        KeyDown="ExtensionsBox_KeyDown"/>

                <!-- The hint sits UNDER the box and swaps for the "empty means
                     remove it" line while the box is empty. Two lines would
                     make a two-line dialog out of a one-line question, and the
                     second only matters in the state that shows it. -->
                <TextBlock x:Name="HintText"
                        Foreground="{DynamicResource SecondaryForeground}"
                        FontSize="{DynamicResource DialogHintFontSize}"
                        TextWrapping="Wrap"
                        Margin="0,6,0,0"/>

                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                    <Button Content="{x:Static services:Strings.ButtonCancel}"
                            Style="{StaticResource DialogButtonStyle}"
                            Width="{DynamicResource DialogButtonWidth}"
                            Margin="0,0,6,0"
                            IsCancel="True"
                            Click="CancelButton_Click"/>
                    <Button Content="{x:Static services:Strings.ButtonOk}"
                            Style="{StaticResource DialogButtonStyle}"
                            Width="{DynamicResource DialogButtonWidth}"
                            IsDefault="True"
                            Click="OkButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
