<Window x:Class="SidebarExplorer.App.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SidebarExplorer.App.Services"
        Title="{x:Static services:Strings.PrintPreviewTitle}"
        MinWidth="380"
        MinHeight="300"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        FontSize="{DynamicResource DialogFontSize}"
        Background="{DynamicResource DialogBackground}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- The text view's print preview (2026-10-13). Chrome as HelpWindow's,
         the other resizable dialog, for the reason recorded there (no bright
         system frame over our own title bar); the two button styles are
         copied from PresetNameWindow, as every dialog here copies them. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                GlassFrameThickness="0"
                ResizeBorderThickness="6"
                CornerRadius="0"
                UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="DialogCloseButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Width"
                    Value="28"/>
            <Setter Property="Height"
                    Value="28"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource DialogForeground}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource DialogFontSize}"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,6"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackground}"/>
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ControlHoverBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="{DynamicResource DialogTitleBarHeight}"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                    x:Name="HeaderGrid"
                    Background="{DynamicResource DialogHeaderBackground}"
                    MouseLeftButtonDown="HeaderGrid_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="{DynamicResource DialogTitleIndent}">
                    <Image Source="pack://application:,,,/Resources/icon.png"
                            Width="{DynamicResource DialogTitleTextSize}"
                            Height="{DynamicResource DialogTitleTextSize}"
                            Margin="0,0,7,0"
                            RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="TitleText"
                            Foreground="{DynamicResource DialogForeground}"
                            FontSize="{DynamicResource DialogTitleTextSize}"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource DialogCloseButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        ToolTip="{x:Static services:Strings.ButtonClose}"
                        Click="CloseButton_Click">
                    <Path Data="M4,4 L12,12 M12,4 L4,12"
                            Stroke="{DynamicResource DialogForeground}"
                            StrokeThickness="1.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <!-- The pages. DocumentViewer for what it does with them - one
                 page across, fitted to the width, only the pages in view
                 drawn, Ctrl+wheel to zoom - under a template of nothing but
                 its scroll host, so none of its own toolbar or find box comes
                 along. The app's scroll bar, as every window here has it. -->
            <DocumentViewer x:Name="Viewer"
                    Grid.Row="1"
                    MaxPagesAcross="1"
                    Background="{DynamicResource DialogHeaderBackground}">
                <DocumentViewer.Template>
                    <ControlTemplate TargetType="DocumentViewer">
                        <ScrollViewer x:Name="PART_ContentHost"
                                Template="{StaticResource MinimalScrollViewerTemplate}"
                                Background="{TemplateBinding Background}"
                                CanContentScroll="True"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto"
                                Focusable="False"/>
                    </ControlTemplate>
                </DocumentViewer.Template>
            </DocumentViewer>

            <!-- A PDF's pages instead (2026-10-27): a column of its own
                 (PdfPrintPreviewColumn), set as the content in code. Not a
                 FixedDocument in the viewer above - that would draw every
                 page up front, where a PDF's are drawn as they come into
                 view. -->
            <ScrollViewer x:Name="PdfScroller"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    Template="{StaticResource MinimalScrollViewerTemplate}"
                    Background="{DynamicResource DialogHeaderBackground}"
                    CanContentScroll="False"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    Focusable="False"/>

            <Border Grid.Row="2"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource SeparatorBrush}"
                    Padding="14,10">
                <Grid>
                    <TextBlock x:Name="PageCountText"
                            Foreground="{DynamicResource DialogForeground}"
                            VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                        <Button Content="{x:Static services:Strings.PrintPreviewPrint}"
                                Style="{StaticResource DialogButtonStyle}"
                                MinWidth="{DynamicResource DialogButtonWidth}"
                                ToolTip="Ctrl+P"
                                Click="PrintButton_Click"/>
                        <Button Content="{x:Static services:Strings.ButtonClose}"
                                Style="{StaticResource DialogButtonStyle}"
                                Width="{DynamicResource DialogButtonWidth}"
                                Margin="8,0,0,0"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
