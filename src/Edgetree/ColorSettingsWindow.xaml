<Window x:Class="SidebarExplorer.App.ColorSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SidebarExplorer.App.Services"
        Title="{x:Static services:Strings.ColorSettingsTitle}"
        SizeToContent="Height"
        Width="{DynamicResource ColorDialogWidth}"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        FontSize="{DynamicResource DialogFontSize}"
        Background="{DynamicResource DialogBackground}">
    <Window.Resources>
        <Style x:Key="DialogCloseButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Width"
                    Value="28"/>
            <Setter Property="Height"
                    Value="28"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorRowLabelStyle"
                TargetType="TextBlock">
            <!-- Trimmed rather than allowed to run under the hex box beside
                 it: the label column is the one that gives way when a long
                 Korean label meets a fixed-width field (2026-08-02). -->
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource DialogForeground}"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource DialogFontSize}"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="ColorSwatchStyle"
                TargetType="Border">
            <!-- Scaled with the rest (ApplyLayoutMetrics): a swatch is the
                 thing being aimed at in this window, so it has no business
                 staying 32x20 while everything around it grows. -->
            <Setter Property="Width"
                    Value="{DynamicResource DialogSwatchWidth}"/>
            <Setter Property="Height"
                    Value="{DynamicResource DialogSwatchHeight}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="3"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

        <!-- 체인: the rows whose link is lit hold ONE colour between them -
             set any of them and the rest follow. A lone lit link moves
             nothing, so turning one off is how a row is held still while the
             others stay joined.

             It reads the rows the user lit, not a table of pairs the app
             decided on. That table was the first cut and it broke the promise
             the mark makes: a link on a row says THAT row can be joined, and
             two lit rows that happened to sit in different pairs did nothing
             at all when one of them was set (2026-08-15).

             The mark changes rather than dimming: link when joined, link_off
             when not, and the accent only on the joined one. An icon at
             reduced opacity would say "unavailable" here, which is the same
             mistake the theme buttons already made once and undid. Material
             Symbols "link" / "link_off", supplied 2026-08-15. -->
        <Style x:Key="ChainToggleStyle"
                TargetType="ToggleButton">
            <Setter Property="Width"
                    Value="{DynamicResource DialogSwatchHeight}"/>
            <Setter Property="Height"
                    Value="{DynamicResource DialogSwatchHeight}"/>
            <!-- The gap is on the RIGHT: the link sits BEFORE the hex box, so
                 that the hex box and the swatch line up down the whole window.
                 Put after them it pushed those two left on the ten rows that
                 have a link and left the other seven where they were, and the
                 column read as ragged (2026-08-15). Hanging off the left costs
                 the label a little width and lines up what the eye follows. -->
            <Setter Property="Margin"
                    Value="0,0,6,0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource DialogForeground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <Path x:Name="Mark"
                                    Data="m754-308-56-55q41.78-11.3 67.89-43.65Q792-439 792-480q0-50-35-85t-85-35H528v-72h144q79.68 0 135.84 56.22 56.16 56.23 56.16 136Q864-425 834.5-379T754-308ZM618-444l-72-72h78v72h-6ZM768-90 90-768l51-51 678 678-51 51ZM432-288H288q-79.68 0-135.84-56.16T96-480q0-63.93 38-113.97Q172-644 242-673l70 73h-23q-51 0-86 35t-35 85q0 50 35 85t85 35h144v72Zm-96-156v-72h56l71 72H336Z"
                                    Stretch="Uniform"
                                    Width="{DynamicResource DialogFontSize}"
                                    Height="{DynamicResource DialogFontSize}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                    Value="True">
                                <Setter TargetName="Mark"
                                        Property="Data"
                                        Value="M432-288H288q-79.68 0-135.84-56.23Q96-400.45 96-480.23 96-560 152.16-616q56.16-56 135.84-56h144v72H288q-50 0-85 35t-35 85q0 50 35 85t85 35h144v72Zm-96-156v-72h288v72H336Zm192 156v-72h144q50 0 85-35t35-85q0-50-35-85t-85-35H528v-72h144q79.68 0 135.84 56.23 56.16 56.22 56.16 136Q864-400 807.84-344 751.68-288 672-288H528Z"/>
                                <Setter TargetName="Mark"
                                        Property="Fill"
                                        Value="{DynamicResource AccentForeground}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The colour code beside each swatch. Requested by mail 2026-07-31:
             Windows' own picker has three RGB number boxes and nowhere to paste
             "#2E7D32" from a browser or a design tool, which is how colours
             actually travel.
             Standing in the row rather than behind a gesture. A right-click
             popup was built first and thrown away for two reasons: the app's
             own stuck-capture watchdog releases any popup that holds capture
             without a menu being open, so it closed itself after a second
             (capture-watchdog.log, "released stuck capture: WPF(PopupRoot)"),
             and what was wanted was the field simply BEING there, beside the
             palette. Width was the reason it wasn't there to begin with, and
             that was given up.
             Every box is wired through this one style: it carries the handlers
             and each row only names the swatch it belongs to, so a colour added
             later needs one Tag and nothing else. -->
        <Style x:Key="ColorHexBoxStyle"
                TargetType="TextBox">
            <Setter Property="Width"
                    Value="{DynamicResource DialogHexInputWidth}"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource DialogHintFontSize}"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="TextAlignment"
                    Value="Center"/>
            <Setter Property="Margin"
                    Value="0,0,14,0"/>
            <Setter Property="Padding"
                    Value="1,1"/>
            <Setter Property="Background"
                    Value="{DynamicResource ControlBackground}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource DialogForeground}"/>
            <Setter Property="CaretBrush"
                    Value="{DynamicResource DialogForeground}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="ToolTip"
                    Value="{x:Static services:Strings.ColorHexInputHint}"/>
            <EventSetter Event="Loaded"
                    Handler="HexBox_Loaded"/>
            <EventSetter Event="KeyDown"
                    Handler="HexBox_KeyDown"/>
            <EventSetter Event="LostKeyboardFocus"
                    Handler="HexBox_LostKeyboardFocus"/>
        </Style>

        <!-- Plain Button defaults to the OS theme's white/light chrome, which
             clashed hard against this window's dark background - flat,
             outlined, and rounded to match the rest of the app instead. -->
        <Style x:Key="DialogButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource DialogForeground}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource DialogFontSize}"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Padding is bound so a button can size to its own
                             words instead of the fixed width - the export and
                             import pair share a row with 기본값 and would not
                             all fit at 70 each. -->
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,6"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackground}"/>
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ControlHoverBorder}"/>
                            </Trigger>
                            <!-- A LIT switch keeps its stamp under the pointer.
                                 The theme pair never needed this because the
                                 lit one stops taking the mouse - a switch
                                 cannot do that, since the press that turns it
                                 off has to land. Without this the hover brush
                                 paints over the accent and the ink picked for
                                 contrast AGAINST that accent is left standing
                                 on a colour it was not picked for, which in the
                                 light theme is white on near-white (2026-08-15).
                                 The border still brightens, so the hover is
                                 still said. Tag is how PaintToggleFill marks a
                                 lit button, there being no IsChecked on a
                                 Button; declared after the plain hover trigger
                                 because the later of two matching triggers is
                                 the one that wins. -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver"
                                            Value="True"/>
                                    <Condition Property="Tag"
                                            Value="lit"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </MultiTrigger>
                            <!-- A fully custom template has no built-in disabled
                                 look at all otherwise - ResetDefaultsButton relies
                                 on this to read as unclickable when colors are
                                 already at the current theme's defaults. -->
                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border x:Name="RootBorder"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Bar and title both grow with the font and both stop on the
                     way down - see HelpWindow, where the missing floor under
                     the title was caught. -->
                <RowDefinition Height="{DynamicResource DialogTitleBarHeight}"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                    x:Name="HeaderGrid"
                    Background="{DynamicResource DialogHeaderBackground}"
                    MouseLeftButtonDown="HeaderGrid_MouseLeftButtonDown">
                <!-- The app's own icon beside the title, the same arrangement
                     the help window uses: these windows carry no taskbar entry
                     and no system title bar, so without it a bare "색상 설정"
                     floating over the desktop does not say whose it is. -->
                <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="{DynamicResource DialogTitleIndent}">
                    <!-- The TITLE's size, not the tree's icon size: it stands
                         beside a line of type rather than in a row of other
                         icons, so what it has to match is the letters. -->
                    <Image Source="pack://application:,,,/Resources/icon.png"
                            Width="{DynamicResource DialogTitleTextSize}"
                            Height="{DynamicResource DialogTitleTextSize}"
                            Margin="0,0,7,0"
                            RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{x:Static services:Strings.ColorSettingsTitle}"
                            Foreground="{DynamicResource DialogForeground}"
                            FontSize="{DynamicResource DialogTitleTextSize}"
                            VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource DialogCloseButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        ToolTip="{x:Static services:Strings.ButtonClose}"
                        Click="CloseButton_Click">
                    <Path Data="M4,4 L12,12 M12,4 L4,12"
                            Stroke="{DynamicResource DialogForeground}"
                            StrokeThickness="1.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <!-- Two buttons for the theme, one filled to say which is on, and
                 one pair of dice.

                 Why not a single toggle, which is the smaller control: a lone
                 button that named the mode it would switch TO was ambiguous
                 (2026-08-09) - "am I in dark, or does this make it dark?".
                 Two buttons each naming their own mode answer that, and the
                 fill answers which one you are in.

                 What this replaced was two ZONES, each with its own pair of
                 dice, of which one pair was ALWAYS disabled - an artefact of
                 there being two zones rather than anything the user could act
                 on. One pair remains and rolls whatever theme is being looked
                 at, which was already the rule. Six buttons became four and
                 none of them is permanently dead. -->
            <Grid Grid.Row="1"
                    Margin="16,12,16,0">
                <!-- The two theme buttons, the gap, and the two dice.

                     EVERY BUTTON IS Auto AND THE GAP IS THE `*`. A star column
                     does not mean "share the room" when there is not enough of
                     it - it takes what is left and CLIPS whatever does not fit,
                     while an Auto neighbour takes its full width first. So when
                     the switches were `*` the row always cut the same thing: the
                     only buttons in it carrying words (2026-08-12, "Dark Mo…" at
                     the small font sizes). The gap is the one thing here that
                     can give its pixels back, so the gap is what gives. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Two ordinary buttons of this window's one button style,
                     and the ON one is stamped in the app's blue - painted in
                     RefreshThemeToggles, which is also where the reasoning is.
                     A joined segmented control was tried here first and did not
                     read as a control anyone recognised, so the two went back
                     to looking like the buttons they are.

                     They carry their own Padding because the style sets none
                     and these two are the only buttons in the window that
                     never did: they used to sit in `*` columns, which stretched
                     them wide enough that the missing padding never showed. -->
                <Button x:Name="DarkModeButton"
                        Content="{x:Static services:Strings.ColorThemeDarkMode}"
                        Style="{StaticResource DialogButtonStyle}"
                        Padding="10,0"
                        Click="DarkMode_Click"/>
                <Button x:Name="LightModeButton"
                        Grid.Column="1"
                        Content="{x:Static services:Strings.ColorThemeLightMode}"
                        Style="{StaticResource DialogButtonStyle}"
                        Padding="10,0"
                        Margin="6,0,0,0"
                        Click="LightMode_Click"/>
                <!-- The tree's and the panels' edge shading, on/off. It is not
                     a colour, and it is here anyway: named among the options
                     menu's behaviour toggles, "그림자" reads as a shadow around
                     the whole app, where beside the palette it reads as
                     shading inside these lists (the author's call, 2026-08-15).
                     Wears the same accent stamp as the theme pair when it is
                     on, but unlike that pair it stays clickable - it is a
                     switch, and the press that turns it off has to land. -->
                <Button x:Name="EdgeShadesButton"
                        Grid.Column="3"
                        Content="{x:Static services:Strings.ButtonEdgeShades}"
                        Style="{StaticResource DialogButtonStyle}"
                        Padding="10,0"
                        Margin="0,0,6,0"
                        ToolTip="{x:Static services:Strings.ButtonEdgeShadesTip}"
                        Click="EdgeShades_Click"/>
                <!-- The dice's grey cousin. It rolls exactly as the calm die
                     does and then takes the colour out, rather than drawing
                     greys of its own: every readability floor in a roll is
                     computed from LUMINANCE, and a swap to grey that keeps
                     each colour's luminance keeps every one of those floors
                     with it. Drawing greys directly would have to restate
                     them. -->
                <!-- Says the row is two groups: what you are LOOKING at on the
                     left, what you can DO to it on the right. It rides in the
                     `*` gap column so it costs no width of its own - the gap
                     is the one thing in this row that can give pixels back,
                     and the line sits in the middle of whatever is left. -->
                <Border Grid.Column="2"
                        Width="1"
                        Margin="0,3"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource PanelBorder}"/>
                <Button x:Name="MonoButton"
                        Grid.Column="4"
                        Content="{x:Static services:Strings.ButtonMonoColors}"
                        Style="{StaticResource DialogButtonStyle}"
                        Padding="10,0"
                        Margin="0,0,6,0"
                        ToolTip="{x:Static services:Strings.ButtonMonoColorsTip}"
                        Click="Mono_Click"/>
                <Button x:Name="RandomButton"
                        Grid.Column="5"
                        Content="{x:Static services:Strings.ButtonRandomColors}"
                        Style="{StaticResource DialogButtonStyle}"
                        Padding="10,0"
                        ToolTip="{x:Static services:Strings.ButtonRandomColorsTip}"
                        Click="Random_Click"/>
                <!-- The bolder roll, beside the ordinary one rather than
                     replacing it: the quiet die is worth keeping because its
                     small differences are exactly what shows up differently on
                     someone else's monitor, which is the point of rolling at
                     all. This one starts from a primary hue and lifts the
                     saturation ceilings - same readability floors. -->
                <Button x:Name="DaringButton"
                        Grid.Column="6"
                        Style="{StaticResource DialogButtonStyle}"
                        Padding="9,0"
                        Margin="4,0,0,0"
                        ToolTip="{x:Static services:Strings.ButtonDaringColorsTip}"
                        Click="Daring_Click">
                    <!-- Material Symbols "palette" (2026-08-11). The one mark
                         in this window, and it earns that: the button beside it
                         is a word for the ordinary die, and this one is the
                         odd, deliberate thing - which is what a picture says
                         faster than "원색" did. -->
                    <Path Data="M480-96q-79 0-149-30t-122.5-82.5Q156-261 126-331T96-480q0-80 30.5-149.5t84-122Q264-804 335.5-834T488-864q78 0 146.5 27T754-763q51 47 80.5 110T864-518q0 96-67 163t-163 67h-68q-8 0-14 5t-6 13q0 15 15 25t15 53q0 37-27 66.5T480-96Zm0-384Zm-173.5 18.5Q324-479 324-504t-17.5-42.5Q289-564 264-564t-42.5 17.5Q204-529 204-504t17.5 42.5Q239-444 264-444t42.5-17.5Zm120-144Q444-623 444-648t-17.5-42.5Q409-708 384-708t-42.5 17.5Q324-673 324-648t17.5 42.5Q359-588 384-588t42.5-17.5Zm192 0Q636-623 636-648t-17.5-42.5Q601-708 576-708t-42.5 17.5Q516-673 516-648t17.5 42.5Q551-588 576-588t42.5-17.5Zm120 144Q756-479 756-504t-17.5-42.5Q721-564 696-564t-42.5 17.5Q636-529 636-504t17.5 42.5Q671-444 696-444t42.5-17.5ZM480-168q11 0 17.5-8.5T504-192q0-16-15-28t-15-50q0-38 26.5-64t64.5-26h69q66 0 112-46t46-112q0-115-88.5-194.5T488-792q-134 0-227 91t-93 221q0 130 91 221t221 91Z"
                            Stretch="Uniform"
                            Width="{DynamicResource DialogFontSize}"
                            Height="{DynamicResource DialogFontSize}"
                            Fill="{Binding Foreground,
                                RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </Grid>

            <Grid Grid.Row="2"
                    Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Two more than the colour rows, because two of them are
                     dividers rather than colours (10 and 18) - see their own
                     comments for where each boundary falls and why. -->
                <RowDefinition Height="Auto"/>
                <!-- 7~9 패널 이름 셋(2026-08-17), 20 펼침기호, 22~25 필터 칩 넷
                     (2026-08-15; 번호는 2026-08-16의 두 번째 구분선과
                     2026-08-17의 패널 이름 셋으로 밀렸음). The chips sit
                         below 영역 구분선 rather than beside the tree's own marks,
                         which is where they are on screen; 숨김 시 손잡이/막대 stays
                         last for the reason its own comment gives. -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!-- 패널 이름 셋. -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!-- 선택된 폴더 영역 (2026-08-26). THERE MUST BE ONE MORE ROW
                         HERE THAN THE HIGHEST Grid.Row BELOW. WPF does not
                         complain about a row that was never defined - it puts
                         the content in the LAST one instead, and what showed
                         was the button bar drawn on top of 자동 숨김 손잡이.
                         check-text counts these against the rows now. -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                        Grid.Column="0"
                        x:Name="LabelFolderName"
                        Text="{x:Static services:Strings.ColorLabelFolderNameFont}"
                        Style="{StaticResource ColorRowLabelStyle}"/>
                <StackPanel Grid.Row="0"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                    <ToggleButton x:Name="FolderNameFontSwatchChain"
                            Tag="FolderNameFontSwatch"
                            Style="{StaticResource ChainToggleStyle}"
                            ToolTip="{x:Static services:Strings.ColorChainTip}"
                            Click="ChainToggle_Click"/>
                    <TextBox Tag="FolderNameFontSwatch"
                            Style="{StaticResource ColorHexBoxStyle}"/>
                    <Border x:Name="FolderNameFontSwatch"
                            Style="{StaticResource ColorSwatchStyle}"
                            MouseLeftButtonUp="FolderNameFontSwatch_MouseLeftButtonUp"/>
                </StackPanel>

                <TextBlock Grid.Row="1"
                        Grid.Column="0"
                        x:Name="LabelFolderNameHighlight"
                        Text="{x:Static services:Strings.ColorLabelFolderNameHighlightFont}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="{DynamicResource DialogRowSpacing}"/>
                <StackPanel Grid.Row="1"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="{DynamicResource DialogRowSpacing}">
                    <ToggleButton x:Name="FolderNameHighlightFontSwatchChain"
                            Tag="FolderNameHighlightFontSwatch"
                            Style="{StaticResource ChainToggleStyle}"
                            ToolTip="{x:Static services:Strings.ColorChainTip}"
                            Click="ChainToggle_Click"/>
                    <TextBox Tag="FolderNameHighlightFontSwatch"
                            Style="{StaticResource ColorHexBoxStyle}"/>
                    <Border x:Name="FolderNameHighlightFontSwatch"
                            Style="{StaticResource ColorSwatchStyle}"
                            MouseLeftButtonUp="FolderNameHighlightFontSwatch_MouseLeftButtonUp"/>
                </StackPanel>

                <TextBlock Grid.Row="2"
                        Grid.Column="0"
                        x:Name="LabelFolderNameHover"
                        Text="{x:Static services:Strings.ColorLabelFolderNameHoverFont}"
                        Style="{StaticResource ColorRowLabelStyle}"
                        Margin="{DynamicResource DialogRowSpacing}"/>
                <StackPanel Grid.Row="2"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="{DynamicResource DialogRowSpacing}">
                    <ToggleButton x:Name="FolderNameHoverFontSwatchChain"
                            Tag="FolderNameHoverFontSwatch"
                            Style="{StaticResource ChainToggleStyle}"
                            ToolTip="{x:Static services:Strings.ColorChainTip}"
                            Click="ChainToggle_Click"/>
                    <TextBox Tag="FolderNameHoverFontSwatch"
                            Style="{StaticResource ColorHexBoxStyle}"/>
                    <Border x:Name="FolderNameHoverFontSwatch"
                            Style="{StaticResource ColorSwatchStyle}"
                            MouseLeftButtonUp="FolderNameHoverFontSwatch_MouseLeftButtonUp"/>
                </StackPanel>

