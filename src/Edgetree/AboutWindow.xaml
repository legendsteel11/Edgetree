<Window x:Class="SidebarExplorer.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SidebarExplorer.App.Services"
        Title="{x:Static services:Strings.AboutTitle}"
        SizeToContent="Height"
        Width="{DynamicResource DialogWidth}"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        FontSize="{DynamicResource DialogFontSize}"
        Background="{DynamicResource DialogBackground}">
    <Window.Resources>
        <Style x:Key="DialogCloseButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Width"
                    Value="28"/>
            <Setter Property="Height"
                    Value="28"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AboutRowLabelStyle"
                TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryForeground}"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource DialogFontSize}"/>
            <Setter Property="Margin"
                    Value="0,0,0,2"/>
        </Style>

        <Style x:Key="AboutRowValueStyle"
                TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource DialogForeground}"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource DialogFontSize}"/>
            <Setter Property="TextWrapping"
                    Value="Wrap"/>
        </Style>

        <Style x:Key="DialogButtonStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource DialogForeground}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="{DynamicResource DialogFontSize}"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,6"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource HoverBackground}"/>
                                <Setter TargetName="Bd"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ControlHoverBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            BorderBrush="{DynamicResource PanelBorder}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Bar and title both grow with the font and both stop on the
                     way down - see HelpWindow, where the missing floor under
                     the title was caught. -->
                <RowDefinition Height="{DynamicResource DialogTitleBarHeight}"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                    Background="{DynamicResource DialogHeaderBackground}"
                    MouseLeftButtonDown="HeaderGrid_MouseLeftButtonDown">
                <TextBlock Text="Edgetree"
                        Foreground="{DynamicResource DialogForeground}"
                        FontSize="{DynamicResource DialogTitleTextSize}"
                        VerticalAlignment="Center"
                        Margin="{DynamicResource DialogTitleIndent}"/>
                <Button Style="{StaticResource DialogCloseButtonStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        ToolTip="{x:Static services:Strings.ButtonClose}"
                        Click="CloseButton_Click">
                    <Path Data="M4,4 L12,12 M12,4 L4,12"
                            Stroke="{DynamicResource DialogForeground}"
                            StrokeThickness="1.5"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"/>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1"
                    Margin="16">
                <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,14">
                    <Image Source="pack://application:,,,/Resources/icon.png"
                            Width="{DynamicResource DialogTitleIconSize}"
                            Height="{DynamicResource DialogTitleIconSize}"
                            Margin="0,0,8,0"
                            RenderOptions.BitmapScalingMode="HighQuality"/>
                    <!-- The app's own name, one step above the body text -
                            kept a step above it at every zoom rather than
                            pinned to 14. -->
                    <TextBlock Text="Edgetree"
                            Foreground="{DynamicResource DialogForeground}"
                            FontSize="{DynamicResource DialogTitleFontSize}"
                            FontWeight="Bold"
                            VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="{x:Static services:Strings.AboutVersionLabel}"
                        Style="{StaticResource AboutRowLabelStyle}"/>
                <TextBlock x:Name="VersionText"
                        Style="{StaticResource AboutRowValueStyle}"
                        Margin="0,0,0,10"/>

                <!-- Only appears when the startup update check found a newer
                     release (see the constructor) - the options-button dot
                     says "there's an update", this is where it can actually
                     be fetched. Sits right under the version it supersedes. -->
                <TextBlock x:Name="UpdateLinkText"
                        Foreground="{DynamicResource AccentForeground}"
                        FontSize="{DynamicResource DialogFontSize}"
                        Cursor="Hand"
                        TextDecorations="Underline"
                        Margin="0,-4,0,10"
                        Visibility="Collapsed"
                        MouseLeftButtonDown="UpdateLink_MouseLeftButtonDown"/>

                <TextBlock Text="{x:Static services:Strings.AboutAuthorLabel}"
                        Style="{StaticResource AboutRowLabelStyle}"/>
                <TextBlock Text="{x:Static services:Strings.AboutAuthorValue}"
                        Style="{StaticResource AboutRowValueStyle}"
                        Margin="0,0,0,10"/>

                <TextBlock Text="{x:Static services:Strings.AboutDateLabel}"
                        Style="{StaticResource AboutRowLabelStyle}"/>
                <TextBlock x:Name="DateText"
                        Style="{StaticResource AboutRowValueStyle}"
                        Margin="0,0,0,10"/>

                <TextBlock Text="{x:Static services:Strings.AboutGithubLabel}"
                        Style="{StaticResource AboutRowLabelStyle}"/>
                <TextBlock Text="github.com/legendsteel11/Edgetree"
                        Foreground="{DynamicResource AccentForeground}"
                        FontSize="{DynamicResource DialogFontSize}"
                        Cursor="Hand"
                        TextDecorations="Underline"
                        Margin="0,0,0,10"
                        MouseLeftButtonDown="GithubLink_MouseLeftButtonDown"/>

                <TextBlock Text="{x:Static services:Strings.AboutWebsiteLabel}"
                        Style="{StaticResource AboutRowLabelStyle}"/>
                <TextBlock Text="edgetree.vercel.app"
                        Foreground="{DynamicResource AccentForeground}"
                        FontSize="{DynamicResource DialogFontSize}"
                        Cursor="Hand"
                        TextDecorations="Underline"
                        Margin="0,0,0,10"
                        MouseLeftButtonDown="WebsiteLink_MouseLeftButtonDown"/>

                <!-- The other half of a mutual link: TabStick's own site has
                     pointed here since 2026-07-25. Last of the link rows on
                     purpose - these are the lines in this window that are not
                     about Edgetree.

                     STACKED, a name per line, where the landing footer sets the
                     same four side by side. The window is a fixed DialogWidth
                     with ResizeMode="NoResize", so a row of four names has
                     nowhere to go once DialogFontSize is scaled up and would be
                     clipped rather than wrapped. Height is the free direction
                     here - SizeToContent="Height" is already on the window.

                     The URL rides on each Tag instead of being switched on in
                     the handler, so a fourth tool is one block of XAML and no
                     code at all. -->
                <TextBlock Text="{x:Static services:Strings.AboutOtherToolLabel}"
                        Style="{StaticResource AboutRowLabelStyle}"/>
                <TextBlock Text="TabStick"
                        Tag="https://tabstick.com/"
                        Foreground="{DynamicResource AccentForeground}"
                        FontSize="{DynamicResource DialogFontSize}"
                        Cursor="Hand"
                        TextDecorations="Underline"
                        Margin="0,0,0,2"
                        MouseLeftButtonDown="OtherToolLink_MouseLeftButtonDown"/>
                <TextBlock Text="SweepCap"
                        Tag="https://sweepcap.vercel.app/"
                        Foreground="{DynamicResource AccentForeground}"
                        FontSize="{DynamicResource DialogFontSize}"
                        Cursor="Hand"
                        TextDecorations="Underline"
                        Margin="0,0,0,2"
                        MouseLeftButtonDown="OtherToolLink_MouseLeftButtonDown"/>
                <TextBlock Text="DeskNoise"
                        Tag="https://desk-noise.vercel.app/"
                        Foreground="{DynamicResource AccentForeground}"
                        FontSize="{DynamicResource DialogFontSize}"
                        Cursor="Hand"
                        TextDecorations="Underline"
                        Margin="0,0,0,2"
                        MouseLeftButtonDown="OtherToolLink_MouseLeftButtonDown"/>
                <!-- The fourth (2026-09-16), and the block the note above
                     promised: one TextBlock, no code. The LAST row carries the
                     10px gap before the licence rows, so the gap moved here from
                     DeskNoise. -->
                <TextBlock Text="MagicLoupe"
                        Tag="https://magicloupe.vercel.app/"
                        Foreground="{DynamicResource AccentForeground}"
                        FontSize="{DynamicResource DialogFontSize}"
                        Cursor="Hand"
                        TextDecorations="Underline"
                        Margin="0,0,0,10"
                        MouseLeftButtonDown="OtherToolLink_MouseLeftButtonDown"/>

                <!-- Licence rows sit under the links (author's call, 2026-07-30):
                     what someone opens this window for is the version and where
                     to go, and the attribution is what they read once. -->
                <TextBlock Text="{x:Static services:Strings.AboutLicenseLabel}"
                        Style="{StaticResource AboutRowLabelStyle}"/>
                <TextBlock Text="{x:Static services:Strings.AboutLicenseSummary}"
                        Style="{StaticResource AboutRowValueStyle}"
                        Margin="0,0,0,10"/>

                <!-- The icons come from two projects under two licences, and the
                     Apache one (Material Symbols) asks for a copy of its licence
                     to travel with the distribution - so this row opens the copy
                     that shipped inside the exe rather than linking out. -->
                <TextBlock Text="{x:Static services:Strings.AboutIconLicenseLabel}"
                        Style="{StaticResource AboutRowLabelStyle}"/>
                <TextBlock Text="{x:Static services:Strings.AboutIconLicenseValue}"
                        Style="{StaticResource AboutRowValueStyle}"
                        Margin="0,0,0,2"/>
                <TextBlock Text="{x:Static services:Strings.AboutIconLicenseOpen}"
                        Foreground="{DynamicResource AccentForeground}"
                        FontSize="{DynamicResource DialogFontSize}"
                        Cursor="Hand"
                        TextDecorations="Underline"
                        MouseLeftButtonDown="IconLicenseLink_MouseLeftButtonDown"/>

                <Button Content="{x:Static services:Strings.ButtonClose}"
                        Style="{StaticResource DialogButtonStyle}"
                        Width="{DynamicResource DialogButtonWidth}"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0"
                        IsCancel="True"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
