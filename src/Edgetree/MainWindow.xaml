                                     settings to get right once - they are
                                     something to nudge while looking. -->
                                <MenuItem x:Name="ViewerHdrBrightnessItem"
                                        StaysOpenOnClick="True"
                                        Focusable="False"
                                        Padding="{DynamicResource MenuStepperRowPadding}"
