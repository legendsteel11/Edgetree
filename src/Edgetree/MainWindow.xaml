            <MenuItem Header="{x:Static services:Strings.MenuAbout}"
                    Click="AboutMenuItem_Click"/>
        </ContextMenu>

        <!-- A minimal chevron that rotates 90° on expand, closer to VS Code's
             arrow than the default Windows TreeViewItem expander glyph. A plain
             Setter can't target a nested Freezable (RotateTransform) by name, but
             a Storyboard's TargetProperty path can drill into one directly, so
             the smooth rotation is done via EnterActions/ExitActions instead. -->
        <Style x:Key="ExpanderToggleButtonStyle"
                TargetType="ToggleButton">
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Width"
                    Value="16"/>
            <Setter Property="Height"
                    Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent"
                                Width="16"
                                Height="16">
                            <!-- Material Symbols "keyboard_arrow_right"
                                 (2026-08-16), replacing a hand-drawn stroked
                                 chevron. The complaint was the ANGLE and the
                                 numbers agree: the drawn one ran 4.5 across
                                 against 3.5 up and down, which is about 76
                                 degrees, where this family - and VS Code's own
                                 - runs 189 against 189, exactly 90. An acute
                                 chevron reads as a different mark, not as the
                                 same mark drawn differently.

                                 ONE GLYPH, still rotated. The family draws
                                 keyboard_arrow_down as its own shape, but this
                                 one turned 90 degrees IS that shape - the two
                                 are the same geometry - so the animation below
                                 keeps working and there is only one path to
                                 keep in step.

                                 The trailing M0-960H960M0 0H960 is this app's
                                 standing rule for Material geometry: it pins
                                 the full 960 box so Stretch measures the BOX
                                 rather than the ink, which is what keeps a
                                 glyph the size its neighbours are. Fill, not
                                 Stroke - the family's marks are shapes, and
                                 the round caps the drawn one needed were there
                                 to soften a line. -->
                            <Path x:Name="Arrow"
                                    Data="M522-480 333-669l51-51 240 240-240 240-51-51 189-189Z M0-960H960M0 0H960"
                                    Fill="{DynamicResource ExpanderArrowBrush}"
                                    Stretch="Uniform"
                                    Width="{DynamicResource ExpanderGlyphSize}"
                                    Height="{DynamicResource ExpanderGlyphSize}"
                                  HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0"/>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked"
                                    Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Arrow"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             To="90"
                                                    Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Arrow"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             To="0"
                                                    Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Arrow"
                                        Property="Stroke"
                                        Value="{DynamicResource ForegroundText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The strip gets the app's own scrollbar, not Windows'. A ListBox
             with no Style of its own keeps the stock template, and the stock
             template brings the stock ScrollViewer with it - so turning the
             horizontal bar on gave the strip a grey Windows bar with arrow
             buttons at both ends, next to the thin overlay bars the tree and
             the results list use (2026-08-12). Everywhere else in this app
             reaches MinimalScrollViewerTemplate through a control template;
             this is the same route for the one control that had none.
             The bar is an OVERLAY there, drawn on top of the content rather
             than in a lane of its own, so the strip keeps every pixel of its
             height. -->
        <!-- THE TWO LAYOUTS THE SAME CELLS CAN TAKE. One row that scrolls
             sideways, or several that scroll down; the cells, their template,
             the selection and every gesture on them are shared, so the mode is
             one assignment (ApplyFilmstripLayout) rather than a second control.

             The wrap panel takes the cell's FOOTPRINT rather than its size -
             cell plus the gap that follows it - because the gap is what the
             bar's cells carry as their own margin, and a grid needs one below
             each row as well. Both numbers are set beside the cell size itself
             (ApplyFilmstripCellSize), so one place owns the arithmetic. -->
        <ItemsPanelTemplate x:Key="FilmstripBarPanel">
            <VirtualizingStackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="FilmstripGridPanel">
            <local:VirtualizingWrapPanel
                    ItemWidth="{DynamicResource FilmstripCellFootprintWidth}"
                    ItemHeight="{DynamicResource FilmstripCellFootprintHeight}"/>
        </ItemsPanelTemplate>

        <Style x:Key="FilmstripListBoxStyle"
                TargetType="ListBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False"
                                Padding="{TemplateBinding Padding}"
                                Template="{StaticResource FilmstripScrollViewerTemplate}"
                                CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ExplorerTreeViewItemStyle"
                TargetType="TreeViewItem">
            <!-- CacheLength/CacheLengthUnit setters used to sit here, to keep
                 the root TreeView's huge cache from inheriting down to a
                 folder. They were removed 2026-08-12 because they never did
                 that: a local value does beat an inherited one, but a nested
                 virtualizing panel takes its cache length from the
                 HierarchicalVirtualizationConstraints its PARENT panel hands
                 it, not from the property. Measured - the local property read
                 "1,1 Page" while the folder held 1,057 realized rows to the
                 handed "1000,1000 Item". Putting them back would only restore
                 the appearance of a limit; see ExplorerTree's comment. -->
            <Setter Property="IsExpanded"
                    Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <!-- Vertical padding scales with the TreeView's FontSize AND the
                 user's own "행 간격" adjustment - both folded together in
                 ApplyLayoutMetrics (see RowPadding there) rather than a
                 converter, since a converter bound to just one property
                 (FontSize) had no clean way to take this second input too. -->
            <Setter Property="Padding"
                    Value="{DynamicResource RowPadding}"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource FolderNameForeground}"/>
            <!-- Inherited down to NameText, exactly like Foreground above. File
                 rows override both in their own trigger, which is what makes
                 "폴더만 굵게" a single resource rather than a special case. -->
            <Setter Property="FontWeight"
                    Value="{DynamicResource FolderNameFontWeight}"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="ContextMenu"
                    Value="{StaticResource ExplorerItemContextMenu}"/>
            <Setter Property="AllowDrop"
                    Value="True"/>
            <EventSetter Event="Expanded"
                    Handler="TreeViewItem_Expanded"/>
            <EventSetter Event="PreviewMouseRightButtonDown"
                    Handler="TreeViewItem_PreviewMouseRightButtonDown"/>
            <EventSetter Event="PreviewMouseLeftButtonDown"
                    Handler="TreeViewItem_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="PreviewMouseMove"
                    Handler="TreeViewItem_PreviewMouseMove"/>
            <EventSetter Event="PreviewMouseLeftButtonUp"
                    Handler="TreeViewItem_PreviewMouseLeftButtonUp"/>
            <EventSetter Event="DragEnter"
                    Handler="TreeViewItem_DragOver"/>
            <EventSetter Event="DragOver"
                    Handler="TreeViewItem_DragOver"/>
            <EventSetter Event="Drop"
                    Handler="TreeViewItem_Drop"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid>
                            <!-- The band under the folder that holds the
                                 selection (see the IsAncestorOfSelection
                                 trigger). It sits BEHIND the StackPanel and
                                 sizes to it, which is exactly this folder plus
                                 its open subtree - RowBorder above, ItemsHost
                                 below - so it shows how far the folder reaches.
                                 Transparent for every other row, which is why a
                                 nested one never tints its ancestor.
                                 IsHitTestVisible IS NOT OPTIONAL, and it is why
                                 this is a Border in a Grid rather than a
                                 background on the StackPanel itself. A panel
                                 that paints becomes a target, and the one strip
                                 in a row that nothing else covers is the empty
                                 space either side of the guide line - which was
                                 deliberately taken OUT of the hit test (see
                                 GuideLine below). Painting the panel handed that
                                 strip back, on the one folder most likely to be
                                 clicked near. -->
                            <Border x:Name="SelectionZone"
                                    IsHitTestVisible="False"/>
                            <StackPanel>
                                <Border x:Name="RowBorder"
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="ExpanderColumn"
                                                    Width="{DynamicResource TabSpacingWidth}"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- LayoutTransform, not Width/Height: the
                                             arrow inside is a stroked Path drawn
                                             against a 16-unit box, so a smaller box
                                             would clip it instead of shrinking it.
                                             See ApplyLayoutMetrics' ExpanderArrowScale
                                             for why this needed to move at all -
                                             it was the one thing in a row that had
                                             never followed the font. -->
                                        <!-- The negative margin is what lets the box
                                             be WIDER than the indent column it sits
                                             in (2026-08-17). Without it WPF hands an
                                             oversized child the cell as a clip AND
                                             ignores the Center below - the fallback
                                             for a child that does not fit is
                                             Left/Top - so the box landed at the
                                             column's left edge and everything past
                                             its width was cut off. The down chevron
                                             is the one that showed it: rotating
                                             swaps ink width for height, so its ink
                                             runs ±0.325 of the box against the right
                                             chevron's ±0.197, and 2.4px of its right
                                             arm was being sliced (reported
                                             2026-08-16; the default indent was
                                             losing 1.2px too).
                                             Giving the overflow back as margin
                                             removes the clip and makes Center true
                                             again, so the mark is centred on the
                                             column - which is where the guide line
                                             under it is drawn, and what the
                                             arrow-to-name gap arithmetic in
                                             ApplyLayoutMetrics already assumed. -->
                                        <ToggleButton x:Name="Expander"
                                                Grid.Column="0"
                                                      Style="{StaticResource ExpanderToggleButtonStyle}"
                                                      ClickMode="Press"
                                                      HorizontalAlignment="Center"
                                                      Margin="{DynamicResource ExpanderBoxOverhang}"
                                                      LayoutTransform="{DynamicResource ExpanderArrowScale}"
                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                        <!-- The arrow sits CENTERED in a column as wide as
                                             the indent, so what is left between its ink and
                                             this content is half the indent minus a constant -
                                             the gap shrank whenever the indent did, which is
                                             not what the indent option is for. This margin is
                                             what holds it apart instead. -->
                                        <ContentPresenter x:Name="PART_Header"
                                                Grid.Column="1"
                                                ContentSource="Header"
                                                Margin="{DynamicResource ExpanderNameGap}"
                                                          HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <!-- Each nesting level compounds this margin, producing the
                                     cascading indent that the default template gets "for free" -
                                     our custom template has to add it back explicitly. The left
                                     border draws a guide line under the parent arrow's center that
                                     spans exactly this subtree's rendered height (Border sizes to
                                     its child), so it reads as one continuous line VS Code-style
                                     without any per-row depth tracking. Margin/Padding are "탭간격"
                                     (TabSpacingWidth) split around the fixed 1px BorderThickness -
                                     see ApplyLayoutMetrics - so the line stays centered under the
                                     arrow above regardless of the current spacing. -->
                                <Grid x:Name="ItemsHost"
                                        Visibility="Collapsed">
                                    <!-- BorderThickness with no brush: the 1px is still reserved,
                                         so every metric ApplyLayoutMetrics splits around it stays
                                         exactly as it was. The line is only PAINTED elsewhere. -->
                                    <Border Margin="{DynamicResource TabSpacingGuideMargin}"
                                            BorderThickness="1,0,0,0"
                                            Padding="{DynamicResource TabSpacingGuidePadding}">
                                        <ItemsPresenter/>
                                    </Border>
                                    <!-- The line drawn over that reserved pixel rather than by it,
                                         because a Border hit-tests wherever it PAINTS: the line was
                                         clickable (the empty strip either side of it never was), and
                                         clicking it selected the ancestor that owns it. Halfway down
                                         a long subtree there is no way to tell which folder a 1px
                                         line belongs to, so it stopped being a target - it shows
                                         depth, and how far a folder reaches, and nothing else. -->
                                    <Border x:Name="GuideLine"
                                            Margin="{DynamicResource TabSpacingGuideLineMargin}"
                                            HorizontalAlignment="Left"
                                            Width="1"
                                            IsHitTestVisible="False"
                                            Background="{DynamicResource TreeGuideLineBrush}"/>
                                    </Grid>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded"
                                    Value="True">
                                <Setter TargetName="ItemsHost"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>
                            <!-- ExpanderColumn's width setter only actually matters combined
                                 with HasItems=False (a file never has this arrow to begin
                                 with) - see FileArrowGutterWidth's own comment in the
                                 Resources block above for when/why it collapses to 0. -->
                            <Trigger Property="HasItems"
                                    Value="False">
                                <Setter TargetName="Expander"
                                        Property="Visibility"
                                        Value="Hidden"/>
                                <Setter TargetName="ExpanderColumn"
                                        Property="Width"
                                        Value="{DynamicResource FileArrowGutterWidth}"/>
                                <!-- And the gap in front of the content goes with the
                                     gutter in that same case: a collapsed gutter with
                                     a margin still standing in it has not collapsed. -->
                                <Setter TargetName="PART_Header"
                                        Property="Margin"
                                        Value="{DynamicResource FileNameGap}"/>
                            </Trigger>
                            <!-- Brightens this folder's guide line whenever it's an
                                 ancestor of the currently selected item (maintained by
                                 MainWindow on TreeView.SelectedItemChanged), so the path
                                 down to the active selection is easy to trace. -->
                            <DataTrigger Binding="{Binding IsAncestorOfSelection}"
                                    Value="True">
                                <Setter TargetName="GuideLine"
                                        Property="Background"
                                        Value="{DynamicResource TreeGuideLineActiveBrush}"/>
                                <!-- 선택을 담고 있는 폴더가 차지하는 구간, painted on
                                     the template root so it covers this row and
                                     everything the folder currently has open.
                                     ON THIS FLAG AND NOT IsSelected, which was the
                                     first attempt and let go of the band the moment
                                     a file inside was clicked (2026-08-26): the band
                                     answers "which folder am I in", and clicking a
                                     file inside a folder does not leave it. This flag
                                     already resolves that - the selected item itself
                                     when it is a folder, its parent when it is a file
                                     - and never marks more than one, so the bands
                                     cannot nest. It is the same answer the guide line
                                     above is drawn from, which is why the two share
                                     one trigger. -->
                                <Setter TargetName="SelectionZone"
                                        Property="Background"
                                        Value="{DynamicResource TreeSelectionZoneBackground}"/>
                            </DataTrigger>
                            <!-- SourceName="RowBorder" (not plain Property="IsMouseOver", which
                                 would read the whole TreeViewItem) matters here: a TreeViewItem's
                                 IsMouseOver is true whenever the pointer is anywhere over its
                                 rendered bounds, and those bounds include every expanded
                                 descendant's rows too (they're part of the same control). Without
                                 this, hovering one deeply nested row lit up its entire hover
                                 background on every ancestor simultaneously, and moving the mouse
                                 around the tree made that whole chain flicker on and off.
                                 RowBorder only spans this row's own header (icon+text) - it's a
                                 sibling of ItemsHost, not a container of it - so checking
                                 IsMouseOver there instead correctly scopes to just this row. -->
                            <Trigger SourceName="RowBorder"
                                    Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="RowBorder"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowHoverBackground}"/>
                                <!-- No TargetName: sets TreeViewItem.Foreground itself (see the
                                     IsSelected trigger below for the same reasoning), which the
                                     selected-row trigger's Foreground setter still overrides when
                                     both apply, since it's declared after this one. Folder rows
                                     pick this up by inheritance (NameText sets no local Foreground
                                     of its own); file rows have their own explicit hover/selected
                                     triggers instead (see the HierarchicalDataTemplate below) that
                                     override this by design. -->
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FolderNameHoverForeground}"/>
                            </Trigger>
                            <!-- Ctrl/Shift-click multi-selection rows: painted with the exact
                                 same brushes as the native selection below, so the one row WPF
                                 itself selected and the extra flagged rows are indistinguishable.
                                 Declared BEFORE the IsSelected triggers so native selection's
                                 setters win when both apply to the same row. -->
                            <DataTrigger Binding="{Binding IsMultiSelected}"
                                    Value="True">
                                <Setter TargetName="RowBorder"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowSelectedActiveBackground}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FolderNameHighlightForeground}"/>
                            </DataTrigger>
                            <!-- "A drop lands here": the same brushes again, for
                                 the same reason the multi-selection uses them -
                                 one mark, learned once. It is a state of its own
                                 rather than the native selection (which is what
                                 used to be moved here) so that picking a row up
                                 and dragging it out no longer takes the mark off
                                 that row and hands it back on release. Only ever
                                 true on a FOLDER row - ResolveDropTargetFolder
                                 resolves a hovered file to its parent - so file
                                 rows need no matching trigger of their own. -->
                            <DataTrigger Binding="{Binding IsDropTarget}"
                                    Value="True">
                                <Setter TargetName="RowBorder"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowSelectedActiveBackground}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FolderNameHighlightForeground}"/>
                            </DataTrigger>
                            <!-- Selected background no longer varies with
                                 Selector.IsSelectionActive: that state flips to False any time
                                 keyboard focus leaves the tree's focus scope - including while
                                 the row's own ContextMenu is open - which read as the selection
                                 highlight flickering on/off on every right-click. Selection now
                                 always renders the same way regardless of focus. -->
                            <Trigger Property="IsSelected"
                                    Value="True">
                                <Setter TargetName="RowBorder"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowSelectedActiveBackground}"/>
                            </Trigger>
                            <!-- No TargetName: this sets TreeViewItem.Foreground itself, which
                                 the header's TextBlock then picks up by inheritance (it no
                                 longer sets its own local Foreground). -->
                            <Trigger Property="IsSelected"
                                    Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FolderNameHighlightForeground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- The blank rows that make room past the last drive: they are
                     scroll range and nothing else. No hover, no click, no
                     keyboard stop, no tooltip - the same set of denials the
                     search view's header rows carry, for the same reason. -->
                <DataTrigger Binding="{Binding IsBottomGap}"
                        Value="True">
                    <Setter Property="Focusable"
                            Value="False"/>
                    <Setter Property="IsHitTestVisible"
                            Value="False"/>
                    <Setter Property="ToolTipService.IsEnabled"
                            Value="False"/>
                </DataTrigger>
                <!-- "… 비어 있음" and "… 필터로 감춰진 파일 N개" are notes,
                     not buttons. They share their slot and their template with
                     더 보기, which IS one, so without this they inherit the hand
                     cursor and the hover highlight and offer themselves as
                     something to press (reported 2026-08-26 with a shot of the
                     pointer sitting on one).
                     The same set of denials the bottom-gap rows above carry,
                     and for the same reason: hover is this tree's way of saying
                     a row answers the pointer, and these do not. The tooltip
                     goes with hit testing, which is the one thing given up -
                     the note sits directly under the folder it speaks for, so
                     its place already says which folder that is.
                     The click is still refused in code as well; that guard
                     covers the paths a hit test does not. -->
                <DataTrigger Binding="{Binding IsFilterNotice}"
                        Value="True">
                    <Setter Property="Cursor"
                            Value="Arrow"/>
                    <Setter Property="Focusable"
                            Value="False"/>
                    <Setter Property="IsHitTestVisible"
                            Value="False"/>
                    <Setter Property="ToolTipService.IsEnabled"
                            Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- THE GRAB LINE'S THREE STATES, declared here rather than taken from
             the palette: a line that says "this edge can be dragged" is a
             pointer state, like the scroll thumb's own ladder and the footer
             chips' hover ink, and a pointer state has to read the same however
             the palette has been set.
             REST arrived 2026-08-26, on report. The line these thumbs ride was
             drawn by the CONTAINER in PanelDividerBrush, and 영역 구분선 off
             takes that brush to zero alpha - so switching off a decoration also
             took away the only resting mark on an edge that can be DRAGGED.
             ONE EDGE TAKES THIS, the thumbnail strip's. The first cut gave it to
             all three (the split and favorites too) and that was too much: with
             the dividers off, three lines came back and the option stopped
             meaning what it says. The strip's boundary is the one that earns the
             exemption, because the rows above it stack up - carousel, name,
             metadata, zoom, transport - so one more horizontal line among a
             dozen cannot be picked out. Nothing stacks against the other two,
             and the split has a collapse chevron marking it besides.
             So the strip's host hands its edge over - BorderThickness stays,
             the pixel is laid out against, only the brush goes transparent -
             and the other two containers keep painting their own.
             Rest was picked against the seek bar's unplayed track, named in the
             report as the strength to match. At 1px it needs more alpha than
             that 3px track to weigh the same, and #60 lands within a level or
             two of what the default palette already drew on both themes - so a
             default install keeps the line it always had.
             ALPHA rather than darker greys, for the reason the style below
             gives: fixed across both themes, blending toward whatever is behind.
             REST IS THE RUNG TO NUDGE if the line reads wrong; hover was left
             where it was so this round changes one thing. -->
        <!-- THE SOUND MARK - four bars breathing out of step, saying that a
             track is running. It stands in TWO places now (the footer's held-
             track row and the viewer's 지금 재생 중 line), which is why it is a
             template and not two copies: the four periods below are the whole
             design, and a second set of them would have to be tuned twice.
             ONE INSTANCE PER PLACE, each with its own clock, because the
             storyboard lives inside the template and a ControlTemplate carries
             its own namescope - the target names resolve per instance.

             IT IS NOT A METER. MediaElement hands out no samples, so nothing
             here can follow the music, and the shape must not claim to. What it
             says truthfully is the one thing it is wired to: it MOVES WHILE THE
             TRACK PLAYS AND STANDS STILL WHEN IT IS PAUSED.

             Tag is the switch, as a string rather than a bool - a DataTrigger
             comparing to a typed value goes through a conversion that is easy
             to get subtly wrong, and "on" against null cannot be misread. The
             two callers are UpdateFooterNowPlayingMotion and
             UpdateViewerNowPlayingMotion.

             CENTRED, not standing on a floor: both rows are one thin line with
             no baseline to sit on, so the bars grow both ways from the middle
             and land on the same centre line the text uses.
             RenderTransformOrigin is the only thing to change for the other
             shape - 1 instead of 0.5 stands them on their feet.

             EVERY BAR REPEATS ON ITS OWN, and that is the whole difference
             between this reading as a loop and reading as a restart. The first
             cut put RepeatBehavior and AutoReverse on the STORYBOARD, so each
             bar finished early, held its last value until the longest one caught
             up, and then all four turned round together on that shared boundary
             - four periods that were never allowed to be four. It read as one
             restart rather than a loop (2026-08-26). On the children there is
             no shared boundary left to fall onto.

             The four periods divide into each other only after about eleven
             seconds, which is long enough that nothing reads as a beat. Nudging
             one is safe; making two of them tidy multiples is what would bring
             the block-blinking back.

             BeginTime staggers the START so the bars do not all leave the same
             line at once - it reads as a ripple crossing the mark, and once the
             periods have pulled apart it stops mattering.

             Acceleration AND Deceleration: with AutoReverse the turn happens at
             both ends, and easing only one end leaves the other snapping into
             the return.

             ScaleY ONLY. Nothing here touches a property that measures - height
             would put a layout pass through the whole row on every frame of
             every bar, and this runs for as long as the music does. -->
        <Style x:Key="SoundPulseStyle"
                TargetType="ContentControl">
            <Setter Property="Focusable" Value="False"/>
            <!-- Decoration: it must never take a click meant for the row it
                 sits in, and neither row has anything else that would want the
                 pointer here. -->
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Resources>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Width" Value="2"/>
                                    <Setter Property="Height" Value="11"/>
                                    <Setter Property="Margin" Value="1,0,0,0"/>
                                    <Setter Property="RadiusX" Value="1"/>
                                    <Setter Property="RadiusY" Value="1"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                    <!-- The ink of whatever row it lands in, so
                                         the mark belongs to that strip rather
                                         than bringing a white of its own. Dynamic
                                         because the viewer's own copy of this key
                                         is replaced under the full-screen plate. -->
                                    <Setter Property="Fill"
                                            Value="{DynamicResource ForegroundText}"/>
                                </Style>
                            </StackPanel.Resources>
                            <!-- The resting scales differ from each other on
                                 purpose: a paused mark is a still WAVE, not four
                                 bars of one height. -->
                            <Rectangle>
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="Pulse1" ScaleY="0.45"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle>
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="Pulse2" ScaleY="0.9"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle>
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="Pulse3" ScaleY="0.6"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle>
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="Pulse4" ScaleY="0.3"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <!-- A PLAIN Trigger ON THE TEMPLATED TYPE'S OWN
                                 PROPERTY, which is the only form that works
                                 here. The first cut used a DataTrigger bound
                                 with RelativeSource TemplatedParent and the
                                 bars simply stood still in both places: that
                                 RelativeSource resolves inside a template's
                                 VISUAL TREE, not inside ControlTemplate.
                                 Triggers, so the binding never produced a value
                                 and the trigger never matched. Nothing said so
                                 - no error, no warning, just no motion. -->
                            <Trigger Property="Tag" Value="on">
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="PulseRun">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Pulse1"
                                                    Storyboard.TargetProperty="ScaleY"
                                                    From="0.30" To="1.0" Duration="0:0:0.36"
                                                    BeginTime="0:0:0"
                                                    AutoReverse="True" RepeatBehavior="Forever"
                                                    AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                                            <DoubleAnimation Storyboard.TargetName="Pulse2"
                                                    Storyboard.TargetProperty="ScaleY"
                                                    From="1.0" To="0.35" Duration="0:0:0.53"
                                                    BeginTime="0:0:0.08"
                                                    AutoReverse="True" RepeatBehavior="Forever"
                                                    AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                                            <DoubleAnimation Storyboard.TargetName="Pulse3"
                                                    Storyboard.TargetProperty="ScaleY"
                                                    From="0.45" To="0.95" Duration="0:0:0.31"
                                                    BeginTime="0:0:0.16"
                                                    AutoReverse="True" RepeatBehavior="Forever"
                                                    AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                                            <DoubleAnimation Storyboard.TargetName="Pulse4"
                                                    Storyboard.TargetProperty="ScaleY"
                                                    From="0.85" To="0.25" Duration="0:0:0.45"
                                                    BeginTime="0:0:0.24"
                                                    AutoReverse="True" RepeatBehavior="Forever"
                                                    AccelerationRatio="0.4" DecelerationRatio="0.4"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <!-- Stop, not Pause: the bars go back to the
                                         resting scales above rather than freezing
                                         on whatever frame the pause landed on. -->
                                    <StopStoryboard BeginStoryboardName="PulseRun"/>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- THE PLACE BADGE: the dot that rides a folder icon's lower-left
             corner to say what kind of place the folder is on. The tree has
             drawn it for network folders since long before these keys existed;
             they were pulled out of that template on 2026-08-26 when the
             hidden-folder list needed the same mark, because the same mark in
             two places cannot be two sets of literals.
             Fixed on both themes and not palette rows, for the reason the
             bookmark ribbon's blue is fixed: a mark of this kind is worth
             having only if it is the same mark everywhere.

             GREEN IS THE TREE'S OWN, unchanged. A round of matching it to the
             shell's SIID_DRIVENET icon instead (#5CE56D, its own gradient's
             commonest band) was wrong about which green was being pointed at -
             the report said "the tree's", and the tree's is this.

             BLUE IS MATCHED TO IT ON PERCEIVED BRIGHTNESS, not on HSL
             lightness, and that distinction is the whole of its history. The
             first cut rotated a green's hue keeping saturation and lightness,
             which is the obvious thing to do and lands at about half the
             brightness - blue simply carries less luminance than green at the
             same L. Measured: green 0.394, and an exact luminance match (0.401)
             then read slightly BRIGHTER than the green in the hand - a
             saturated light blue carries more attention than the number says.
             This is one step under it, 0.353, which is where the pair settled.
             So: match by luminance to get close, then take a step down for
             blue. Not by lightness, and not by the number alone.
             The bookmark blue was considered and is 0.269, i.e. darker again
             than a rotation that had already been reported as too dark. -->
        <SolidColorBrush x:Key="PlaceBadgeNetworkBrush"
                Color="#FF3FBF6B"/>
        <SolidColorBrush x:Key="PlaceBadgeCloudBrush"
                Color="#FF54A6EE"/>
        <!-- A NAS that is asleep is normal rather than an error, so the badge
             goes quiet instead of red - the row is already dimmed around it. -->
        <SolidColorBrush x:Key="PlaceBadgeOfflineBrush"
                Color="#FF8C9196"/>
        <!-- A rim, so the dot reads on top of a yellow folder. Black at 40%
             rather than the surface colour: it has to work over the icon, which
             is what is actually behind it, not over the row. -->
        <SolidColorBrush x:Key="PlaceBadgeRimBrush"
                Color="#66000000"/>

        <SolidColorBrush x:Key="GrabLineRestBrush"
                Color="#606B6B6B"/>
        <SolidColorBrush x:Key="GrabLineHoverBrush"
                Color="#8C6B6B6B"/>
        <SolidColorBrush x:Key="GrabLineDragBrush"
                Color="#4D6B6B6B"/>

        <!-- The grab line for every resize edge (and the viewer's divider).
             The two states carry ALPHA rather than darker greys, and that is
             deliberate: these values are fixed across both themes, so a darker
             grey would soften the line on the dark theme and strengthen it on
             the light one. Alpha blends toward whatever is actually behind, so
             it softens both the same way.
             Softened 2026-08-09 - the opaque #FF6B6B6B / #FF9B9B9B read too
             loud for a 1px hint, from hover onward, "눈에 좀 계속 밟히네요".
             DRAG IS NOW FAINTER THAN HOVER, which looks backwards written down
             and is right in the hand: hover has to say "there is something to
             grab here", and once it IS grabbed the cursor has already turned
             into the resize arrows and says it better than a line can. Same
             base grey for both so the two states read as one scale; only the
             alpha differs, and it is the only thing to touch if they ever need
             another nudge (8C hover / 4D drag).
             IsDragging is declared AFTER IsMouseOver on purpose - both are
             true mid-drag, and the later trigger is the one that wins. -->
        <Style x:Key="ResizeThumbStyle"
                TargetType="Thumb">
            <!-- Mouse-only, like every other grip and chip in this app: a
                 Thumb takes keyboard focus by default, and dragging one left
                 the focus sitting on a grab strip - so the arrow keys stopped
                 reaching the tree, and hiding the strip (entering full screen)
                 stranded the focus entirely (2026-08-09). Nothing here has a
                 keyboard gesture to lose. -->
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <!-- Template-bound so the RESTING line is opt-in per
                                 instance: the style's own Background setter is
                                 Transparent, which is what the window's outer
                                 edges want (a resting line on all four would be
                                 a frame around the window, not a hint) and what
                                 the tree/panel split wants too. Only the
                                 thumbnail strip's thumb sets GrabLineRestBrush
                                 on itself. The triggers below still win over
                                 this binding, so hover and drag are unchanged
                                 either way. -->
                            <Border x:Name="Bar"
                                    Width="1"
                                    HorizontalAlignment="Center"
                                    Background="{TemplateBinding Background}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bar"
                                        Property="Background"
                                        Value="{StaticResource GrabLineHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging"
                                    Value="True">
                                <Setter TargetName="Bar"
                                        Property="Background"
                                        Value="{StaticResource GrabLineDragBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The same thumb turned on its side, for the docked window's top and
             bottom edges. A copy rather than one style with a bound orientation:
             the whole template is a Grid holding one Border, and a second copy
             of it costs less than the machinery to rotate the first. -->
        <Style x:Key="ResizeThumbHorizontalStyle"
                TargetType="Thumb">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <!-- Opt-in resting line, same as the vertical copy. -->
                            <Border x:Name="Bar"
                                    Height="1"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bar"
                                        Property="Background"
                                        Value="{StaticResource GrabLineHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging"
                                    Value="True">
                                <Setter TargetName="Bar"
                                        Property="Background"
                                        Value="{StaticResource GrabLineDragBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>




        <Style x:Key="ExplorerTreeViewStyle"
                TargetType="TreeView">
            <!-- Top padding dropped from 8 to 0 - the gap between the top
                 divider and the first drive row (C:) read as too generous. -->
            <Setter Property="Padding"
                    Value="4,0,4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeView">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <!-- The two edge shades ride INSIDE this template on
                                 purpose. As siblings in the window's own grid
                                 they would be pinned to a row number, and
                                 ApplyFavoritesPosition swaps the tree between
                                 RowUpper and RowLower - the shades would stay behind at
                                 the old edge. Here they travel with the tree,
                                 and the ScrollViewer they answer to is right
                                 beside them.
                                 A LinearGradientBrush rather than a bitmap
                                 (resolution-independent, one brush for both
                                 themes) and rather than a DropShadowEffect
                                 (that is a pixel shader with an intermediate
                                 surface, for a rectangle that never moves).
                                 Their job is to veil the CONTENT - names and
                                 icons - at the edge, not to shade the
                                 background, which is why one black gradient
                                 works on the dark theme as well as the light
                                 one. Lit by UpdateTreeEdgeShades. -->
                            <Grid>
                                <ScrollViewer x:Name="PART_TreeScrollViewer"
                                        Focusable="False"
                                        Padding="{TemplateBinding Padding}"
                                              Template="{StaticResource MinimalScrollViewerTemplate}"
                                              CanContentScroll="True"
                                              HorizontalScrollBarVisibility="{Binding Path=(ScrollViewer.HorizontalScrollBarVisibility), RelativeSource={RelativeSource TemplatedParent}}"
                                              VerticalScrollBarVisibility="{Binding Path=(ScrollViewer.VerticalScrollBarVisibility), RelativeSource={RelativeSource TemplatedParent}}">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                                <!-- Deep and faint rather than short and dark:
                                     the same veil spread over more rows reads
                                     as depth, where concentrating it at the
                                     edge reads as a grey bar drawn on top of
                                     the list. The middle stop sits just above
                                     the straight line between the other two,
                                     so the falloff stays gentle the whole way
                                     down instead of dropping off early. -->
                                <Border x:Name="TreeTopShade"
                                        VerticalAlignment="Top"
                                        IsHitTestVisible="False"
                                        Opacity="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0"
                                                EndPoint="0,1">
                                            <GradientStop Offset="0"
                                                    Color="#48000000"/>
                                            <GradientStop Offset="0.5"
                                                    Color="#26000000"/>
                                            <GradientStop Offset="1"
                                                    Color="#00000000"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border x:Name="TreeBottomShade"
                                        VerticalAlignment="Bottom"
                                        IsHitTestVisible="False"
                                        Opacity="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,1"
                                                EndPoint="0,0">
                                            <GradientStop Offset="0"
                                                    Color="#48000000"/>
                                            <GradientStop Offset="0.5"
                                                    Color="#26000000"/>
                                            <GradientStop Offset="1"
                                                    Color="#00000000"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Every tree row's full path, on hover. Requested by a user
             2026-07-31 (together with a horizontal scrollbar; only this half
             was taken) for names the sidebar's width cuts to "긴폴더이름...",
             and shown on EVERY row rather than only the cut ones - the trimmed-
             only version was built first and rejected: a tooltip that appears
             on some rows and not others reads as broken, and the path is worth
             having either way. This supersedes the older reasoning in the
             favorites style below ("the tree needs no path tooltip, its rows
             sit under their own parents"); favorites and tree now say the same
             kind of thing on hover.

             The full PATH, not just the name that got cut - the path contains
             the name anyway, so nothing is lost by it. Binds
             FileSystemItem.FullPath, so this style belongs to tree rows;
             another item type needs its own tooltip rather than this one,
             which would silently come up blank.

             FontSize is bound through the placement target: a tooltip is its
             own window, outside the tree's visual tree, so it inherits nothing
             and would otherwise ignore Ctrl +/-. The delay is the favorites'
             900ms, not WPF's default - brushing past a row on the way
             somewhere else shouldn't pop anything up. -->
        <!-- Implicit, so all three of the app's tooltips (tree row, favorites
             row, bookmark panel row) take it without being told. They set only
             Content and FontSize, which left the surface itself at WPF's stock
             chrome - a pale background with black text, in a dark-themed window
             (2026-08-02). It follows the theme now, using the same three
             brushes the menus do.

             Defined ABOVE its first use on purpose: the ToolTip objects below
             live inside Setter values, and a style they cannot find yet is a
             style they never get. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background"
                    Value="{DynamicResource PanelBackground}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource MenuForeground}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource PanelBorder}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="8,4"/>
            <!-- No MaxWidth, no wrapping. Both were tried on 2026-08-02 and
                 taken straight back out: a path broken across two lines reads
                 worse than a long one - it splits at whatever space happens to
                 fall near the limit, in the middle of a name. A path is one
                 string and belongs on one line. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One file-kind toggle in the version footer. Deliberately quiet when
             off - text only, no border - so a strip of eight reads as a line of
             labels rather than as eight buttons; the one that is ON is the only
             thing meant to catch the eye. -->
        <Style x:Key="FooterFilterChipStyle"
                TargetType="ToggleButton">
            <!-- Set here so BOTH strips take it - the footer's filters and the
                 viewer's row, the same reasoning as the font size below. See
                 the resource for why it is fixed rather than an option. -->
            <Setter Property="FontWeight"
                    Value="{DynamicResource FooterChipFontWeight}"/>
            <!-- Follows Ctrl +/- through the resource, and it is set HERE so
                 that every chip in either strip takes it - the viewer's zoom
                 row used to be the one place left at a fixed 11 (asked
                 for both linked, 2026-08-10). What made that possible was
                 giving the two fixed-width readouts (% and the media time)
                 hidden twins instead of hardcoded widths, so a growing font
                 widens its own slot. -->
            <Setter Property="FontSize"
                    Value="{DynamicResource FooterChipFontSize}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource ForegroundText}"/>
            <Setter Property="Opacity"
                    Value="0.65"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Margin"
                    Value="{DynamicResource FooterChipMargin}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="3"
                                Padding="{DynamicResource FooterChipPadding}"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}"
                                    VerticalAlignment="Center"
                                    Margin="{DynamicResource FooterChipTextNudge}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowHoverBackground}"/>
                                <Setter Property="Opacity"
                                        Value="1"/>
                                <!-- Full ink was not enough of a step to notice
                                     in a strip of eight (2026-08-12), so the
                                     colour moves as well. The lit chip below
                                     never sees this - its trigger runs later and
                                     keeps its own white. -->
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FooterChipHoverForeground}"/>
                            </Trigger>
                            <!-- Grey, not the tree's selection colour and not an
                                 accent: the lit chip has to stand out from the
                                 seven quiet ones without shouting across the
                                 strip. What carries it is the full-strength
                                 text, not the fill (2026-08-02). -->
                            <Trigger Property="IsChecked"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource FooterChipCheckedBackground}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FooterChipCheckedForeground}"/>
                                <Setter Property="Opacity"
                                        Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A chip that carries a SHAPE instead of a word. The filter chips'
             template draws its Content into a TextBlock, which is right for
             them and cannot hold a Path - and the filmstrip's switch had been
             making do with box-drawing characters, which read as a broken
             glyph after a while (2026-08-10).

             Everything else is inherited, so the lit/hover states and the
             opacity are the row's, not this chip's own. The shape follows the
             button's Foreground rather than fixing a colour, which is what
             carries it through those states. -->
        <Style x:Key="FooterFilterGlyphChipStyle"
                TargetType="ToggleButton"
                BasedOn="{StaticResource FooterFilterChipStyle}">
            <!-- NO OUTLINE. The ToggleButton's own default border was showing
                 through here, and since the checked trigger takes Opacity from
                 0.65 to 1 it BRIGHTENED whenever the chip came on - a second,
                 accidental "on" mark beside the fill that already says it
                 (reported 2026-08-15 on 자름맞춤). The outline belongs to the
                 bare-glyph chips next door and has a reason there: a "1:1" or a
                 "−" reads as text until something draws a box round it. These
                 carry a SHAPE, so they read as controls without one. -->
            <Setter Property="BorderThickness"
                    Value="0"/>
            <!-- The box every button in the viewer strip shares. Only used by
                 the viewer, so the footer's filter chips - which size
                 themselves to their words - are untouched by it. -->
            <Setter Property="MinWidth"
                    Value="{DynamicResource ViewerChipBoxWidth}"/>
            <Setter Property="MinHeight"
                    Value="{DynamicResource ViewerChipBoxHeight}"/>
            <Setter Property="Margin"
                    Value="{DynamicResource ViewerChipMargin}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="5,2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowHoverBackground}"/>
                                <Setter Property="Opacity"
                                        Value="1"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FooterChipHoverForeground}"/>
                            </Trigger>
                            <Trigger Property="IsChecked"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource FooterChipCheckedBackground}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FooterChipCheckedForeground}"/>
                                <Setter Property="Opacity"
                                        Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The exclusion chip. Same shape and size as the seven kind chips -
             it belongs to that strip - but it is the only one that TAKES
             files away rather than letting them through, and a strip where
             every chip looks alike would say nothing about that. So it carries
             its own ink instead of the shared ForegroundText, and its lit fill
             is a wash of the same hue rather than the grey/blue the others
             take. Colour, not opacity: dimming is how this app marks nothing
             (see the 흐리게 rule) and a filter that hides files has to be the
             most legible thing in the footer, not the least.

             Both inks ARE rows in 색상 설정 as of 2026-08-15. What stood here
             said they should not be - "one more colour to pick is a cost every
             user pays for a strip most of them will never turn on" - and the
             chain is what answered it: rows became cheap to keep in step, so
             the reason for holding these back went with it. -->
        <Style x:Key="FooterExcludeChipStyle"
                TargetType="ToggleButton"
                BasedOn="{StaticResource FooterFilterChipStyle}">
            <Setter Property="Foreground"
                    Value="{DynamicResource FooterChipExcludeForeground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="3"
                                Padding="{DynamicResource FooterChipPadding}"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}"
                                    VerticalAlignment="Center"
                                    Margin="{DynamicResource FooterChipTextNudge}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowHoverBackground}"/>
                                <Setter Property="Opacity"
                                        Value="1"/>
                            </Trigger>
                            <!-- Lit the way the seven kind chips are - a solid
                                 fill rather than a tinted wash. That much is
                                 settled: the wash was tried first so the
                                 coloured ink could stay in both states, and the
                                 on/off difference was too quiet to read
                                 (2026-08-10).
                                 THE LIT TEXT IS THE ONE BOTH CHIPS SHARE, and it
                                 was briefly changed to this chip's own ink on
                                 2026-08-15 - the row named 제외 칩 글자 looked
                                 broken because it only did anything while the
                                 chip was OFF, so it was pointed at both states.
                                 That put the light theme's own two defaults on
                                 top of each other (#B3453B on #B3453B) and the
                                 word vanished, which is the shape of the answer:
                                 this chip's hue is chosen to be READ AGAINST the
                                 footer, not to be read against ITSELF. Reverted
                                 within the hour. The row was misnamed rather than
                                 misused - it is the ink at rest, and the lit text
                                 belongs to 칩 켜짐 글자 for every chip in the
                                 strip. -->
                            <Trigger Property="IsChecked"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource FooterChipExcludeCheckedBackground}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FooterChipCheckedForeground}"/>
                                <Setter Property="Opacity"
                                        Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The chip above, minus the checked state: the viewer's zoom stepper
             (− and +) does something rather than IS something, so it can't be
             a ToggleButton, but it sits in the same strip as 맞춤/1:1 and has
             to match them pixel for pixel. Kept as a separate Style rather
             than a shared template because the checked trigger is the only
             difference and duplicating four setters beats a BasedOn chain
             across two control types. -->
        <Style x:Key="FooterActionChipStyle"
                TargetType="Button">
            <Setter Property="FontWeight"
                    Value="{DynamicResource FooterChipFontWeight}"/>
            <!-- "Match them pixel for pixel" now includes the zoom: same
                 resource as the toggles above. -->
            <Setter Property="FontSize"
                    Value="{DynamicResource FooterChipFontSize}"/>
            <!-- These are the ones left carrying a bare glyph once 맞춤, 1:1 and
                 내비게이터 became marks - − + < > and the transport row. The
                 outline is what makes them read as buttons beside the icons,
                 and the shared box is what keeps the row even (asked for
                 both, 2026-08-10). -->
            <Setter Property="BorderBrush"
                    Value="{DynamicResource ViewerChipBorderBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="MinWidth"
                    Value="{DynamicResource ViewerChipBoxWidth}"/>
            <Setter Property="MinHeight"
                    Value="{DynamicResource ViewerChipBoxHeight}"/>
            <Setter Property="Margin"
                    Value="{DynamicResource ViewerChipMargin}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource ForegroundText}"/>
            <Setter Property="Opacity"
                    Value="0.65"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Margin"
                    Value="{DynamicResource FooterChipMargin}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{DynamicResource FooterChipPadding}"
                                SnapsToDevicePixels="True">
                            <TextBlock Text="{TemplateBinding Content}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="{DynamicResource FooterChipTextNudge}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowHoverBackground}"/>
                                <Setter Property="Opacity"
                                        Value="1"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FooterChipHoverForeground}"/>
                            </Trigger>
                            <!-- A step that can't be taken (already at fit, or
                                 at 800%) stays visible and stops answering -
                                 the alternative, hiding it, would shuffle the
                                 strip's width every time the zoom crosses an
                                 end. Half the resting ink, which is the one
                                 place opacity still means "unavailable"
                                 rather than "secondary". -->
                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter Property="Opacity"
                                        Value="0.3"/>
                                <Setter Property="Cursor"
                                        Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The style above, drawing a SHAPE instead of a character - the same
             split FooterFilterGlyphChipStyle makes for the toggles, and for the
             same reason: that template draws Content through a TextBlock, so a
             Path put in one renders as nothing at all (which is how the mute
             speaker came to be invisible, 2026-08-09).
             Everything else is inherited, so the box, the outline, the hover
             and the greyed-out step all stay the row's rather than this
             style's. -->
        <Style x:Key="FooterActionGlyphChipStyle"
                TargetType="Button"
                BasedOn="{StaticResource FooterActionChipStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="5,2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"
                                    HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowHoverBackground}"/>
                                <Setter Property="Opacity"
                                        Value="1"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FooterChipHoverForeground}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                    Value="False">
                                <Setter Property="Opacity"
                                        Value="0.3"/>
                                <Setter Property="Cursor"
                                        Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The same chip, plus the half-step up while the ROW is hovered
             (0.65 -> 0.9, the mark's own numbers) - so the whole held-track
             strip brightens as one thing under the pointer (2026-08-13).
             The second condition keeps this out of the way of a DIRECT hover: a
             Style trigger outranks the template's own IsMouseOver, so without it
             the button pointed at directly would sit at 0.9 instead of its full
             1.0.
             Keyed rather than written inline (2026-08-26): it was one button's
             private Style until the row gained a play/pause beside the stop, and
             a hover contract that says "the strip brightens as ONE thing" cannot
             be stated once per button and stay true. -->
        <!-- PAUSE AND STOP AT FULL INK (2026-09-14). The footer's other chips
             rest at 0.65 (FooterActionChipStyle) because they are occasional
             controls in a row of occasional controls, and these used to follow
             that, stepping to 0.9 only while the pointer was over the row.
             While a track plays they are the controls reached for most, from
             anywhere in the app, and at 0.65 they read as greyed out beside the
             file name. So they rest at 1; the pointer still shows itself through
             the template's own hover background and hover colour. -->
        <Style x:Key="FooterNowPlayingChipStyle"
                TargetType="Button"
                BasedOn="{StaticResource FooterActionGlyphChipStyle}">
            <Setter Property="Opacity"
                    Value="1"/>
        </Style>

        <!-- The little chevron that closes the viewer from the divider, so the
             gesture is where the eye already is instead of a trip to the
             window's top-right corner (2026-08-09). Its own style rather
             than the header's ToggleButtonStyle: this one is a tall narrow
             plate riding a 1px line, not a square button in a row of squares.
             Resting ink matches the footer chips (0.65) so it reads as the
             same quiet class of control. -->
        <!-- Position and volume sliders for the viewer's transport strip. Thin
             enough to read as a readout rather than a control panel, and the
             played part wears the caption's own ink at the same 0.65 the rest
             of the strip does, so nothing here shouts. Every part is
             Focusable=False, like the app's other mouse-only chrome. -->
        <Style x:Key="ViewerMediaSliderStyle"
                TargetType="Slider">
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Height"
                    Value="{DynamicResource ViewerMediaSliderHeight}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="3"
                                    CornerRadius="1.5"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource TreeGuideLineBrush}"/>
                            <!-- Both repeat buttons fill the control's FULL
                                 height, with the 3px bar drawn inside them.
                                 IsMoveToPointEnabled only answers clicks that
                                 land on the track's own parts, so when they
                                 were 3px tall the strip demanded the cursor
                                 hit a 3-pixel band - or the thumb itself -
                                 and everything else fell through to dead
                                 space ("동그라미를 아주 정확히 클릭한 후",
                                 2026-08-09). The whole 18px band is the
                                 target now. -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge"
                                            Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent">
                                                    <Border Height="3"
                                                            CornerRadius="1.5"
                                                            VerticalAlignment="Center"
                                                            Opacity="0.65"
                                                            Background="{DynamicResource ForegroundText}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge"
                                            Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12"
                                            Height="12"
                                            Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Ellipse Width="12"
                                                            Height="12"
                                                            Fill="{DynamicResource ForegroundText}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewerCollapseButtonStyle"
                TargetType="Button">
            <Setter Property="Focusable"
                    Value="False"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Opacity"
                    Value="0.65"/>
            <!-- Template-bound rather than fixed: the collapse chevron sits on
                 the viewer's background, the expand chevron on the tree's. -->
            <Setter Property="Background"
                    Value="{DynamicResource ViewerBackground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowHoverBackground}"/>
                                <Setter Property="Opacity"
                                        Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowPathTooltip"
                TargetType="TextBlock">
            <Setter Property="ToolTipService.InitialShowDelay"
                    Value="{StaticResource TooltipShowDelay}"/>
            <Setter Property="ToolTipService.ShowDuration"
                    Value="20000"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <!-- TooltipPath, not FullPath: the 더 보기 · 접기 row shares
                         this style and has no path of its own, so the model
                         answers with its parent's. Identical for every real
                         row. -->
                    <ToolTip Content="{Binding TooltipPath}"
                            FontSize="{Binding PlacementTarget.FontSize, RelativeSource={RelativeSource Self}}"/>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type models:FileSystemItem}"
                ItemsSource="{Binding Children}">
            <!-- A horizontal StackPanel measures children with infinite available
                 width, so TextTrimming never actually engaged - the text just
                 rendered past the edge and got clipped with no "...". A Grid's
                 star column constrains the TextBlock to the real remaining width. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="RowIcon"
                        Grid.Column="0"
                        Source="{Binding Icon}"
                        Width="{DynamicResource IconSize}"
                        Height="{DynamicResource IconSize}"
                        Margin="{DynamicResource FolderRowIconMargin}"
                       VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality"/>
                <!-- Network marker: a small dot on a folder icon's lower-left
                     corner when the item lives on a network drive - the same
                     idea as Explorer badging the network drive's own icon, so
                     NAS territory stays recognizable deep in a scroll. Shown
                     by trigger (IsOnNetworkDrive + folder + icon visible - it
                     must vanish along with the icon when folder icons are
                     toggled off). Green, the conventional "connected" hue,
                     with a dark rim so it reads on top of the yellow folder.
                     Turns RED while the drive isn't answering (see
                     IsNetworkDriveOffline and MainWindow's poll) - Explorer
                     crosses the drive out in the same situation. Same dot,
                     same place, only the colour: at 7px a cross is mush,
                     while a colour change on a shape already in the eye's
                     memory reads instantly. -->

                <!-- CLOUD DRIVES TAKE THE SAME DOT IN BLUE (2026-08-26, on
                     request). One element, not two: a folder is on one kind of
                     place, and a second ellipse would eventually be asked what
                     it means when both are lit. The cloud trigger is declared
                     AFTER the network one so it wins if a provider ever mounts
                     itself over SMB - the more particular answer.
                     Colours are shared with the hidden-folder list's copy of
                     this badge; see the PlaceBadge* brushes. -->
                <Ellipse x:Name="NetworkBadge"
                        Grid.Column="0"
                        Width="7"
                        Height="7"
                        Fill="{DynamicResource PlaceBadgeNetworkBrush}"
                        Stroke="{DynamicResource PlaceBadgeRimBrush}"
                        StrokeThickness="1"
                        Margin="{DynamicResource FolderRowIconMargin}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Visibility="Collapsed"/>
                <!-- Foreground and FontSize intentionally not set here - both inherit
                     (Foreground from the TreeViewItem for selection-driven white text,
                     FontSize from the TreeView so Ctrl+/- zoom can rescale every row). -->
                <!-- LineHeight is Auto (NaN) at every setting except the bottom
                     of 행 간격, where the row has run its padding out and the
                     line box is one of the two things still holding the row
                     open - see RowContentSqueeze in ApplyLayoutMetrics.
                     BlockLineHeight is what makes the number mean the line's
                     whole height rather than a minimum; with LineHeight left at
                     Auto the strategy is not consulted at all, so it is safe to
                     state here once and drive the height from one place. -->
                <TextBlock x:Name="NameText"
                           Grid.Column="1"
                           Text="{Binding Name}"
                           VerticalAlignment="Center"
                        LineHeight="{DynamicResource RowLineHeight}"
                        LineStackingStrategy="BlockLineHeight"
                        Style="{StaticResource RowPathTooltip}"
                        TextTrimming="CharacterEllipsis"/>
                <!-- VS Code-style inline rename: swapped in for NameText while
                     IsEditing (see the DataTrigger below) instead of opening a
                     separate popup dialog. Focus/selection and commit/cancel
                     are handled in code-behind (RenameTextBox_* in MainWindow.xaml.cs). -->
                <!-- THE FOUR COLOURS WERE THE DARK THEME'S, FROZEN (fixed
                     2026-08-29, on report). `#FF3C3C3C` is not a chosen grey -
                     it is exactly ControlBackground's dark value, taken before
                     there was a light theme to take it from. So renaming a row
                     in light mode opened a dark box in the middle of a pale
                     tree, with white text in it.
                     The three chrome keys follow the theme at App level, which
                     is where every other surface in this app gets its ground,
                     and the caret takes what the path bar and the search box
                     take. Dark is unchanged apart from the border, which joins
                     PanelBorder's family (#454545) instead of keeping a
                     one-off #5A5A5A.
                     It keeps a ground of its own rather than going transparent
                     like those two boxes: they sit inside a container that
                     draws the field, and this one sits directly on a tree row
                     that may be selected or hovered underneath it. -->
                <TextBox x:Name="NameEditBox"
                         Grid.Column="1"
                         Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="Collapsed"
                         Background="{DynamicResource ControlBackground}"
                         Foreground="{DynamicResource DialogForeground}"
                         CaretBrush="{DynamicResource ForegroundText}"
                         BorderBrush="{DynamicResource PanelBorder}"
                         BorderThickness="1"
                         Padding="2,0"
                         VerticalAlignment="Center"
                         IsVisibleChanged="RenameTextBox_IsVisibleChanged"
                         KeyDown="RenameTextBox_KeyDown"
                         LostFocus="RenameTextBox_LostFocus"
                         Loaded="RenameTextBox_Loaded"/>
                <!-- Shown in place of icon+name for the synthetic "… 더 보기 (N)"
                     row that caps oversized folders (FileSystemItem.DisplayCap);
                     clicking it reveals the rest (see
                     TreeViewItem_PreviewMouseLeftButtonDown). -->
                <!-- IT SAYS WHOSE LIST IT IS (2026-08-17, on request). Two of
                     these rows can sit a line apart - one folder's overflow
                     under another's - and with nested folders of the same name
                     there was nothing on the row to tell them apart. Selecting
                     the owning folder on a press (03d96e2) answers it after the
                     fact; the tooltip answers before. The alternative recorded
                     that day was printing the name in the row itself, and its
                     cost was the row getting longer - a tooltip costs nothing
                     until it is asked for. -->
                <!-- NEVER BOLD WITH THE FOLDERS, and set here rather than on
                     the row: the weight is inherited from the TreeViewItem, and
                     a row-level override did not reach this text (2026-08-26 -
                     it was tried and the row stayed bold). A local value on the
                     element itself is what settles it.
                     The whole job of "폴더만 굵게" is telling a folder from a
                     file, and none of the rows that use this text - 더 보기 ·
                     접기 · 비어 있음 · 필터로 감춰진 - is either one. The weight
                     was saying nothing here and only making them loud. -->
                <TextBlock x:Name="ShowMoreText"
                           Grid.Column="1"
                           Text="{Binding ShowMoreLabel}"
                           Foreground="{DynamicResource ShowMoreForeground}"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           FontStyle="Italic"
                           FontWeight="Normal"
                           Style="{StaticResource RowPathTooltip}"
                           TextTrimming="CharacterEllipsis"/>
                <!-- Shown only when this folder has its own remembered sort
                     (HasSortOverride - see FileSystemItem and
                     Services/FileSystemService.SortOverrides), independent of
                     the app-wide default. Click OPENS THE SORT MENU (see
                     TreeViewItem_PreviewMouseLeftButtonDown's
                     clickedOnSortOverrideIcon check) - it used to rotate
                     through the states instead, which stopped working the
                     moment 유형/크기 joined 이름/날짜: five states already took
                     four clicks to reach the last one, and nine is not a
                     control. The menu names every state in words and clears
                     the override too.
                     Wrapped in its own Border so that check can find the click
                     by name without also matching some other Border further
                     up the row (RowBorder's hover/selection highlight, etc). -->
                <Border x:Name="SortOverrideIconBorder"
                        Grid.Column="2"
                        Visibility="Collapsed"
                        Background="Transparent"
                        Margin="{DynamicResource SortOverrideIconMargin}"
                        Padding="{DynamicResource SortOverrideIconPadding}"
                        Cursor="Hand"
                        ToolTip="{Binding SortOverrideTooltip}">
                    <!-- Right margin (6) clears the overlay scrollbar's 5px
                         hit-test width (MinimalScrollBarStyle) - that 5px is
                         the floor for this number, not a preference: it's
                         drawn on top of full-bleed row content
                         (see MinimalScrollViewerTemplate) and still hit-tests
                         at Opacity 0, so without this gap it silently steals
                         clicks meant for this icon. Padding (6 horizontal,
                         0 vertical - the 13px-tall image already fits inside
                         the row's existing height set by the 16px folder/file
                         icon, so any vertical padding here would be what
                         pushes the row taller only while this icon shows)
                         widens the actual clickable area well beyond the
                         image itself, which is otherwise a fiddly target to
                         land a click on. -->
                    <!-- Vector, not one of the old PNG pairs: it takes the
                         row's own folder-name brush, so light and dark themes
                         (and any custom colour) need no second asset - which
                         was the blocker that kept 유형/크기 waiting. -->
                    <Path Data="{Binding SortOverrideIconGeometry}"
                            Fill="{DynamicResource FolderNameForeground}"
                            Width="{DynamicResource SortOverrideIconWidth}"
                            Height="{DynamicResource SortOverrideIconHeight}"
                            Stretch="Uniform"
                            VerticalAlignment="Center"/>
                </Border>
                <!-- 책갈피 marker (IsBookmarked, toggled via Ctrl+Alt+K or the
                     right-click menu; Ctrl+Alt+L/J cycles through them).
                     Drawn as an OVERLAY at the row's right edge (column span
                     + right alignment) rather than occupying a column of its
                     own, so appearing never displaces the sort icon - it sits
                     inside the 12px strip that icon already leaves clear for
                     the scrollbar. Not a click target (IsHitTestVisible off,
                     so it can't even steal a row click), which is why living
                     under the scrollbar's hover zone costs nothing. Height
                     follows the font zoom (BookmarkMarkerHeight, grow-only
                     like the sort icon's). The glyph is Material Symbols
                     "bookmark" (SVG v2, flat-top ribbon) kept
                     in its native 960 grid, Stretch doing the fitting - same
                     convention as the header's keep-pin. Fixed mid-blue by
                     design: legible on both themes without adding a 16th
                     palette entry. -->
                <!-- Column of its own (2026-07-28), replacing a full-width
                     overlay pinned to the right edge. The overlay was chosen so
                     that a marker appearing would never displace the sort icon,
                     and it did hold that - but taking no part in layout meant
                     the name simply ran underneath it, which at a narrow window
                     put the ribbon on top of the last letters rather than on
                     the ellipsis. It also came and went while the window was
                     being resized, the row's content briefly outgrowing the
                     viewport it was being right-aligned against. A real column
                     ends both: the star column now measures against what is
                     actually left, so the name trims before the ribbon instead
                     of behind it, and there is nothing left to clip. -->
                <!-- Clicking the ribbon releases the bookmark (2026-08-04). It
                     is where the eye already is when the answer is "not this
                     one any more", and the two routes that existed - Ctrl+Alt+K
                     and the row menu - both ask the user to name a row that is
                     already marked in front of them.
                     The Border is the target rather than the glyph: a ribbon is
                     a few pixels of filled path, and a shape only takes a hit
                     where it paints. The transparent box around it is what
                     makes this the size of a thing meant to be clicked - the
                     same complaint the list rows' "−" lost to in August. -->
                <Border x:Name="BookmarkMarkerBorder"
                        Grid.Column="3"
                        Background="Transparent"
                        Margin="{DynamicResource BookmarkMarkerMargin}"
                        Padding="2,0"
                        Cursor="Hand"
                        ToolTip="{x:Static services:Strings.MenuBookmarkRemove}"
                        VerticalAlignment="Stretch"
                        Visibility="Collapsed">
                    <Path x:Name="BookmarkMarker"
                            Data="F1 M240-144v-672h480v672l-240-96-240 96Z"
                            Fill="#FF4A90E2"
                            Stretch="Uniform"
                            Height="{DynamicResource BookmarkMarkerHeight}"
                            VerticalAlignment="Center"/>
                </Border>
            </Grid>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing}"
                        Value="True">
                    <Setter TargetName="NameText"
                            Property="Visibility"
                            Value="Collapsed"/>
                    <Setter TargetName="NameEditBox"
                            Property="Visibility"
                            Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsShowMore}"
                        Value="True">
                    <Setter TargetName="RowIcon"
                            Property="Visibility"
                            Value="Collapsed"/>
                    <Setter TargetName="NameText"
                            Property="Visibility"
                            Value="Collapsed"/>
                    <Setter TargetName="ShowMoreText"
                            Property="Visibility"
                            Value="Visible"/>
                </DataTrigger>
                <!-- The blank rows parked after the last drive (see the
                     아래 여백 section). Same treatment as 더 보기 minus the
                     text: nothing drawn at all, so the run of them reads as
                     empty space rather than as rows. -->
                <DataTrigger Binding="{Binding IsBottomGap}"
                        Value="True">
                    <Setter TargetName="RowIcon"
                            Property="Visibility"
                            Value="Collapsed"/>
                    <Setter TargetName="NameText"
                            Property="Visibility"
                            Value="Collapsed"/>
                </DataTrigger>
                <!-- Only while expanded - a collapsed folder's icon can't be
                     usefully clicked to try a different sort without seeing
                     the result, and it's one less thing sitting in a closed
                     row. Reappears the moment the folder is expanded again,
                     since HasSortOverride itself is untouched by collapsing. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasSortOverride}"
                                Value="True"/>
                        <Condition Binding="{Binding IsExpanded}"
                                Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="SortOverrideIconBorder"
                            Property="Visibility"
                            Value="Visible"/>
                </MultiDataTrigger>
                <!-- Also shown (even with no override yet) while this folder is
                     both expanded AND the current selection, so it's reachable
                     with a single click right after selecting a folder instead
                     of having to go through the right-click menu first -
                     disappears again once selection moves on or the folder
                     collapses, unless that click actually left an override
                     behind (the trigger above keeps it visible while expanded). -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDirectory}"
                                Value="True"/>
                        <Condition Binding="{Binding IsExpanded}"
                                Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="SortOverrideIconBorder"
                            Property="Visibility"
                            Value="Visible"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsDirectory}"
                        Value="True">
                    <Setter TargetName="RowIcon"
                            Property="Visibility"
                            Value="{DynamicResource FolderIconVisibility}"/>
                </DataTrigger>
                <!-- AFTER the folder trigger, and that ordering is the whole
                     mechanism: a drive satisfies both conditions, and the last
                     matching trigger is the one WPF applies. So this reads as
                     the exception it is - drives are folders, except about
                     their icon. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDirectory}"
                                Value="True"/>
                        <Condition Binding="{Binding IsRoot}"
                                Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="RowIcon"
                            Property="Visibility"
                            Value="{DynamicResource DriveIconVisibility}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsBookmarked}"
                        Value="True">
                    <Setter TargetName="BookmarkMarkerBorder"
                            Property="Visibility"
                            Value="Visible"/>
                </DataTrigger>
                <!-- The network dot rides the folder icon: folder rows on a
                     network drive only, and only while the icon itself is
                     showing (folder icons toggled off hides the dot too). -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsOnNetworkDrive}"
                                Value="True"/>
                        <Condition Binding="{Binding IsDirectory}"
                                Value="True"/>
                        <Condition Binding="{Binding Visibility, ElementName=RowIcon}"
                                Value="Visible"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="NetworkBadge"
                            Property="Visibility"
                            Value="Visible"/>
                </MultiDataTrigger>
                <!-- Same three conditions, the other kind of place. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsOnCloudDrive}"
                                Value="True"/>
                        <Condition Binding="{Binding IsDirectory}"
                                Value="True"/>
                        <Condition Binding="{Binding Visibility, ElementName=RowIcon}"
                                Value="Visible"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="NetworkBadge"
                            Property="Visibility"
                            Value="Visible"/>
                    <Setter TargetName="NetworkBadge"
                            Property="Fill"
                            Value="{DynamicResource PlaceBadgeCloudBrush}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsDirectory}"
                        Value="False">
                    <Setter TargetName="RowIcon"
                            Property="Visibility"
                            Value="{DynamicResource FileIconVisibility}"/>
                    <Setter TargetName="RowIcon"
                            Property="Margin"
                            Value="{DynamicResource FileRowIconMargin}"/>
                    <!-- Only actually non-zero when file icons are off and
                         folder icons are on (see ApplyIconMetrics) - the one
                         case where RowIcon is Collapsed and can't carry the
                         guide-line alignment shift itself, so the name/edit
                         box take it instead. -->
                    <Setter TargetName="NameText"
                            Property="Margin"
                            Value="{DynamicResource FileNameMargin}"/>
                    <Setter TargetName="NameEditBox"
                            Property="Margin"
                            Value="{DynamicResource FileNameMargin}"/>
                    <Setter TargetName="NameText"
                            Property="FontWeight"
                            Value="{DynamicResource FileNameFontWeight}"/>
                </DataTrigger>
                <!-- File rows get their own text color instead of inheriting
                     ForegroundText/HighlightForeground from the TreeViewItem
                     (which folder rows still do, unchanged) - the split this
                     came from (see AppSettings.FileNameColorHex). Declared
                     normal -> hover -> selected, so a later trigger's Setter
                     overrides an earlier one's when more than one applies at
                     once (selected+hovered ends up selected-colored) - same
                     precedent as the folder-row triggers above. -->
                <DataTrigger Binding="{Binding IsDirectory}"
                        Value="False">
                    <Setter TargetName="NameText"
                            Property="Foreground"
                            Value="{DynamicResource FileNameForeground}"/>
                </DataTrigger>
                <!-- AncestorType=Border (not TreeViewItem.IsMouseOver, which
                     would read the whole subtree - see the folder-row hover
                     trigger's own comment above for why) resolves to
                     RowBorder, the nearest Border ancestor of NameText in the
                     visual tree even though RowBorder lives in a different
                     template (the TreeViewItem's ControlTemplate, not this
                     HierarchicalDataTemplate) - ElementName/SourceName can't
                     cross that template boundary, but a visual-tree,
                     type-based RelativeSource lookup doesn't need to. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDirectory}"
                                Value="False"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
                                Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="NameText"
                            Property="Foreground"
                            Value="{DynamicResource FileNameHoverForeground}"/>
                </MultiDataTrigger>
                <!-- Multi-selected file rows get the same highlighted text color as
                     the natively-selected one (folder rows inherit it from the
                     TreeViewItem style's own IsMultiSelected trigger instead). -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDirectory}"
                                Value="False"/>
                        <Condition Binding="{Binding IsMultiSelected}"
                                Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="NameText"
                            Property="Foreground"
                            Value="{DynamicResource FileNameHighlightForeground}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsDirectory}"
                                Value="False"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="NameText"
                            Property="Foreground"
                            Value="{DynamicResource FileNameHighlightForeground}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsRoot}"
                        Value="True">
                    <Setter TargetName="NameText"
                            Property="FontWeight"
                            Value="Bold"/>
                </DataTrigger>
                <!-- Waiting on a Ctrl+X paste: the icon fades and the name goes
                     quiet - the row's own colour taken towards the background,
                     not an Opacity (the app doesn't say things by fading text,
                     and over an unknown background a fade is a different colour
                     every time). The icon alone was not enough: it leaves the
                     mark invisible to anyone running with icons off, which is a
                     supported way to use the tree (2026-07-28).
                     It used to go ITALIC too, which is now what "hidden but
                     shown" means (see below). Two states that both quiet the
                     name needed the second signal to differ, so the line is
                     drawn here: italic = hidden, faded icon = cut
                     (2026-08-02, with the user).
                     Split folder/file because the muted colour is derived from
                     whichever colour that row would normally use.
                     Deliberately above the offline trigger below, which sets
                     the same Opacity - a row on a sleeping drive should read
                     as switched off first, and the last matching trigger wins. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsCut}" Value="True"/>
                        <Condition Binding="{Binding IsDirectory}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="RowIcon"
                            Property="Opacity"
                            Value="0.4"/>
                    <Setter TargetName="NameText"
                            Property="Foreground"
                            Value="{DynamicResource MutedFolderNameForeground}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsCut}" Value="True"/>
                        <Condition Binding="{Binding IsDirectory}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="RowIcon"
                            Property="Opacity"
                            Value="0.4"/>
                    <Setter TargetName="NameText"
                            Property="Foreground"
                            Value="{DynamicResource MutedFileNameForeground}"/>
                </MultiDataTrigger>
                <!-- A hidden folder on screen anyway - a jump passing through
                     it, or "숨긴 폴더 표시" being on. Italic name, in the user's
                     own folder colour taken a step towards the background
                     (HiddenFolderNameForeground, derived in ApplyUserColors),
                     so it never reads as a folder that simply came back: it is
                     here on purpose and only for now.
                     A translucent row backdrop was built first and dropped -
                     over a dark background it read as a bright rim around the
                     row rather than as a dent (2026-08-02).
                     The ICON is deliberately left alone: a faded icon is what
                     cut means, and these two states have to stay tellable
                     apart at a glance.
                     Above the offline trigger below, which owns the "this row
                     is not live" look outright; the last matching trigger
                     wins. -->
                <DataTrigger Binding="{Binding IsHiddenFolderShown}"
                        Value="True">
                    <Setter TargetName="NameText"
                            Property="FontStyle"
                            Value="Italic"/>
                    <Setter TargetName="NameText"
                            Property="Foreground"
                            Value="{DynamicResource MutedFolderNameForeground}"/>
                </DataTrigger>
                <!-- Drive not answering: red dot, and the row greyed out.
                     LAST on purpose - every folder/file/selection colour above
                     targets the same Foreground, and the last matching trigger
                     is the one that wins, so anywhere earlier and file names
                     simply stayed their normal colour (2026-07-26: "파일은
                     여전히 밝음, 아이콘만 어두워짐").
                     What stays on screen while a drive is out is a listing
                     from before it went away: worth keeping (it says where you
                     were) but it must not read as live, and the subtree is
                     collapsed and inert until the drive answers again (see
                     ApplyNetworkOfflineState). The dot goes grey with
                     everything else rather than red: the whole row already
                     reads as switched off, and a warning colour on top of that
                     is louder than the situation - a NAS being asleep is
                     normal, not an error (2026-07-26). -->
                <DataTrigger Binding="{Binding IsNetworkDriveOffline}"
                        Value="True">
                    <Setter TargetName="NetworkBadge"
                            Property="Fill"
                            Value="{DynamicResource PlaceBadgeOfflineBrush}"/>
                    <Setter TargetName="RowIcon"
                            Property="Opacity"
                            Value="0.5"/>
                    <Setter TargetName="NameText"
                            Property="Foreground"
                            Value="#FF8C9196"/>
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <ContextMenu x:Key="BookmarkPanelItemContextMenu"
                Style="{StaticResource DarkContextMenuStyle}"
                Opened="AnyMenu_Opened"
                Closed="AnyMenu_Closed"
                PreviewMouseRightButtonUp="ContextMenu_PreviewMouseRightButtonUp">
            <!-- ONLY ON A ROW THAT IS ACTUALLY HIDDEN, which is why it and its
                 separator carry the same trigger: an action that is always
                 there but only sometimes does anything is worse than one that
                 appears when it applies. It sits at the top because it is the
                 answer to the question the muted row just raised.
                 The ContextMenu takes its DataContext from the row it opened
                 on, so IsHiddenFolder binds straight through. -->
            <MenuItem Header="{x:Static services:Strings.MenuUnhideFolder}"
                    Click="UnhideBookmarkFolder_Click">
                <MenuItem.Style>
                    <Style TargetType="MenuItem"
                            BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Visibility"
                                Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHiddenFolder}"
                                    Value="True">
                                <Setter Property="Visibility"
                                        Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator>
                <Separator.Style>
                    <!-- BasedOn the SeparatorStyleKey style, not a bare
                         Separator style. A separator inside a menu is styled
                         through that key rather than by TargetType, so a local
                         style without it drops the template and the default
                         two-tone groove comes back as a bright line (the note
                         at that style says the same from the other side). -->
                    <Style TargetType="Separator"
                            BasedOn="{StaticResource {x:Static MenuItem.SeparatorStyleKey}}">
                        <Setter Property="Visibility"
                                Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHiddenFolder}"
                                    Value="True">
                                <Setter Property="Visibility"
                                        Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Separator.Style>
            </Separator>
            <MenuItem Header="{x:Static services:Strings.MenuBookmarkRemove}"
                    Click="RemoveBookmarkFromPanel_Click"/>
            <!-- The favorites row's twin carries 전체 해제, so this one does
                 too. Bookmarks already had the action by two other routes (the
                 options menu and the tree's 북마크 submenu) - what they did not
                 have is it HERE, in the panel the rows are actually in, which
                 is where someone looking at the list reaches for it. -->
            <Separator/>
            <MenuItem Header="{x:Static services:Strings.MenuBookmarkClearAll}"
                    Click="ClearAllBookmarks_Click"/>
        </ContextMenu>

        <!-- The favorites row's twin, for when the panel is showing bookmarks
             (AppSettings.SidePanelMode). Kept as its OWN style rather than
             teaching the favorites one to serve both: the favorites row is
             folder-only, drag-reorderable and bound straight to the stored
             entries, and every one of those is different here. The metrics are
             shared through the same resources, so both still line up with the
             tree rows underneath.

             Two things it has that the favorites row does not: a number, and a
             marker for where the Ctrl+Alt+L/J cycle is standing. -->
        <Style x:Key="BookmarkPanelItemStyle"
                TargetType="ListBoxItem">
            <Setter Property="Padding"
                    Value="{DynamicResource RowPadding}"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="ContextMenu"
                    Value="{StaticResource BookmarkPanelItemContextMenu}"/>
            <EventSetter Event="PreviewMouseRightButtonDown"
                    Handler="BookmarkPanelItem_PreviewMouseRightButtonDown"/>
            <!-- Same reasoning as the favorites tooltip: a flat list of leaf
                 names, where several rows can read identically. -->
            <Setter Property="ToolTipService.InitialShowDelay"
                    Value="{StaticResource TooltipShowDelay}"/>
            <Setter Property="ToolTipService.ShowDuration"
                    Value="20000"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip Content="{Binding Path}"
                            FontSize="{Binding PlacementTarget.FontSize, RelativeSource={RelativeSource Self}}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Just the marker and a hair of air after
                                         it, NOT the tree's full indent
                                         stand-in: the number column is already
                                         width this row's favorites twin does
                                         not spend, and starting the content
                                         further in on top of that pushed it
                                         visibly away from the marker
                                         (2026-08-02). -->
                                    <ColumnDefinition Width="{DynamicResource PanelMarkerColumnWidth}"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Where Ctrl+Alt+L/J is standing right now.
                                     Same blue as the ribbon marker the tree
                                     draws on a bookmarked row, so the two read
                                     as one feature. A bar rather than a
                                     background because selection already owns
                                     the row background, and the two answer
                                     different questions - what you last
                                     clicked, versus where the cycle is. -->
                                <Border x:Name="CycleMarker"
                                        Grid.Column="0"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        Background="#FF4A90E2"
                                        Visibility="Hidden"/>

                                <!-- Counted from the top, so it is also how many
                                     presses away the row is. A smaller font
                                     rather than a faded one - dimming text to
                                     mark it as secondary is not done in this
                                     app.
                                     AND IT TAKES THE FOLDER NAME'S COLOUR, not
                                     the 더 보기 row's, which is what it used to
                                     borrow. That colour is the user's and it is
                                     one people deliberately push DOWN - it
                                     marks a row that is only signage. The
                                     number is not signage: it is the key you
                                     press, on a font already the smallest in
                                     the panel, and it went unreadable the
                                     moment those rows were darkened
                                     (2026-08-26, on report). Borrowing a colour
                                     chosen to be quiet is only safe where being
                                     quiet is the point. -->
                                <TextBlock x:Name="BookmarkNumberText"
                                        Grid.Column="1"
                                        Text="{Binding Number}"
                                        FontSize="{DynamicResource PanelNumberFontSize}"
                                        MinWidth="{DynamicResource PanelNumberWidth}"
                                        TextAlignment="Right"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center">
                                    <!-- THE NAME'S COLOUR, all four states of
                                         it, because the number rides the same
                                         row and has to stay readable on the
                                         same grounds: base, filtered, hover,
                                         selected. Following only the base would
                                         leave it to be read against a selection
                                         background the name had already moved
                                         off. The trigger order and the
                                         FindAncestor form are the name's own,
                                         a few lines down - one shape for the
                                         row rather than two that can drift.

                                         The filtered state was the author's
                                         call (2026-09-05) and it is the one
                                         place this row's rule bends: a number
                                         is a key you press, and the note above
                                         this TextBlock says not to dim it. What made that a
                                         problem in 2026-08-26 was the number
                                         borrowing a colour chosen to be quiet
                                         for a WHOLE CLASS of rows; this one is
                                         a single row saying its target is not
                                         in the tree right now, and leaving the
                                         number bright made the row read as
                                         half-muted rather than muted. The digit
                                         stays, so the press count is still
                                         there to read. -->
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource PanelNameForeground}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOutOfTree}"
                                                        Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource MutedPanelNameForeground}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                        Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource PanelNameHoverForeground}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                        Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource PanelNameHighlightForeground}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Image x:Name="BookmarkRowIcon"
                                        Grid.Column="2"
                                        Source="{Binding Icon}"
                                        Width="{DynamicResource IconSize}"
                                        Height="{DynamicResource IconSize}"
                                        Margin="{DynamicResource FolderRowIconMargin}"
                                        VerticalAlignment="Center"
                                        RenderOptions.BitmapScalingMode="HighQuality"/>

                                <TextBlock x:Name="BookmarkNameText"
                                        Grid.Column="3"
                                        Text="{Binding Name}"
                                        FontWeight="{DynamicResource FolderNameFontWeight}"
                                        VerticalAlignment="Center"
                                        LineHeight="{DynamicResource RowLineHeight}"
                                        LineStackingStrategy="BlockLineHeight"
                                        TextTrimming="CharacterEllipsis">
                                    <!-- The name's COLOUR is decided here, on
                                         the element itself, rather than in the
                                         template's triggers below. It depends
                                         on the row's state and on what the row
                                         holds at once, and only a binding that
                                         starts from an element can reach the
                                         row: a Condition in
                                         ControlTemplate.Triggers has nothing to
                                         walk up from, and the TemplatedParent
                                         form of it simply never fires - which
                                         looks exactly like a colour nobody
                                         wired, since a trigger that cannot bind
                                         fails in silence (2026-08-04).
                                         From here, FindAncestor reaches the
                                         ListBoxItem the same way every other
                                         binding in this template reaches its
                                         data. Order is base, then file, then
                                         hover, then selection: the last match
                                         wins, so a selected row keeps its
                                         colour while the pointer crosses it. -->
                                    <!-- ONE COLOUR FOR THE WHOLE PANEL, folder or
                                         file (2026-08-17). The five states here
                                         used to be the folder/file pair at each
                                         of the three roles, because the panel
                                         was drawing the TREE's brushes and the
                                         tree splits that way. Now that the panel
                                         has three rows of its own, the split
                                         costs six palette rows to say what the
                                         row's ICON already says - and what the
                                         three rows are for is telling this list
                                         apart from the tree under it, which a
                                         bookmarked FILE still reading as a tree
                                         file would half undo. FontWeight keeps
                                         the split: 폴더만 굵게 is about folder
                                         names as such. -->
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource PanelNameForeground}"/>
                                            <Style.Triggers>
                                                <!-- FIRST of the three, so hover
                                                     and selection below still
                                                     win on it: a muted row is
                                                     still a row you can point
                                                     at and click, and the two
                                                     answers must not fight. It
                                                     says the tree is not
                                                     showing this row's target
                                                     as it stands - filtered
                                                     file or excluded folder;
                                                     see BookmarkPanelRow.
                                                     IsOutOfTree for what each
                                                     costs the click. Colour
                                                     only, no italic: italic
                                                     already means "hidden
                                                     folder, shown for now" in
                                                     the tree, and two states
                                                     wearing one mark is how
                                                     both stop being read. -->
                                                <DataTrigger Binding="{Binding IsOutOfTree}"
                                                        Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource MutedPanelNameForeground}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                        Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource PanelNameHoverForeground}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                        Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource PanelNameHighlightForeground}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Weight only. The colour moved to the element's
                                 own style (see BookmarkNameText above) and must
                                 not also be set from here: a template trigger
                                 outranks a style trigger, so leaving this in
                                 would pin the file colour on and the hover and
                                 selection colours would never show. -->
                            <DataTrigger Binding="{Binding IsDirectory}"
                                    Value="False">
                                <Setter TargetName="BookmarkNameText"
                                        Property="FontWeight"
                                        Value="{DynamicResource FileNameFontWeight}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}"
                                    Value="True">
                                <Setter TargetName="CycleMarker"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </DataTrigger>
                            <!-- Icons turned off: the SLOT goes with the icon,
                                 same as the tree, so the names keep their
                                 column instead of sitting behind an empty gap.
                                 A null Source is how the row says so. -->
                            <DataTrigger Binding="{Binding Icon}"
                                    Value="{x:Null}">
                                <Setter TargetName="BookmarkRowIcon"
                                        Property="Visibility"
                                        Value="Collapsed"/>
                            </DataTrigger>
                            <!-- The icon joins the name and the number, so the
                                 whole row reads as one state instead of a muted
                                 name beside a bright picture. Same 0.4 the tree
                                 fades a cut row's icon with.
                                 THE TREE DELIBERATELY DOES NOT DO THIS (see the
                                 hidden-folder trigger up in the tree template:
                                 a faded icon there means CUT, and two states
                                 wearing one mark stop being tellable apart).
                                 It is safe HERE because this panel has no cut
                                 state at all - BookmarkPanelRow carries an
                                 icon, a kind, the cycle mark and this flag, and
                                 nothing in the panel ever marks a cut. If a cut
                                 mark is ever added to these rows, this fade is
                                 the thing it collides with. -->
                            <DataTrigger Binding="{Binding IsOutOfTree}"
                                    Value="True">
                                <Setter TargetName="BookmarkRowIcon"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </DataTrigger>
                            <!-- No matching IsDirectory=True trigger: the folder
                                 colour is already the setter above, and in WPF
                                 the LAST matching trigger wins - a redundant
                                 pair here is exactly how the NAS greying lost
                                 to the file/folder colours in July. -->
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowSelectedActiveBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- FavoritesList otherwise falls back to the default ListBox chrome
             (stock Windows scrollbar) since it only had ItemContainerStyle set;
             reusing MinimalScrollViewerTemplate here matches the tree below. -->
        <Style x:Key="FavoritesListBoxStyle"
                TargetType="ListBox">
            <!-- The default the template binding below reads. WITHOUT this
                 setter the attached property's own default applies, and that
                 is FALSE - not True, as the first cut of the binding assumed
                 ("ListBox's default") - so every list wearing this style
                 silently switched to pixel scrolling, and the favorites-panel
                 height math, which states outright that it is built on
                 item-based scrolling, met a list that no longer was (blank row
                 under the last bookmark on selecting it, 2026-08-14). The
                 style hands back the item-unit default; the two history
                 popups opt out locally, which is the whole point of routing
                 it through a binding. -->
            <Setter Property="ScrollViewer.CanContentScroll"
                    Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <!-- CanContentScroll was hardcoded True here. Item-unit
                                 scrolling stays the default - via the style's own
                                 setter above, NOT the attached property's default,
                                 which is False (assuming otherwise cost a blank row
                                 under the bookmark panel's last row, 2026-08-14) -
                                 but it also leaves the last row half-shown, and a
                                 click on a half-shown row is spent SCROLLING it
                                 into view instead of picking it. A short list with
                                 tall rows would rather have pixels, so the choice
                                 is the list's to make. Read the same way as the two
                                 scrollbar properties: TemplateBinding does not
                                 reach an attached property. -->
                            <!-- FIVE lists wear this style - the favorites and
                                 bookmark panels, the two history dropdowns and
                                 the search results - and the edge shades below
                                 are declared for all of them but LIT for none.
                                 The only thing that raises them is
                                 AttachEdgeShades, and the only callers are the
                                 two panels. Same arrangement the "more this
                                 way" chevrons in MinimalScrollViewerTemplate
                                 already use, and for the same reason: one
                                 template beats a duplicate of it per list.
                                 Thinner than the tree's (2026-08-15): this
                                 panel is a few rows tall, so the tree's depth
                                 here would shade most of the list. -->
                            <Grid>
                                <ScrollViewer x:Name="PART_PanelScrollViewer"
                                        Focusable="False"
                                        Padding="{TemplateBinding Padding}"
                                        Template="{StaticResource MinimalScrollViewerTemplate}"
                                        CanContentScroll="{Binding Path=(ScrollViewer.CanContentScroll), RelativeSource={RelativeSource TemplatedParent}}"
                                        HorizontalScrollBarVisibility="{Binding Path=(ScrollViewer.HorizontalScrollBarVisibility), RelativeSource={RelativeSource TemplatedParent}}"
                                        VerticalScrollBarVisibility="{Binding Path=(ScrollViewer.VerticalScrollBarVisibility), RelativeSource={RelativeSource TemplatedParent}}">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                                <Border x:Name="PanelTopShade"
                                        VerticalAlignment="Top"
                                        IsHitTestVisible="False"
                                        Opacity="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0"
                                                EndPoint="0,1">
                                            <GradientStop Offset="0"
                                                    Color="#48000000"/>
                                            <GradientStop Offset="0.5"
                                                    Color="#26000000"/>
                                            <GradientStop Offset="1"
                                                    Color="#00000000"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border x:Name="PanelBottomShade"
                                        VerticalAlignment="Bottom"
                                        IsHitTestVisible="False"
                                        Opacity="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,1"
                                                EndPoint="0,0">
                                            <GradientStop Offset="0"
                                                    Color="#48000000"/>
                                            <GradientStop Offset="0.5"
                                                    Color="#26000000"/>
                                            <GradientStop Offset="1"
                                                    Color="#00000000"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search result rows (the two-line "folder path over filename" entries
             in the Ctrl+F search view). Own hover/selection highlight and the
             bottom margin that spaces one result from the next, since the
             default ListBoxItem chrome would clash with the rest of the app's
             hand-themed look. -->
        <Style x:Key="SearchResultItemStyle"
                TargetType="ListBoxItem">
            <Setter Property="Padding"
                    Value="{DynamicResource SearchRowPadding}"/>
            <Setter Property="Margin"
                    Value="0,0,0,3"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="ContextMenu"
                    Value="{StaticResource SearchResultContextMenu}"/>
            <!-- Same hover contract as the tree rows and the panel lists: the
                 delay is long enough that brushing past on the way somewhere
                 else pops nothing up, and the font follows the placement target
                 because a tooltip is its own window and inherits nothing. The
                 surface itself comes from the implicit ToolTip style. -->
            <Setter Property="ToolTipService.InitialShowDelay"
                    Value="{StaticResource TooltipShowDelay}"/>
            <Setter Property="ToolTipService.ShowDuration"
                    Value="20000"/>
            <Setter Property="ToolTip">
                <Setter.Value>
                    <ToolTip Content="{Binding TooltipPath}"
                            FontSize="{Binding PlacementTarget.FontSize, RelativeSource={RelativeSource Self}}"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <!-- Another result is the same file
                                 (SearchRow.IsDuplicate, 2026-10-06): a faint
                                 band in the file name's own
                                 colour, so it lightens a row on a dark palette
                                 and darkens it on a light one with no brush of
                                 its own to keep per theme. UNDER the row's
                                 border, so hover, selection and marks paint
                                 over it. Two strengths: the first row of each
                                 set of copies is the stronger one
                                 (SearchRow.DuplicateOpacity). -->
                            <Border Background="{DynamicResource FileNameForeground}"
                                    Opacity="{Binding DuplicateOpacity}"
                                    CornerRadius="3"
                                    Visibility="{Binding DuplicateVisibility}"/>
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <!-- A file marked from the thumbnail list
                                         (SearchRow.IsMarked, 2026-10-06): the
                                         selection's own brush, as the tree
                                         paints its multi-selected rows. A layer
                                         over the hover colour rather than a
                                         trigger, so the mark wins over hover
                                         the way it does in the tree, and bound
                                         to a plain value - see
                                         SearchRow.CutOpacity for why this
                                         template does not repaint from
                                         triggers. The padding moved onto the
                                         content so the layer fills the whole
                                         row. -->
                                    <Border Background="{DynamicResource TreeRowSelectedActiveBackground}"
                                            CornerRadius="3"
                                            Visibility="{Binding MarkVisibility}"/>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource TreeRowSelectedActiveBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- The synthetic "… 더 보기 (N개)" row stands for no path at
                     all, so it gets no tooltip - a blank one popping up over it
                     would read as a fault. -->
                <DataTrigger Binding="{Binding IsShowMore}"
                        Value="True">
                    <Setter Property="ToolTipService.IsEnabled"
                            Value="False"/>
                </DataTrigger>
                <!-- Folder header rows were LABELS, NOT TARGETS until 2026-08-31
                     - no hit test, no focus, arrow cursor - and a click landed
                     through to nothing. Reversed on request: the header now
                     jumps the tree to its folder (see ActivateSearchFolder), so
                     it takes the hand cursor, the hit test and keyboard focus
                     like any row. What it does NOT take is the file menu the
                     container style hangs on every item: a header has no Entry,
                     so that menu over it would be all live-looking rows acting
                     on nothing - the exact shape v2.5.4 fixed in the tree. -->
                <DataTrigger Binding="{Binding IsHeader}"
                        Value="True">
                    <Setter Property="ContextMenu"
                            Value="{x:Null}"/>
                    <Setter Property="Margin"
                            Value="0,3,0,0"/>
                    <Setter Property="Padding"
                            Value="8,2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Rows in a dropdown Popup: recent searches under the search box, and
             the folders you have been in above the path bar.
             THE HOVER IS THE MENU'S, NOT THE DIALOG'S. These lists sit on
             PanelBackground (#282828) and HoverBackground is #2A2D2E - two
             points apart, so the row under the pointer looked unhighlighted.
             That is the same trap MenuHighlightBackground was created for; see
             its note in App.xaml. -->
        <Style x:Key="PopupListItemStyle"
                TargetType="ListBoxItem">
            <Setter Property="Padding"
                    Value="8,4"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource MenuHighlightBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Single cell, not a content-column + dedicated resize-grip-column split:
         a reserved "6" column stayed 6px wide even while docked with the grip
         sitting idle (Background="Transparent" at rest - see ResizeThumbStyle),
         so the sidebar's real content never reached the window's true right
         edge. The Thumb below now overlays the content instead, the same fix
         already applied to the scrollbars for the same reason. -->
    <Grid x:Name="RootContent">
        <!-- The auto-hide peek slides by moving THIS, not the window. A window
             positioned off the screen edge is not drawn out there, so sliding
             one in makes Windows hand the app a freshly exposed strip to paint
             on every frame - which is what showed up as an unfinished, smearing
             sidebar (2026-08-05). Translating content inside a window that is
             already fully on screen is a composition-thread matrix change: the
             tree is rendered once and then simply shown at a different offset.
             See MainWindow.SlideContentTo. -->
        <Grid.RenderTransform>
            <TranslateTransform x:Name="ContentSlide"/>
        </Grid.RenderTransform>
        <Grid Background="{DynamicResource SidebarBackground}">
            <!-- Three columns for the image viewer panel: the sidebar content
                 lives in the middle column, and the two outer columns are
                 where the viewer opens - right column normally, LEFT column
                 when docked on the screen's right edge, so the panel always
                 grows toward the screen's interior and the tree stays put at
                 the edge (see OpenViewer). Both stay 0 while the viewer is
                 closed, so this grid measures exactly as the original
                 single-column layout did - which is why the tree is declared
                 STAR here.
                 While the viewer is OPEN the roles invert: the tree takes a
                 fixed width and the open panel becomes the star column. See
                 SetViewerColumns, which owns every write to these three and
                 explains why. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ViewerColumnLeft"
                        Width="0"/>
                <ColumnDefinition x:Name="TreeColumn"
                        Width="*"/>
                <ColumnDefinition x:Name="ViewerColumnRight"
                        Width="0"/>
            </Grid.ColumnDefinitions>
            <!-- RowUpper/RowLower name WHERE THEY ARE, never what they hold. Which
                 one carries the bookmark panel and which the tree depends on the
                 "즐겨찾기를 아래에 표시" option (see ApplyFavoritesPosition in the
                 code-behind), which swaps both the Grid.Row of the two children
                 AND which RowDefinition gets the content-fit-height treatment
                 against Height="*". MainWindow.xaml.cs's FavoritesRowDef and
                 TreeRowDef are the single source of truth for which is which at
                 any moment; FavoritesSplitterRow always sits between them and
                 never moves.

                 THEY WERE Row1 AND Row3 UNTIL 2026-08-30, and that is precisely
                 why they were renamed: a name that is a POSITION NUMBER is a
                 lie the moment a row is inserted above it, and one was. The
                 numbers had been chosen as the neutral option, which held only
                 while the grid never grew. Position words survive the next
                 insertion; ordinals do not. -->
            <Grid.RowDefinitions>
                <!-- Fixed, not Auto - so hiding the header alone leaves the row
                     behind as a 36px band of background at the top of the
                     window. The viewer's full cover zeroes this height itself
                     (SetViewerFullscreen) and puts it back on the way out. -->
                <!-- Follows Ctrl +/- within bounds - see HeaderHeight in
                     MainWindow.xaml.cs for the range and why it is clamped
                     rather than proportional. The value here is the default
                     font's, held until ApplyLayoutMetrics first runs. -->
                <RowDefinition x:Name="HeaderRow"
                        Height="{DynamicResource HeaderRowHeight}"/>
                <!-- 경로 표시줄 위에 표시: zero unless that option is on, which is
                     what lets every child below keep ONE set of row numbers. The
                     alternative was moving children between rows as the option
                     changed, and this grid has thirteen of them - see
                     PlacePathBar in the code-behind for the seat it feeds. -->
                <RowDefinition x:Name="PathBarTopRow"
                        Height="0"/>
                <RowDefinition x:Name="RowUpper"
                        Height="0"/>
                <RowDefinition x:Name="FavoritesSplitterRow"
                        Height="0"/>
                <RowDefinition x:Name="RowLower"
                        Height="*"/>
                <!-- Auto, not the fixed 20 it was: the footer carries the file
                     -kind toggles now, and on a narrow window they wrap to a
                     second line. A fixed height would cut that line off. -->
                <RowDefinition x:Name="VersionFooterRow"
                        Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header. Also doubles as the drag handle: while docked, dragging it
                 past the system drag threshold detaches the window into a free-
                 floating one (see HeaderGrid_MouseMove); once floating, WindowChrome's
                 CaptionHeight takes over native dragging on this same area. -->
            <!-- IsHitTestVisibleInChrome matters here specifically because of
                 CaptionHeight: while docked it's 0 (the whole window is already
                 plain client area, so this has no effect), but once floating
                 WindowChrome sets CaptionHeight to HeaderHeight and, without this,
                 treats this whole Grid as native OS caption territory - meaning
                 clicks here (everywhere except the buttons below, which already
                 had this set individually) never reached our own MouseLeftButtonDown
                 handler at all. They fell straight through to Windows' own default
                 caption handling instead, which explains why double-clicking here
                 while floating maximized the window instead of running our
                 dock-toggle logic (see HeaderGrid_MouseLeftButtonDown) - and why,
                 had this masked drag behavior ever actually needed exercising while
                 already floating, it would have used native OS move-window
                 dragging rather than our own DragMove() call below. -->
            <Grid x:Name="HeaderGrid"
                    Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Background="{DynamicResource HeaderBackground}"
                    MouseLeftButtonDown="HeaderGrid_MouseLeftButtonDown"
                    MouseMove="HeaderGrid_MouseMove"
                    MouseLeftButtonUp="HeaderGrid_MouseLeftButtonUp"
                    ContextMenu="{StaticResource HeaderContextMenu}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- The strip the six header buttons sit in is not a drag
