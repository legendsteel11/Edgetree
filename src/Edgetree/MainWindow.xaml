                                <Path x:Name="FooterNowPlayingPauseIcon"
                                        Data="M528-192v-576h240v576H528Zm-336 0v-576h240v576H192Zm408-72h96v-432h-96v432Zm-336 0h96v-432h-96v432Zm0-432v432-432Zm336 0v432-432Z"
                                        Stretch="Uniform"
                                        Width="{DynamicResource ViewerChipIconSize}"
                                        Height="{DynamicResource ViewerChipIconSize}"
                                        Fill="{Binding Foreground,
                                            RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Grid>
                        </Button>
                        <Button x:Name="FooterNowPlayingStop"
                                Grid.Column="4"
                                Style="{StaticResource FooterNowPlayingChipStyle}"
                                Click="FooterNowPlayingStop_Click"
                                ToolTip="{x:Static services:Strings.ViewerStop}">
                            <Path Data="M336-624v288-288Zm-72 360v-432h432v432H264Zm72-72h288v-288H336v288Z"
                                    Stretch="Uniform"
                                    Width="{DynamicResource ViewerChipIconSize}"
