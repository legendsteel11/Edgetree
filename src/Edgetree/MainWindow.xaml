                                        MouseWheel="ViewerMediaVolume_MouseWheel"
                                        Width="80"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="0.6"
                                        VerticalAlignment="Center"
                                        PreviewMouseLeftButtonDown="ViewerMediaVolume_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="ViewerMediaVolume_PreviewMouseMove"
                                        PreviewMouseLeftButtonUp="ViewerMediaVolume_PreviewMouseLeftButtonUp"
                                        ValueChanged="ViewerMediaVolume_ValueChanged"/>
                                <!-- 트리에서 보기 AND 기본 프로그램에서 열기 BOTH
                                     LEFT THIS ROW (2026-08-16). They were the
                                     first two out of the drop order because
                                     they are the two that leave the row for
                                     somewhere else - and being first out is a
                                     fair description of how little the row
                                     needed them. The jump is the one worth
                                     keeping and it now has a better address:
                                     beside the name of the track it jumps to,
                                     where the question is actually asked (see
                                     ViewerNowPlayingJump). The row that is left
                                     is transport and nothing else.

                                     기본 프로그램에서 열기 is in the picture's own
                                     right-click menu and on Enter from the
                                     tree. -->
                            </StackPanel>
                        </StackPanel>
                        </Grid>
                        </Border>
                    </StackPanel>
                    <!-- The panel's own close X used to sit here, top-right.
                         It was directly under the WINDOW's close X and drawn
                         at a different size, so the corner offered two X's
                         that did different things and neither said which
                         (reported with a screenshot, 2026-08-10). Closing the
                         panel already had two controls that say what they
                         close - the collapse chevron on the divider, which
                         points at the thing it folds, and the header's viewer
                         toggle, which is the same switch that opened it. An X
                         is the one shape in that corner that means "the
                         window", so this one was the odd one out rather than
                         the extra one. -->
                </Grid>
            </Border>

            <!-- The tree/viewer divider's grab zone: dragging it re-splits the
                 CURRENT window between tree and panel - no window geometry at
                 all, unlike the outer-edge ResizeThumb. Straddles the divider
                 line by 4px on each side (same negative-margin trick as
                 FavoritesSplitter); OpenViewer moves it to whichever column
                 the panel took and flips its edge/margins. -->
            <Thumb x:Name="ViewerSplitThumb"
                    Grid.Row="1"
                    Grid.RowSpan="5"
                    Grid.Column="2"
                    Width="8"
                    Margin="-4,0,0,0"
                    HorizontalAlignment="Left"
                    Panel.ZIndex="2"
                    Style="{StaticResource ResizeThumbStyle}"
                    Cursor="SizeWE"
                    Visibility="Collapsed"
                    DragDelta="ViewerSplitThumb_DragDelta"
                    DragCompleted="ViewerSplitThumb_DragCompleted"/>

            <!-- Closes the viewer, from the divider rather than the window's
                 far corner. Above the grab zone in ZIndex so its own clicks
                 land, which costs the drag this much of the divider's height -
                 the same trade every splitter with a collapse button makes,
                 and the rest of the line still drags.
                 The chevron always points AT THE TREE, which is also the
                 direction the window's edge actually travels when the panel
                 closes; ApplyViewerSide flips it with the panel's side. It
                 sits over the panel's 10px image margin, not over the picture,
                 so it can wear theme brushes like everything else. -->
            <Button x:Name="ViewerCollapseButton"
                    Grid.Row="1"
                    Grid.RowSpan="5"
                    Grid.Column="2"
                    Width="14"
                    Height="40"
                    Margin="-7,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Panel.ZIndex="3"
                    Visibility="Collapsed"
                    Style="{StaticResource ViewerCollapseButtonStyle}"
                    Click="ViewerCollapseButton_Click"
                    ToolTip="{x:Static services:Strings.ViewerClose}">
                <!-- Material Symbols "chevron_left" - the carousel's own
                     previous/next mark, brought here (2026-08-10) after
                     arrow_menu_close was tried and dropped: its vertical bar
                     ran parallel to the divider a few pixels away, and at the
                     size this lane allows it was both small and clipped.

                     THE ONE PLACE IN THE APP THAT DOES NOT CARRY THE 960 BOX,
                     and the reason is this lane. A chevron fills only 291 of
                     the box's 960, so with the box its ink is 30% of whatever
                     the Path element measures - and the element cannot exceed
                     the 14px plate without being cut off. Ink of 16 would need
                     a box of 32 and therefore a plate of 32, on a divider. The
                     box exists to keep icons that sit TOGETHER in a row at the
                     family's relative sizes; this one sits alone, one at a
                     time, so fitting its own bounds costs nothing and buys the
                     size the lane actually has room for.

                     It takes ViewerChipIconSize - the CAROUSEL's number, not a
                     new one - because it is the carousel's mark, and the two
                     were asked to match (2026-08-10); sharing the resource
                     is what keeps them matching through Ctrl +/- rather than
                     just today. Ink lands at 6.7 x 11 in a 14 x 40 plate.

                     Mirrored by ScaleX when the panel sits on the left, so the
                     two directions cannot drift apart. -->
                <Path x:Name="ViewerCollapseGlyph"
                        Data="M576-240 336-480l240-240 51 51-189 189 189 189-51 51Z"
                        Fill="{DynamicResource ForegroundText}"
                        Stretch="Uniform"
                        Width="{DynamicResource ViewerChipIconSize}"
                        Height="{DynamicResource ViewerChipIconSize}"
                        RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <ScaleTransform x:Name="ViewerCollapseGlyphFlip"
                                ScaleX="1"/>
                    </Path.RenderTransform>
                </Path>
            </Button>

            <!-- The same chevron the other way round: with the panel closed and
                 an IMAGE row selected, it opens the viewer from the tree's own
                 edge instead of the header button. Only under those two
                 conditions, which is what keeps it from becoming a permanent
                 fixture on the edge it shares with the tree's scrollbar and
                 (docked) the width grip - see UpdateViewerExpandButton. It
                 points the way the panel will come from. -->
            <Button x:Name="ViewerExpandButton"
                    Grid.Row="2"
                    Grid.RowSpan="4"
                    Grid.Column="1"
                    Width="14"
                    Height="40"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Panel.ZIndex="3"
                    Visibility="Collapsed"
                    Background="{DynamicResource SidebarBackground}"
                    Style="{StaticResource ViewerCollapseButtonStyle}"
                    Click="ViewerExpandButton_Click"
                    ToolTip="{x:Static services:Strings.ToolTipViewer}">
                <!-- "chevron_right", the other half of the carousel's pair, on
                     the same terms as the collapse glyph beside it - see there
                     for why these two skip the 960 box. -->
                <Path x:Name="ViewerExpandGlyph"
                        Data="M522-480 333-669l51-51 240 240-240 240-51-51 189-189Z"
                        Fill="{DynamicResource ForegroundText}"
                        Stretch="Uniform"
                        Width="{DynamicResource ViewerChipIconSize}"
                        Height="{DynamicResource ViewerChipIconSize}"
                        RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <ScaleTransform x:Name="ViewerExpandGlyphFlip"
                                ScaleX="1"/>
                    </Path.RenderTransform>
                </Path>
            </Button>
        </Grid>

        <!-- What the auto-hidden sidebar actually shows: one flat colour over
             the whole window, up for exactly as long as the content is down
             (SetExpandedContentVisibility owns both).

             A cover rather than a recolour of the panels underneath. Those
             panels are two colours - the header's 36px and the tree's
             background below it - so a 6px strip on the desktop was showing a
             seam nobody chose, and reaching them would mean swapping resource
             keys the whole tree also reads (the expensive kind of write, see
             SetBrushColor).

             IsHitTestVisible="False" is load-bearing: the collapsed window is
             hovered to reveal it and can be dragged open, and a covering
             Border with a Background would answer all of that itself. -->
        <Border x:Name="AutoHideHandleOverlay"
                Background="{DynamicResource AutoHideHandleBackground}"
                IsHitTestVisible="False"
                Visibility="Collapsed"/>

        <!-- The docked window's own top and bottom edges. Docked, WPF's frame is
             gone (ResizeMode=NoResize), so height is drag-resized the same way
             width already is - by a Thumb overlaid on the edge.

             Two of them rather than one, because height alone is not the whole
             request: shrink from the bottom only and the sidebar is always
             pinned to the top of the screen with the gap below it. Dragging the
             TOP edge moves Top and Height together, so where the band sits comes
             out of the same gesture instead of needing a second one.

             Both grips run ordinary WPF Thumb drags that move ONLY
             RootContent's margins and the window clip region - the window
             itself is parked covering the whole work-area edge for as long as
             it is docked (see PositionToWorkArea), so neither gesture involves
             window geometry at all. Double-click restore is read off
             ClickCount in both Preview handlers.

             Both are hidden unless the window is docked and open - see
             UpdateResizeThumbVisibility, which owns all three thumbs. -->
        <Thumb x:Name="TopResizeThumb"
                VerticalAlignment="Top"
                Height="6"
                Style="{StaticResource ResizeThumbHorizontalStyle}"
                Cursor="SizeNS"
                Visibility="Collapsed"
                PreviewMouseLeftButtonDown="TopResizeThumb_PreviewMouseLeftButtonDown"
                DragStarted="TopResizeThumb_DragStarted"
                DragDelta="TopResizeThumb_DragDelta"
                DragCompleted="TopResizeThumb_DragCompleted"/>
        <Thumb x:Name="BottomResizeThumb"
                VerticalAlignment="Bottom"
                Height="6"
                Style="{StaticResource ResizeThumbHorizontalStyle}"
                Cursor="SizeNS"
                Visibility="Collapsed"
                PreviewMouseLeftButtonDown="BottomResizeThumb_PreviewMouseLeftButtonDown"
                DragStarted="BottomResizeThumb_DragStarted"
                DragDelta="BottomResizeThumb_DragDelta"
                DragCompleted="BottomResizeThumb_DragCompleted"/>

        <!-- Resize grip: overlaid on the content's right edge (see the note on
             the root Grid above), not a sibling occupying its own column. -->
        <Thumb x:Name="ResizeThumb"
                HorizontalAlignment="Right"
                Width="6"
                Style="{StaticResource ResizeThumbStyle}"
                Cursor="SizeWE"
               DragDelta="ResizeThumb_DragDelta"
               DragCompleted="ResizeThumb_DragCompleted"
               MouseDoubleClick="ResizeThumb_MouseDoubleClick"/>

        <!-- The two corners, where the outer edge already crosses the band's
             top and bottom. THEY TAKE NO NEW PIXELS: those 6×6 squares are
             already grips, and until now the width one simply won the hit test
             there because it is declared last. All this does is let the square
             move both axes instead of one - which is why it can exist at all in
             a place where a mis-click is expensive.
             Declared after the three so they keep winning their own corners.

             Both jobs are done by CALLING the existing handlers rather than by
             new arithmetic: the width path is stateless and reads the drag
             delta, the band path captures anchors on start and reads the
             absolute cursor, and a width change moves Left while leaving Top
             alone - so the two do not disturb each other. Writing a third
             geometry path here is exactly how this area has gone wrong before.

             Viewer-only from 2026-08-11 to 2026-08-14, both on the user's
             call: first closed because with the panel shut the sidebar is
             narrow and an accidental resize there is not a cheap mistake,
             then opened for both states - the squares are grip pixels either
             way, so the only real cost is a corner grab meant as width-only
             moving the height too. Side and cursor are set in
             UpdateResizeThumbVisibility, since which corner it is depends on
             which edge the window docks to. -->
        <Thumb x:Name="TopCornerResizeThumb"
                VerticalAlignment="Top"
                Width="6"
                Height="6"
                Style="{StaticResource ResizeThumbStyle}"
                Visibility="Collapsed"
                DragStarted="TopCornerResizeThumb_DragStarted"
                DragDelta="TopCornerResizeThumb_DragDelta"
                DragCompleted="TopCornerResizeThumb_DragCompleted"/>
        <Thumb x:Name="BottomCornerResizeThumb"
                VerticalAlignment="Bottom"
                Width="6"
                Height="6"
                Style="{StaticResource ResizeThumbStyle}"
                Visibility="Collapsed"
                DragStarted="BottomCornerResizeThumb_DragStarted"
                DragDelta="BottomCornerResizeThumb_DragDelta"
                DragCompleted="BottomCornerResizeThumb_DragCompleted"/>

        <!-- Hands the window's top edge back to Windows so a floating window can
             be resized upwards.

             HeaderGrid sits flush against that edge and carries
             IsHitTestVisibleInChrome="True", which tells WindowChrome the area
             is ours rather than frame - and that claim swallows the top resize
             border along with everything else. The flag has to stay: without it
             the header's own double-click never runs and Windows maximizes the
             window instead (see HeaderGrid's comment). So the top few pixels are
             covered by a strip that makes no such claim, and WindowChrome reads
             it as frame again.

             Last child, so it sits above the header in z-order, and only shown
             while floating: docked, ResizeBorderThickness is 0 and this would do
             nothing but eat the top of the header's own mouse handling.
             Height matches MainWindow.FloatingResizeBorder. -->
        <!-- WHERE THE WINDOW CAN STILL BE GRABBED WHILE THE HEADER IS GONE
             (2026-08-17, the author's shape). 앱 전체화면 takes the header away,
             and while FLOATING the top strip is still the caption - so the window
             moves if you drag there, and nothing on screen said so. Full screen
             that keeps the window's own size is what made that worth showing: a
             window you can no longer move is a window stuck where it happened to
             be.
             A wash rather than the header coming back: bringing the header back
             would either shift the picture down by its height or need a second
             overlay of the whole bar, and what is being answered is only "this
             strip is not the picture". It marks exactly the caption's height, so
             it also explains why the wheel and a click do not reach the picture
             up there.
             IsHitTestVisible="False" is load-bearing - the whole point of the
             strip is that the drag reaches WINDOWS, and a Border with a
             Background would answer it first. Fixed black rather than a theme
             brush, for the reason the full-screen transport's plate gives: what
             shows through it is the picture, not the app. -->
        <Border x:Name="ViewerMoveHint"
                VerticalAlignment="Top"
                Height="36"
                Background="#59000000"
                IsHitTestVisible="False"
                Visibility="Collapsed">
            <!-- Material Symbols "arrows_output" (the author's pick), four arrows
                 out of a centre dot - "this thing can be taken anywhere" rather
                 than a direction. No 960-box tail: it stands alone in the strip
                 rather than beside other marks, which is the case that gains
                 nothing from the box (see the icon rules this app keeps).
                 White with its own alpha, like the strip: both are drawn over a
                 picture, so neither can take a theme brush. -->
            <Path Data="M144-144v-192h72v69l117-117 51 51-117 117h69v72H144Zm480 0v-72h69L576-333l51-51 117 117v-69h72v192H624ZM333-576 216-693v69h-72v-192h192v72h-69l117 117-51 51Zm294 0-51-51 117-117h-69v-72h192v192h-72v-69L627-576ZM479.79-408Q450-408 429-429.21t-21-51Q408-510 429.21-531t51-21Q510-552 531-530.79t21 51Q552-450 530.79-429t-51 21Z"
                    Fill="#D9FFFFFF"
                    Stretch="Uniform"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
        </Border>

        <!-- 같은 자리, 도킹 상태 (2026-08-19, 요청). 창 모드에서 위쪽 띠는 캡션이라
             Windows가 알아서 창을 옮겨 주지만, 도킹 상태에서는 캡션 높이가 0이라
             그 자리에 아무것도 없다 - 앱 전체화면에서는 헤더까지 사라져서, 창을
             잡을 방법이 하나도 남지 않는다.
             그래서 같은 자리에 잡을 곳을 하나 만든다. 끌면 도킹이 풀리고 창이
             커서를 따라온다. 헤더를 끌어 도킹을 푸는 것과 같은 동작이고, 그 헤더가
             없는 상태에서의 같은 문이다.
             투명하고 히트테스트를 받는다. 바로 위 ViewerMoveHint와 반대인데,
             그쪽은 Windows가 드래그를 받아야 해서 비켜서야 하고 이쪽은 우리가
             받아야 하기 때문이다. 그 표시 바로 다음에 서서 입력을 먼저 받고,
             투명하므로 표시는 그대로 비친다.
             높이는 보일 때 코드에서 헤더 높이로 맞춘다(글꼴을 따라간다).
             맨 위 6px은 비켜 준다. 그 자리는 도킹된 띠의 위쪽 크기 조절
             손잡이(TopResizeThumb)이고, 이 띠가 그 위에 서면서 삼켰다
             (2026-08-19, 신고). 진짜 창의 제목 표시줄도 맨 위 몇 픽셀은
             크기 조절 테두리이므로, 비켜 주는 것이 원래 모양이기도 하다.
             표시(ViewerMoveHint)는 그대로 맨 위에서 시작한다 - 표시가 말하는
             것은 "여기는 그림이 아니다"이고, 그 6px도 그림은 아니다. -->
        <Border x:Name="ViewerDockedMoveStrip"
                VerticalAlignment="Top"
                Height="36"
                Margin="0,6,0,0"
                Background="Transparent"
                Visibility="Collapsed"
                MouseLeftButtonDown="FullscreenUndockStrip_MouseLeftButtonDown"
                MouseMove="FullscreenUndockStrip_MouseMove"
                MouseLeftButtonUp="FullscreenUndockStrip_MouseLeftButtonUp"
                MouseLeave="FullscreenUndockStrip_MouseLeave"/>

        <Border x:Name="TopResizeStrip"
                VerticalAlignment="Top"
                Height="6"
                Background="Transparent"
                Visibility="Collapsed"/>
    </Grid>
</Window>
