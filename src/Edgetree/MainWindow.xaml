                                                    Text="{x:Static services:Strings.ViewerHdrSaturation}"
                                                    Foreground="{DynamicResource MenuForeground}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal">
                                                <Button Content="−"
                                                        Style="{StaticResource MenuStepperButtonStyle}"
                                                        Click="ViewerHdrSaturationDown_Click"/>
                                                <TextBlock x:Name="ViewerHdrSaturationText"
                                                        Foreground="{DynamicResource MenuForeground}"
                                                        Width="{DynamicResource MenuStepperValueWidth}"
                                                        TextAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                                <Button Content="+"
                                                        Style="{StaticResource MenuStepperButtonStyle}"
                                                        Click="ViewerHdrSaturationUp_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem x:Name="ViewerHdrContrastItem"
                                        StaysOpenOnClick="True"
                                        Focusable="False"
                                        Padding="{DynamicResource MenuStepperRowPadding}"
                                        Visibility="Collapsed">
                                    <MenuItem.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                    Text="{x:Static services:Strings.ViewerHdrContrast}"
                                                    Foreground="{DynamicResource MenuForeground}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"/>
                                            <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal">
                                                <Button Content="−"
                                                        Style="{StaticResource MenuStepperButtonStyle}"
                                                        Click="ViewerHdrContrastDown_Click"/>
                                                <TextBlock x:Name="ViewerHdrContrastText"
                                                        Foreground="{DynamicResource MenuForeground}"
                                                        Width="{DynamicResource MenuStepperValueWidth}"
                                                        TextAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                                <Button Content="+"
                                                        Style="{StaticResource MenuStepperButtonStyle}"
                                                        Click="ViewerHdrContrastUp_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <Separator Tag="file"/>
                                <!-- THE FILE's bookmark, which the panel had no
                                     way to reach: the row it marks is the one the
                                     panel is showing, so a picture worth coming
                                     back to had to be found in the tree again
                                     first (2026-08-11).
                                     Add and remove only - one row that swaps its
                                     own label. The tree's menu offers the LIST
                                     and the two jumps as well, and that is the
                                     right place for them: they are about the
                                     collection, where this is about the file in
                                     front of you.
                                     At the head of the file-action group rather
                                     than in a fence of its own, which would be a
                                     group of one. It shows for everything the
                                     panel opens - pictures, films and sound
                                     alike - because the tree row underneath is a
                                     row either way.
                                     Straight to the row menu's own handler, like
                                     every other file action here: it reads the
                                     tree's selection, and this menu only opens
                                     when that selection IS the panel's file. -->
                                <MenuItem x:Name="ViewerBookmarkItem"
                                        Header="{x:Static services:Strings.MenuBookmarkAdd}"
                                        InputGestureText="Ctrl+Alt+K"
                                        Tag="file"
                                        Click="BookmarkMenuItem_Click"/>
                                <!-- All four are refused while a film is loaded:
                                     a playing MediaElement holds the file OPEN,
                                     so rename and delete fail at the OS and cut
                                     leaves a file marked for a move that can't
                                     happen. Greyed rather than hidden - the rows
                                     every other selection has should not vanish
                                     and move everything under them (
                                     2026-08-10). -->
                                <MenuItem x:Name="ViewerCutItem"
                                        Header="{x:Static services:Strings.MenuCut}"
                                        InputGestureText="Ctrl+X"
                                        Tag="file"
                                        Click="CutItem_Click"/>
                                <MenuItem x:Name="ViewerCopyItem"
                                        Header="{x:Static services:Strings.MenuCopy}"
                                        InputGestureText="Ctrl+C"
                                        Tag="file"
                                        Click="CopyItem_Click"/>
                                <MenuItem x:Name="ViewerRenameItem"
                                        Header="{x:Static services:Strings.MenuRename}"
                                        InputGestureText="F2"
                                        Tag="file"
                                        Click="RenameItem_Click"/>
                                <MenuItem x:Name="ViewerDeleteItem"
                                        Header="{x:Static services:Strings.MenuDelete}"
                                        InputGestureText="Del"
                                        Tag="file"
                                        Click="DeleteItem_Click"/>
                                <Separator Tag="file"/>
                                <MenuItem Header="{x:Static services:Strings.MenuCopyPath}"
                                        InputGestureText="Ctrl+Shift+C"
                                        Tag="file"
                                        Click="CopyPath_Click"/>
                                <MenuItem Header="{x:Static services:Strings.MenuRevealInExplorer}"
                                        Tag="file"
                                        Click="RevealInExplorer_Click"/>
                                <MenuItem Header="{x:Static services:Strings.MenuProperties}"
                                        Tag="file"
                                        Click="ShowProperties_Click"/>
                                <!-- THE HEADER'S OWN MENU, REPEATED HERE WHILE
                                     THE HEADER IS GONE (2026-08-16). Full
                                     screen hides the title bar, and with it the
                                     only way to save a preset, restart or quit -
                                     verbs that have nowhere else to live (the X
                                     stopped ending the app in 2026-08-10, and
                                     the tray icon is optional). A mode that
                                     takes the whole screen should not also take
                                     away the way out of the app.
                                     Rows, not a submenu: it is what the header
                                     shows, in the order the header shows it, so
                                     the two read as the same menu rather than
                                     as a copy of it.
                                     Collapsed at every other time - docked or
                                     windowed, the header is right there, and
                                     five rows repeated under the file actions
                                     would be five rows to read past. -->
                                <Separator x:Name="ViewerWindowSeparator"
                                        Tag="presets-begin"
                                        Visibility="Collapsed"/>
                                <!-- The presets land between the two tagged
                                     separators, exactly as they land above the
                                     tagged one in the header menu - see
                                     BuildPresetMenu, which reads both tags and
                                     never addresses a menu by position. -->
                                <Separator x:Name="ViewerWindowPresetSeparator"
                                        Tag="presets"
                                        Visibility="Collapsed"/>
                                <MenuItem x:Name="ViewerHelpItem"
                                        Header="{x:Static services:Strings.MenuHelp}"
                                        InputGestureText="F1"
                                        Visibility="Collapsed"
                                        Click="HelpMenuItem_Click"/>
                                <Separator x:Name="ViewerWindowVerbSeparator"
                                        Visibility="Collapsed"/>
                                <MenuItem x:Name="ViewerMinimizeItem"
                                        Header="{x:Static services:Strings.ToolTipMinimize}"
                                        Visibility="Collapsed"
                                        Click="MinimizeButton_Click"/>
                                <MenuItem x:Name="ViewerRestartItem"
                                        Header="{x:Static services:Strings.MenuRestart}"
                                        Visibility="Collapsed"
                                        Click="RestartMenuItem_Click"/>
                                <Separator x:Name="ViewerExitSeparator"
                                        Visibility="Collapsed"/>
                                <MenuItem x:Name="ViewerExitItem"
                                        Header="{x:Static services:Strings.TrayExit}"
                                        Visibility="Collapsed"
                                        Click="ExitAppMenuItem_Click"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <!-- Uniform with no StretchDirection cap: the user
                             asked for no size ceiling, so a small image may
                             scale up - HighQuality keeps that acceptable. -->
                        <Image x:Name="ViewerImage"
                                Stretch="Uniform"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                RenderTransformOrigin="0.5,0.5"
                                Margin="10">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ViewerZoomScale"
                                            ScaleX="1"
                                            ScaleY="1"/>
                                    <TranslateTransform x:Name="ViewerZoomPan"
                                            X="0"
                                            Y="0"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Border>
                    <!-- Zoom navigator: the whole picture small, with a box
                         showing which part of it the panel is currently
                         looking at. A sibling of the host rather than a child,
                         so the host stays a Border with one child and its clip
                         is untouched; it sizes itself to the picture's aspect
                         in code.
                         The plate is a MAP now, not read-only (
                         2026-08-09 - they kept grabbing the white box and
                         getting a whole-image pan instead): press anywhere on
                         it and the view centres there, then follows the drag.
                         It only shows while a pan is possible, so it is never
                         an inert click target; a pan drag that STARTED on the
                         picture keeps its capture and never lands here.
                         Fixed colours, the one place in this app that ignores
                         the theme: what shows through behind it is the PHOTO,
                         so a light-theme plate would vanish on a bright image
                         and a dark one on a dark image. The dark scrim over
                         everything OUTSIDE the box is what keeps the box
                         readable over any picture. -->
                    <Border x:Name="ViewerNavigatorPlate"
                            Grid.Row="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,10,10"
                            Visibility="Collapsed"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="ViewerNavigatorPlate_MouseLeftButtonDown"
                            MouseMove="ViewerNavigatorPlate_MouseMove"
                            MouseLeftButtonUp="ViewerNavigatorPlate_MouseLeftButtonUp"
                            LostMouseCapture="ViewerNavigatorPlate_LostMouseCapture"
                            Background="#CC181818"
                            BorderBrush="#59FFFFFF"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- Full strength, dimmed by the SCRIM below and
                                 only OUTSIDE the box - the first design
                                 dimmed the whole thumbnail and brightened
                                 the box's fill, and the inverse was asked for
                                 (2026-08-09): the part you are looking at
                                 stays true, the rest steps back. -->
                            <Image x:Name="ViewerNavigatorImage"
                                    Stretch="Fill"
                                    RenderOptions.BitmapScalingMode="LowQuality"/>
                            <!-- A dark plate with a hole where the box is.
                                 Geometry Rects are render-only updates, so
                                 tracking the pan frame by frame costs the
                                 same as the box's own transform. -->
                            <!-- 0x59 (35%) → 0x6E (43%), 2026-08-11, chosen by
                                 eye against a 50% that read as too much. Purely
                                 how it looks: the plate can afford a heavier dim
                                 because nothing is lost with it. Whatever falls
                                 outside the box is on screen full size behind
                                 the navigator, and the filmstrip is showing the
                                 neighbours underneath - so the dimmed part is
                                 the only copy of nothing. -->
                            <Path Fill="#6E000000">
                                <Path.Data>
                                    <CombinedGeometry GeometryCombineMode="Exclude">
                                        <CombinedGeometry.Geometry1>
                                            <RectangleGeometry x:Name="ViewerNavigatorScrimOuter"/>
                                        </CombinedGeometry.Geometry1>
                                        <CombinedGeometry.Geometry2>
                                            <RectangleGeometry x:Name="ViewerNavigatorScrimHole"/>
                                        </CombinedGeometry.Geometry2>
                                    </CombinedGeometry>
                                </Path.Data>
                            </Path>
                            <!-- Moved by a TranslateTransform, never by Margin:
                                 this box tracks the pan drag frame by frame,
                                 and a margin would run a layout pass on each
                                 one. Width/Height do change on a zoom STEP,
                                 which is once per notch, not once per frame.
                                 No fill of its own any more - the clear
                                 window through the scrim IS the fill. -->
                            <Border x:Name="ViewerNavigatorBox"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    BorderBrush="#FFFFFFFF"
                                    BorderThickness="1"
                                    Background="Transparent"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ViewerNavigatorBoxOffset"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- Video playback (round 4). A separate element rather
                         than something the Image could do: WPF draws video
                         through its own path, so none of the zoom/pan
                         transform machinery applies - which is why the zoom
                         strip is swapped out for the transport strip below
                         while this is showing.
                         LoadedBehavior/UnloadedBehavior Manual: playback
                         starts on an explicit click and NEVER on selection,
                         or arrow-keying a folder would set several films
                         playing at once. The Source is cleared the moment the
                         selection leaves - a playing MediaElement holds the
                         file open, and this app's own rename and delete are
                         two rows away. -->
                    <!-- The clip the zoom made necessary. ViewerImage has always
                         had one (ViewerImageHost is the Border that carries it);
                         the media element is that Border's SIBLING, so nothing
                         held it in and a zoomed film simply grew out over the
                         tree (reported with a screenshot, 2026-08-10). Its own
                         Border, rather than clipping the row's Grid, so the play
                         overlay and the navigator keep the bounds they had. -->
                    <Border x:Name="ViewerMediaHost"
                            Grid.Row="0"
                            ClipToBounds="True"
                            MouseEnter="ViewerPictureHover_Changed"
                            MouseLeave="ViewerPictureHover_Changed">
                    <MediaElement x:Name="ViewerMedia"
                            Margin="10"
                            Visibility="Collapsed"
                            Stretch="Uniform"
                            LoadedBehavior="Manual"
                            UnloadedBehavior="Manual"
                            ScrubbingEnabled="True"
                            RenderTransformOrigin="0.5,0.5"
                            MouseDown="ViewerImageHost_MouseDown"
                            MediaOpened="ViewerMedia_MediaOpened"
                            MediaEnded="ViewerMedia_MediaEnded"
                            MediaFailed="ViewerMedia_MediaFailed"
                            BufferingStarted="ViewerMedia_BufferingStarted"
                            BufferingEnded="ViewerMedia_BufferingEnded">
                        <!-- Scale only, and centred. The picture's transform
                             group carries a pan as well; a film does not, by
                             decided 2026-08-10 - left-drag is
                             already play/pause here, and splitting it by
                             whether the film happens to be zoomed would be the
                             conditional gesture this app keeps refusing. So the
                             film grows about its middle and stays there. -->
                        <MediaElement.RenderTransform>
                            <ScaleTransform x:Name="ViewerMediaScale"/>
                        </MediaElement.RenderTransform>
                    </MediaElement>
                    </Border>
                    <!-- The subtitle line. OUTSIDE the media element's clip and
                         its scale on purpose: it is not part of the picture, so
                         zooming the film must not zoom the words, and it should
                         stay put and stay readable while the picture moves under
                         it.

                         A filled box behind the text rather than an outline or a
                         shadow (2026-08-10, "디즈니플러스 자막 같이"): a
                         box is one shape that works over any frame, while an
                         outline needs a second pass over every glyph and a
                         shadow needs an effect - and both are the kind of thing
                         that reads as almost-right rather than right.

                         Never hit-testable. It sits over the film, and the film
                         takes clicks (play/pause). -->
                    <Border x:Name="ViewerSubtitlePlate"
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="16,0,16,18"
                            Padding="10,3"
                            CornerRadius="3"
                            Background="#A6000000"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ViewerSubtitleText"
                                Foreground="#FFFFFFFF"
                                TextAlignment="Center"
                                TextWrapping="Wrap"/>
                    </Border>
                    <!-- A LINE NAMING THE FILE AND THE TWO KEYS lived here from
                         2026-08-16 to 2026-08-17, shown on a mouse move while
                         the cover was up. Taken out on the author's call: it
                         appeared on the smallest movement, which made it feel
                         like something to get rid of rather than something
                         offered, and it could not be dismissed by hand either -
                         a click over the picture already means play or pan.
                         What settled it is that the file's name is answered in
                         several places already (the caption, the 지금 재생 중 line,
                         the footer's chip, the tree row), so the line was adding
                         a fourth answer rather than a missing one. The keys keep
                         their home in F1. The same reasoning retired the
                         slideshow's track-name overlay the same day. -->
                    <!-- The one affordance that turns a still frame into a
                         promise the panel can keep. Only up for a video that
                         isn't playing; clicking the picture itself is left
                         alone, since that gesture already means pan. -->
                    <!-- ABOVE THE CLOCK (2026-08-16). Both sit in this row and
                         the clock is declared after, so it was drawing over the
                         disc - and of the two, one is a control and the other
                         is a wall clock. ZIndex rather than moving either
                         declaration: the order they are written in is the order
                         they are explained in, and the overlap is one fact
                         about one pair. -->
                    <Button x:Name="ViewerPlayOverlay"
                            Grid.Row="0"
                            Panel.ZIndex="1"
                            Width="64"
                            Height="64"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Cursor="Hand"
                            MouseEnter="ViewerPictureHover_Changed"
                            MouseLeave="ViewerPictureHover_Changed"
                            Click="ViewerPlayOverlay_Click"
                            ToolTip="{x:Static services:Strings.ViewerPlay}">
                        <!-- Light plate, dark mark, no outline (2026-08-10:
                             the dark-plate-and-white-triangle version "다른데
                             플레이버튼하고 너무 같아서"). Both halves are
                             translucent, so the still frame reads through the
                             button rather than being covered by it - which is
                             also what keeps a 64px disc from looking like a
                             sticker dropped on the picture. The outline went
                             with the dark plate: an edge is what a button needs
                             when it is darker than everything around it, and
                             this one is lighter. Hover just makes the plate more
                             solid; nothing moves or grows. -->
                        <!-- TWO MARKS, ONE SHOWING. The disc says which of the
                             two states the file under it is in, and Tag is what
                             picks (UpdateViewerPlayOverlay). Two shapes toggled
                             rather than one Data swapped: the same arrangement
                             the transport's own play/pause uses, and it keeps
                             both geometries where they can be compared.

                             The pause bars share the triangle's box - 18 to 46
                             tall, centred on 32 - so the mark does not appear to
                             jump or resize as the state changes under it. -->
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <!-- The hairline ring is what keeps the
                                         disc A DISC on a white ground: the
                                         plate is translucent white, which over
                                         a no-art track in the light theme left
                                         a bare triangle floating on nothing
                                         (2026-08-13). Over a photograph the
                                         ring is a pixel of edge the eye reads
                                         as the button's rim.

                                         A DROP SHADOW WAS TRIED HERE AND TAKEN
                                         BACK OUT, same day (2026-08-16). The
                                         reasoning was sound - the ring only
                                         answers a bright flat background, so a
                                         dark or busy photograph left the disc
                                         with nothing holding it off - but the
                                         thing itself did not look right at any
                                         of the settings it was given (depth 1.5
                                         to 2, blur 9 to 20, 40 to 50 percent).
                                         The plate is TRANSLUCENT, which is the
                                         part that fights a shadow: whatever
                                         sits behind the disc shows through it,
                                         so the shadow's own core greys the
                                         plate from the inside while it is
                                         supposed to be lifting it off the
                                         picture.

                                         If this is worth another go, that is
                                         the thing to solve first - a caster
                                         that is a RING rather than a disc would
                                         put the shadow outside the rim only,
                                         and the plate would stay clean. -->
                                    <Ellipse x:Name="Plate"
                                            Fill="#B0FFFFFF"
                                            Stroke="#2E000000"
                                            StrokeThickness="1"/>
                                    <!-- The marks keep their 64-unit box and a
                                         Viewbox maps it onto whatever size the
                                         disc has been given (see
                                         LayoutViewerPlayOverlay). Scaling them
                                         individually with Stretch would let
                                         each fill the disc on its own and lose
                                         the shared box the two were drawn in -
                                         which is the whole reason the mark does
                                         not appear to jump as the state
                                         changes. -->
                                    <Viewbox Stretch="Uniform">
                                        <Grid Width="64"
                                                Height="64">
                                            <Path x:Name="PlayMark"
                                                    Data="M 24,18 L 44,32 L 24,46 Z"
                                                    Fill="#C0000000"/>
                                            <Path x:Name="PauseMark"
                                                    Data="M24,18 H30 V46 H24 Z M34,18 H40 V46 H34 Z"
                                                    Fill="#C0000000"
                                                    Visibility="Collapsed"/>
                                        </Grid>
                                    </Viewbox>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                            Value="True">
                                        <Setter TargetName="Plate"
                                                Property="Fill"
                                                Value="#D8FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="Tag"
                                            Value="pause">
                                        <Setter TargetName="PlayMark"
                                                Property="Visibility"
                                                Value="Collapsed"/>
                                        <Setter TargetName="PauseMark"
                                                Property="Visibility"
                                                Value="Visible"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- What a non-image selection shows instead: the file's
                         own shell icon, natural size, centered. -->
                    <Image x:Name="ViewerIconImage"
                            Grid.Row="0"
                            Width="64"
                            Height="64"
                            Stretch="Uniform"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"/>
                    <!-- 잠금 화면의 시계, over whatever the panel is showing (F9).
                         Sized in code from the panel rather than the app's font:
                         it is not text the app is telling you, it is the shape
                         Windows puts on a screen nobody is working at, and that
                         shape is a proportion of the surface it sits on.

                         A SIBLING of the picture, not a child, so the fade
                         between slides runs underneath it - the clock stays
                         still while the pictures change, which is what a lock
                         screen does.

                         Fixed white, the second place in this app to ignore the
                         theme (the navigator plate is the first): what shows
                         through behind it is the PHOTO, and the theme has no
                         opinion about that. The shadow is what carries it over
                         a bright one - a filled plate is what the subtitle line
                         uses and it is right there, because a subtitle is a
                         line of words on a film; this is a face on a wall, and
                         a box around it would be neither.

                         Never hit-testable: the picture underneath takes the
                         click, and that click is what ends the show. -->
                    <!-- TOP-aligned, with the gap set in code as a share of the
                         panel's height: sitting it dead centre put it over the
                         middle of every photograph, which is where the subject
                         of a photograph usually is. The lock screen holds its
                         clock high for the same reason. -->
                    <StackPanel x:Name="ViewerClock"
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                        <StackPanel.Effect>
                            <DropShadowEffect x:Name="ViewerClockShadow"
                                    Color="#FF000000"
                                    Direction="270"
                                    ShadowDepth="1"
                                    BlurRadius="18"
                                    Opacity="0.7"/>
                        </StackPanel.Effect>
                        <!-- 오전/오후 on its own line ABOVE the hour, centred
                             (2026-08-16). It began as a small run beside the
                             digits, which is how a clock face writes it - but
                             the block here is three centred lines and a fourth
                             thing hanging off one side made the whole of it
                             read as off-centre. Above, it is one more line in
                             a stack, and it takes no side. It is also the same
                             either way now: 오전 leads in Korean and AM trails
                             in English only when the two share a line. -->
                        <TextBlock x:Name="ViewerClockMeridiem"
                                Foreground="#FFFFFFFF"
                                TextAlignment="Center"/>
                        <!-- BlockLineHeight with a line shorter than the font's
                             own: a numeral this size carries a descender's
                             worth of empty box under it, and that gap is what
                             pushed the date away from the time. Digits have no
                             descenders, so the space cut here is space nothing
                             was drawn in. -->
                        <TextBlock x:Name="ViewerClockTime"
                                Foreground="#FFFFFFFF"
                                FontWeight="Bold"
                                TextAlignment="Center"
                                LineStackingStrategy="BlockLineHeight"/>
                        <TextBlock x:Name="ViewerClockDate"
                                Foreground="#FFFFFFFF"
                                TextAlignment="Center"/>
                    </StackPanel>
                    <!-- Name, a wide gap, then ONE metadata line (resolution ·
                         size · date) - briefly three lines, folded back the
                         same day: nothing more is coming to this caption
                         (2026-08-08). The name wears the tree's own
                         file-name colour; the metadata line wears the footer
                         chips' unchecked ink (ForegroundText at the chips'
                         own 0.65 - matching them is the user's spec here, so
                         the no-opacity rule yields to the pairing). -->
                    <!-- The filmstrip: the carousel counter, opened out. What
                         < 35 / 257 > says in numbers this says in pictures, and
                         it walks the SAME list (GetViewerCarouselItems) so the
                         two can never disagree about what the folder holds.
                         Films are in that list as of 2026-08-10 - a strip that
                         emptied itself in a folder of films would be a strange
                         thing to call a filmstrip, and the counter was widened
                         with it rather than left counting something else.

                         CanContentScroll, and the wheel handler that goes with
                         it, are what make this move a CELL at a time instead of
                         a pixel at a time (and the same choice the
                         tree made for its rows). Virtualized in the same
                         breath: it is what keeps a 257-frame folder to the
                         dozen containers on screen, and the shell is only asked
                         about a cell once one exists.

                         No animation anywhere in here. Following the selection
                         is an instant jump - see SyncFilmstripToSelection. -->
                    <!-- The strip needed a divider: without a line the frames
                         simply began, and the picture and the strip read as one
                         crowded thing. THE THUMB BELOW DRAWS IT NOW, all three
                         states from one ladder - barely there at rest, a touch
                         stronger under the cursor, FAINTER again while being
                         dragged, which is this app's standing rule for grab
                         lines (the hand is already on it; it does not need to be
                         told twice).
                         The border keeps its 1px of THICKNESS because the strip
                         is laid out against it, and gives up its brush: drawing
                         the line here as well would put two owners on one pixel,
                         and this one went invisible whenever 영역 구분선 was off
                         (2026-08-26, on report - the resting line was the only
                         thing saying the edge could be dragged at all). -->
                    <Border x:Name="ViewerFilmstripHost"
                            Grid.Row="2"
                            BorderThickness="0,1,0,0"
                            BorderBrush="Transparent"
                            Visibility="Collapsed">
                      <Grid>
                        <!-- LEFT PADDING 4 → 0 (2026-08-11), so the first frame
                             starts on the same vertical line the picture above
                             it does. The cells carry no left margin of their
                             own, so this 4 was the whole of the offset.
                             It lines up when the picture FILLS the panel's
                             width, which is the ordinary case; a portrait one is
                             letterboxed and starts further in, and so does the
                             strip once it has been scrolled. Neither is worth
                             chasing - the alignment is there to be noticed when
                             it holds, not enforced when it cannot.
                             The right stays at 4: nothing over there has an edge
                             to agree with. -->
                        <!-- HorizontalScrollBarVisibility is Auto rather than
                             Hidden (2026-08-12): a strip of 2,400 frames
                             scrolled with no bar showed neither where it was
                             nor how far it went, and the wheel was the only way
                             to find out. Auto leaves a short folder's strip
                             exactly as it was - the bar only exists once the
                             frames do not fit - and it picks up the app's own
                             thin scrollbar (App.xaml's implicit style, the same
                             one the tree and the results list use), so nothing
                             here has to describe what it looks like. -->
                        <ListBox x:Name="ViewerFilmstrip"
                                Style="{StaticResource FilmstripListBoxStyle}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0,5,4,4"
                                Focusable="False"
                                ScrollViewer.CanContentScroll="True"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                SizeChanged="ViewerFilmstrip_SizeChanged"
                                PreviewMouseWheel="ViewerFilmstrip_PreviewMouseWheel"
                                PreviewMouseLeftButtonDown="ViewerFilmstrip_PreviewMouseLeftButtonDown"
                                PreviewMouseRightButtonDown="ViewerFilmstrip_PreviewMouseRightButtonDown"
                                ContextMenuOpening="ViewerFilmstrip_ContextMenuOpening"
                                AllowDrop="True"
                                DragOver="ViewerFilmstrip_DragOver"
                                Drop="ViewerFilmstrip_Drop"
                                PreviewMouseMove="ViewerFilmstrip_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="ViewerFilmstrip_PreviewMouseLeftButtonUp">
                            <!-- THE SAME OPERATIONS, THE SAME HANDLERS. The
                                 file rows go to the tree's own click handlers,
                                 which all work off GetEffectiveSelection: the
                                 strip's marks when there are any - they ARE the
                                 app's multi-selection - and otherwise the cell
                                 the menu was opened on, which stands in for the
                                 tree's selection while this menu is up
                                 (FilmstripMenuItem, 2026-09-28). 전체 선택 and
                                 속성 have handlers of their own.
                                 Paste is on the list because that is where a
                                 folder of pictures is being looked at when
                                 something arrives from elsewhere; it lands in
                                 the folder the panel is showing.
                                 Rename and Open are deliberately absent: they
                                 are one-file actions, and the surface this menu
                                 opens over is the one built for several.
                                 Renaming from the list itself arrived on
                                 2026-09-28 as a slow second click on the name
                                 under the picture on show, the way Explorer's
                                 icon views do it, and as F2 once the list has
                                 been pressed - a gesture and a key, not a row
                                 here. -->
                            <ListBox.ContextMenu>
                                <!-- REGISTERED, LIKE EVERY OTHER MENU HERE.
                                     Without the two handlers this menu is not
                                     in _openMenus, so the app believes nothing
                                     is open: auto-hide starts its countdown and
                                     the capture watchdog pulls the mouse
                                     capture out from under it, and the menu
                                     closes a few seconds after opening with
                                     nothing having been clicked (reported
                                     2026-08-22). The style comes with the same
                                     package - a menu that skips it does not
                                     match the app's own. -->
                                <!-- Both through handlers of their own, which
                                     pass to AnyMenu_Opened/AnyMenu_Closed and
                                     mark the span in which the right-clicked
                                     cell stands in for the tree's selection. -->
                                <!-- AND THE RIGHT-BUTTON RELEASE GUARD every
                                     other menu in this file carries (2026-09-28).
                                     This one was built on 2026-08-22 without
                                     it, so a right-button release over one of
                                     its rows ran that row: a release over 전체
                                     선택 marked every cell (tested), and one over
                                     삭제 would have deleted the picture
                                     right-clicked BEFORE - the one the menu was
                                     still about. With the release swallowed, a
                                     right-click on this menu does nothing, as on
                                     every other (see
                                     ContextMenu_PreviewMouseRightButtonUp). -->
                                <ContextMenu Style="{StaticResource DarkContextMenuStyle}"
                                        Opened="FilmstripContextMenu_Opened"
                                        Closed="FilmstripContextMenu_Closed"
                                        PreviewMouseRightButtonUp="ContextMenu_PreviewMouseRightButtonUp">
                                    <MenuItem Header="{x:Static services:Strings.MenuSelectAll}"
                                            InputGestureText="Ctrl+A"
                                            Click="FilmstripSelectAll_Click"/>
                                    <Separator/>
                                    <!-- Tagged so FilmstripContextMenu_Opened can
                                         stand them down while the search results
                                         drive the list (2026-10-06): 붙여넣기
                                         always, the rest when the menu names no
                                         file. -->
                                    <MenuItem Header="{x:Static services:Strings.MenuCut}"
                                            InputGestureText="Ctrl+X"
                                            Tag="cut"
                                            Click="CutItem_Click"/>
                                    <MenuItem Header="{x:Static services:Strings.MenuCopy}"
                                            InputGestureText="Ctrl+C"
                                            Tag="copy"
                                            Click="CopyItem_Click"/>
                                    <MenuItem Header="{x:Static services:Strings.MenuPaste}"
                                            InputGestureText="Ctrl+V"
                                            Tag="paste"
                                            Click="PasteItem_Click"/>
                                    <!-- 삭제 sits with the other file rows, as it
                                         does in the tree's, the results' and the
                                         panel's menus. This one alone set it
                                         apart with separators of its own until
                                         2026-10-06. -->
                                    <MenuItem Header="{x:Static services:Strings.MenuDelete}"
                                            InputGestureText="Del"
                                            Tag="delete"
                                            Click="DeleteItem_Click"/>
                                    <Separator/>
                                    <MenuItem Header="{x:Static services:Strings.MenuRevealInExplorer}"
                                            Tag="reveal"
                                            Click="RevealInExplorer_Click"/>
                                    <!-- LAST, where the tree menu keeps it. Its own
                                         handler rather than the tree's: the tree does
                                         move to the right-clicked cell now, but its
                                         walk can land after the menu opens or not at
                                         all, and a right-click between cells is about
                                         the folder - the cell is the one answer that
                                         is always right. -->
                                    <MenuItem Header="{x:Static services:Strings.MenuProperties}"
                                            Tag="properties"
                                            Click="FilmstripProperties_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <!-- The starting layout only; ApplyFilmstripLayout
                                 swaps it with the stored mode on startup and
                                 whenever the mode changes. -->
                            <ListBox.ItemsPanel>
                                <StaticResource ResourceKey="FilmstripBarPanel"/>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,3,0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <!-- On the CONTAINER, not inside the cell:
                                         the whole frame answers, including the
                                         letterboxed margins a portrait picture
                                         leaves, so there is no dead strip where
                                         the name refuses to appear. Name carries
                                         the extension, which is half of what the
                                         strip cannot show. -->
                                    <!-- THE ONE TOOLTIP THAT DOES NOT TAKE
                                         TooltipShowDelay, and the reason is that
                                         it is not an aside: every other list
                                         draws the name and the tooltip only adds
                                         the path, so a slow reveal costs nothing.
                                         THIS strip drew no name at all when the
                                         delay was set, so the tooltip WAS the
                                         name, and a cell had nothing to say
                                         about itself until the tooltip arrived
                                         (2026-08-26, on report). The name line
                                         (썸네일 파일명 표시) has been on by
                                         default since 2026-09-28; the delay was
                                         kept, because the line cuts a long name
                                         short and can be switched off, and in
                                         both cases the tooltip is still where
                                         any cell's whole name can be read.
                                         Its own literal on purpose: it is not a
                                         fraction of the shared number and must
                                         not follow it when that one is tuned.
                                         250 rather than 0: a cell still has to be
                                         RESTED on, so sweeping the strip on the
                                         way somewhere else pops nothing up.
                                         BetweenShowDelay is left at its default,
                                         which is what makes the SECOND cell and
                                         every one after it answer immediately -
                                         scanning a strip is one gesture, not a
                                         fresh decision per frame. -->
                                    <Setter Property="ToolTipService.InitialShowDelay"
                                            Value="250"/>
                                    <Setter Property="ToolTip" Value="{Binding Name}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <!-- TWO STATES, TWO CHANNELS.
                                                     Both were borders at first
                                                     and they fought: the trigger
                                                     that ran last won, so the
                                                     selected cell could not show
                                                     hover at all, and a row of
                                                     outlines blinking on and off
                                                     under the cursor sat right
                                                     next to the one outline that
                                                     was supposed to mean
                                                     something (confusing as it stood,
                                                     user 2026-08-10).

                                                     Selection keeps the line -
                                                     it is the state that must
                                                     survive the mouse being
                                                     somewhere else entirely.
                                                     Hover became BRIGHTNESS,
                                                     which is a channel the line
                                                     does not use, so the two now
                                                     stack instead of replacing
                                                     each other: the selected cell
                                                     lights up under the cursor
                                                     like every other one and
                                                     keeps its frame.

                                                     The wash goes over the whole
                                                     cell rather than the
                                                     letterbox alone - a picture
                                                     the same shape as its cell
                                                     leaves no letterbox, and a
                                                     hover that only some cells
                                                     can show is worse than the
                                                     borders were. -->
                                                <!-- THE NAME GOES UNDER THE FRAME,
                                                     not inside it (2026-09-28, on
                                                     request). The frame and its two
                                                     hairlines are drawn against the
                                                     picture's own edge, and a name
                                                     inside would put the selection
                                                     ring round a line of text too.
                                                     Its width is the frame's, set
                                                     rather than left to the text: in
                                                     the bar nothing else limits a
                                                     cell's width, and a long name
                                                     would have widened its cell.
                                                     Height and visibility come from
                                                     ApplyFilmstripCellSize, which
                                                     also adds the line to the
                                                     footprint every row is laid out
                                                     from - one place, so the list's
                                                     height and the rows cannot
                                                     disagree about it. -->
                                                <StackPanel>
                                                <Border x:Name="Frame"
                                                        BorderThickness="2"
                                                        BorderBrush="Transparent"
                                                        Background="#14808080"
                                                        SnapsToDevicePixels="True">
                                                    <Grid>
                                                        <ContentPresenter x:Name="Cell"/>
                                                        <Border x:Name="Wash"
                                                                Background="Transparent"
                                                                IsHitTestVisible="False"/>
                                                        <!-- WHAT THE FRAME COULD
                                                             NOT DO ON ITS OWN.
                                                             The frame's inner
                                                             face touches the
                                                             picture (the 2px is
                                                             all that separates
                                                             them), so a chosen
                                                             colour lands on a
                                                             photo of that colour
                                                             and there is nothing
                                                             left to see - and
                                                             the palette is the
                                                             user's, so "pick a
                                                             brighter one" is not
                                                             an answer. Two
                                                             hairlines, light and
                                                             dark, laid over the
                                                             picture's outermost
                                                             pixels: whatever the
                                                             photo is, it cannot
                                                             be both, so one of
                                                             them always shows.
                                                             The same principle
                                                             the mark badge uses
                                                             - bring your own
                                                             ground - spent on a
                                                             line instead of a
                                                             block.

                                                             OVERLAID, not nested,
                                                             and that is the whole
                                                             reason it costs
                                                             nothing: a border
                                                             that took its own
                                                             2px would resize
                                                             every picture the
                                                             moment it was
                                                             selected, and
                                                             FilmstripCellAdvance
                                                             would have to be
                                                             taught about it.
                                                             These cover two
                                                             pixels of picture
                                                             while selected and
                                                             move nothing.

                                                             Fixed colours, not
                                                             theme brushes: what
                                                             they have to read
                                                             against is a
                                                             photograph, which no
                                                             theme knows
                                                             anything about. -->
                                                        <Border x:Name="RingInner"
                                                                BorderThickness="1"
                                                                BorderBrush="Transparent"
                                                                Margin="1"
                                                                SnapsToDevicePixels="True"
                                                                IsHitTestVisible="False"/>
                                                        <Border x:Name="RingOuter"
                                                                BorderThickness="1"
                                                                BorderBrush="Transparent"
                                                                SnapsToDevicePixels="True"
                                                                IsHitTestVisible="False"/>
                                                    </Grid>
                                                </Border>
                                                <Grid>
                                                <!-- The tree's file-name ink, one
                                                     size step down (smaller, never
                                                     dimmer). The full name stays in
                                                     the container's tooltip. -->
                                                <TextBlock x:Name="CellName"
                                                        Text="{Binding Name}"
                                                        Width="{DynamicResource FilmstripCellFrameWidth}"
                                                        Height="{DynamicResource FilmstripNameLineHeight}"
                                                        Visibility="{DynamicResource FilmstripNameVisibility}"
                                                        FontSize="{DynamicResource MenuChipFontSize}"
                                                        Foreground="{DynamicResource FileNameForeground}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextAlignment="Center"/>
                                                <!-- THE RENAME BOX (2026-09-28), laid
                                                     over the name line while
                                                     FilmstripCell.IsEditing. In a
                                                     Canvas so it can be WIDER than the
                                                     cell: at the list's default size a
                                                     cell is about 130px, which cuts an
                                                     ordinary camera file name in two.
                                                     The Canvas measures as nothing, so
                                                     the line's height and every row
                                                     laid out from it stay as they are;
                                                     the width and the offset that keep
                                                     the box inside the list are set
                                                     when it opens
                                                     (PlaceFilmstripNameEditBox), and
                                                     the container is lifted above its
                                                     neighbours while it is open (the
                                                     style trigger below) so the next
                                                     cell does not draw over it.
                                                     The tree's rename box's colours,
                                                     for the same reasons given there,
                                                     and the name line's size, so the
                                                     text does not jump when the box
                                                     replaces the label. -->
                                                <Canvas>
                                                    <TextBox x:Name="CellNameEditBox"
                                                            Text="{Binding EditingName, UpdateSourceTrigger=PropertyChanged}"
                                                            Visibility="Collapsed"
                                                            FontSize="{DynamicResource MenuChipFontSize}"
                                                            Background="{DynamicResource ControlBackground}"
                                                            Foreground="{DynamicResource DialogForeground}"
                                                            CaretBrush="{DynamicResource ForegroundText}"
                                                            BorderBrush="{DynamicResource PanelBorder}"
                                                            BorderThickness="1"
                                                            Padding="2,0"
                                                            IsVisibleChanged="FilmstripNameEditBox_IsVisibleChanged"
                                                            KeyDown="FilmstripNameEditBox_KeyDown"
                                                            LostFocus="FilmstripNameEditBox_LostFocus"
                                                            Loaded="RenameTextBox_Loaded"/>
                                                </Canvas>
                                                </Grid>
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <!-- Hover is TWO faint things
                                                         rather than one strong
                                                         one, and they cover each
                                                         other's blind side. A
                                                         white wash reads on a
                                                         dark picture and vanishes
                                                         on a bright one; taking a
                                                         little opacity off the
                                                         cell lets the panel's own
                                                         dark ground through,
                                                         which dulls a BRIGHT
                                                         picture and barely
                                                         touches a dark one. So
                                                         whichever the frame is,
                                                         something moves - and
                                                         both are gentler than the
                                                         single 15% wash they
                                                         replace ("지금은 좀
                                                         강해서요", user
                                                         2026-08-10).

                                                         Per-PIXEL adaptation - a
                                                         wash that knows it is
                                                         over a white sky - would
                                                         need a blend mode, which
                                                         in WPF means a compiled
                                                         pixel shader on every
                                                         cell. Not for a hover.

                                                         Opacity here is a
                                                         composition-stage
                                                         property: no layout, no
                                                         re-decode, nothing per
                                                         frame. (And not the
                                                         dimmed-text rule - this
                                                         is a pointer state on a
                                                         picture, not a way of
                                                         calling something
                                                         secondary.) -->
                                                    <!-- RAISED A STEP ON BOTH
                                                         CHANNELS (2026-08-24),
                                                         because the ring below
                                                         got its two hairlines
                                                         and the hover was then
                                                         the faint one next to
                                                         it. Both, not one: the
                                                         single 15% wash this
                                                         pair replaced was the
                                                         thing called too strong,
                                                         and putting it all back
                                                         into the wash would walk
                                                         straight into that
                                                         again. 10% and 0.89
                                                         leaves each channel
                                                         below where it was
                                                         judged, and the pair
                                                         above where it was. -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Wash"
                                                                Property="Background"
                                                                Value="#1AFFFFFF"/>
                                                        <Setter TargetName="Cell"
                                                                Property="Opacity"
                                                                Value="0.89"/>
                                                    </Trigger>
                                                    <!-- The tree's OWN selection
                                                         colour, not a separate
                                                         accent: the strip and
                                                         the tree are showing the
                                                         same selection, so it
                                                         would be odd for the two
                                                         to mark it in different
                                                         colours - and this one
                                                         follows 색상 설정, so it
                                                         is the colour the user
                                                         actually chose to mean
                                                         "this one" (
                                                         2026-08-10). A border
                                                         here rather than a fill,
                                                         because a fill behind a
                                                         picture that covers its
                                                         cell would never be
                                                         seen. -->
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Frame"
                                                                Property="BorderBrush"
                                                                Value="{DynamicResource TreeRowSelectedActiveBackground}"/>
                                                        <!-- Dark against the
                                                             picture, light
                                                             against the chosen
                                                             colour, in that
                                                             order: the pair has
                                                             to survive a photo
                                                             on one side and a
                                                             palette on the
                                                             other, and each line
                                                             is the answer to the
                                                             side it faces.
                                                             Neither is opaque -
                                                             a full black edge
