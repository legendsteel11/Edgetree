                        <!-- History dropdown. StaysOpen=False closes it on an
                             outside click; selection is handled in code. -->
                        <Popup x:Name="SearchHistoryPopup"
                                PlacementTarget="{Binding ElementName=SearchBox}"
                                Placement="Bottom"
                                StaysOpen="False"
                                AllowsTransparency="True"
                                PopupAnimation="Fade">
                            <Border Background="{DynamicResource PanelBackground}"
                                    BorderBrush="{DynamicResource PanelBorder}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    MinWidth="180"
                                    Effect="{DynamicResource MenuDropShadow}"
                                    Margin="0,2,8,8">
                                <!-- Same overlay scrollbar as every other list in
                                     the app: this dropdown was the last place
                                     still falling back to the stock Windows bar
                                     (arrows and all), which is exactly what
                                     FavoritesListBoxStyle exists to replace. -->
                                <ListBox x:Name="SearchHistoryList"
                                        Style="{StaticResource FavoritesListBoxStyle}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        MaxHeight="220"
                                        Padding="2"
                                        ItemContainerStyle="{StaticResource PopupListItemStyle}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        ScrollViewer.CanContentScroll="False"
                                        PreviewMouseLeftButtonUp="SearchHistoryList_PreviewMouseLeftButtonUp">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                        Text="{Binding}"
                                                        Foreground="{DynamicResource DialogForeground}"
                                                        FontSize="12"
                                                        VerticalAlignment="Center"
                                                        TextTrimming="CharacterEllipsis"/>
                                                <!-- Per-entry delete. Handled on its own Click;
                                                     the list's PreviewMouseLeftButtonUp skips
                                                     clicks that land on a Button so this doesn't
                                                     also fill the search box. -->
                                                <Button Grid.Column="1"
                                                        Width="18"
                                                        Height="18"
                                                        Margin="6,0,0,0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Cursor="Hand"
                                                        ToolTip="{x:Static services:Strings.SearchHistoryDeleteTooltip}"
                                                        Click="SearchHistoryDelete_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd"
                                                                    Background="Transparent"
                                                                    CornerRadius="3">
                                                                <Path Data="M3,3 L9,9 M9,3 L3,9"
                                                                        Stroke="{DynamicResource SecondaryForeground}"
                                                                        StrokeThickness="1.3"
                                                                        StrokeStartLineCap="Round"
                                                                        StrokeEndLineCap="Round"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver"
                                                                        Value="True">
                                                                    <Setter TargetName="Bd"
                                                                            Property="Background"
                                                                            Value="{DynamicResource HoverBackground}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>

                </StackPanel>

                <!-- Status line: scanning progress / result count / hints.
                     Single line by design - this panel is narrow enough that
                     wrapping costs a whole second row for text that's usually
                     transient, so the strings are kept short instead and the
                     ellipsis below is only a backstop for the narrowest widths
                     (CharacterEllipsis, NOT MiddleEllipsis - that one compiles
                     but throws at runtime when the XAML is parsed). -->
                <StackPanel Grid.Row="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SearchStatusText"
                                Grid.Column="0"
                                Text="{x:Static services:Strings.SearchStatusEmpty}"
                                Foreground="{DynamicResource ShowMoreForeground}"
                                FontSize="11"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                Margin="10,6,10,4"/>
                        <!-- Reindex sits at the end of the line it acts on. The
                             blue dot (not a blue glyph) says a change has been
                             seen inside the searched folder since this index was
                             built - see UpdateSearchRefreshIndicator. Same fixed
                             mid-blue as the bookmark ribbon and the update dot,
                             so "the app is pointing at something" stays one
                             colour rather than three. -->
                        <Button x:Name="SearchRefreshButton"
                                Grid.Column="1"
                                Style="{StaticResource ToggleButtonStyle}"
                                Width="24"
                                Height="20"
                                Margin="0,0,6,2"
                                VerticalAlignment="Center"
                                Click="SearchRefreshButton_Click"
                                ToolTip="{x:Static services:Strings.SearchTooltipRefresh}">
                            <Grid Width="15"
                                    Height="15">
                                <!-- Material Symbols "refresh" (
                                     2026-08-10). One path where this was an arc
                                     plus a separate arrowhead triangle - two
                                     shapes that had to be kept meeting each
                                     other by hand at every size. -->
                                <Path Data="M480-192q-120 0-204-84t-84-204q0-120 84-204t204-84q65 0 120.5 27t95.5 72v-99h72v240H528v-72h131q-29-44-76-70t-103-26q-90 0-153 63t-63 153q0 90 63 153t153 63q84 0 144-55.5T693-456h74q-9 112-91 188t-196 76Z M0-960H960M0 0H960"
                                        Fill="{DynamicResource ForegroundText}"
                                        Stretch="Uniform"
                                        Width="{DynamicResource HeaderGlyphBox}"
                                        Height="{DynamicResource HeaderGlyphBox}"/>
                                <!-- Pushed clear of the glyph (and a touch
                                     bigger): sitting against the arc it read as
                                     part of the drawing rather than as a mark on
                                     it. The button has the room - a 15px glyph
                                     in a 24x20 button leaves 4.5px each side. -->
                                <Ellipse x:Name="SearchRefreshStaleDot"
                                        Width="6"
                                        Height="6"
                                        Fill="#FF4A90E2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,-3,-2"
                                        Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                    </Grid>
                    <!-- Below the status line, not above it. The results list's
                         own scrollbar lane draws a vertical divider down its
                         left edge (see MinimalScrollViewerTemplate), and that
                         line starts where the list starts - so a horizontal
                         divider sitting above the status text left the two
                         lines offset by the height of that text instead of
                         meeting in a corner. -->
                    <Border Height="1"
                            Background="{DynamicResource PanelDividerBrush}"/>
                    <!-- The pulsing progress bar that used to live here was
                         removed deliberately. A running indicator is the
                         universal idiom for "wait, don't touch anything" - and
                         search results actually stream in *during* the scan, so
                         it was talking users out of the one thing they could
                         already do. The status line's own live count carries
                         the "something is happening" job on its own, and now
                         says outright that searching already works. -->
                </StackPanel>

                <!-- Results: two lines per entry - dim italic folder path over
                     the filename. A single click previews the row in the image
                     panel and leaves the list standing; a double click goes to
                     it in the tree, which is what a single click did before the
                     panel existed (see SearchResultsList_PreviewMouseLeftButtonUp
                     and PreviewSearchResult). With the panel closed a single
                     click still goes to the tree, unless 자동 펼치기 is on and
                     the file is one the panel can show: then the click opens
                     the panel and the list stays (2026-10-06). -->
                <ListBox x:Name="SearchResultsList"
                        Grid.Row="2"
                        Style="{StaticResource FavoritesListBoxStyle}"
                        Background="{DynamicResource SidebarBackground}"
                        BorderThickness="0"
                        Padding="6,2,4,6"
                        ItemContainerStyle="{StaticResource SearchResultItemStyle}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        PreviewMouseLeftButtonDown="SearchResultsList_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="SearchResultsList_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="SearchResultsList_PreviewMouseLeftButtonUp"
                        PreviewMouseRightButtonDown="SearchResultsList_PreviewMouseRightButtonDown"
                        SelectionChanged="SearchResultsList_SelectionChanged"
                        KeyDown="SearchResultsList_KeyDown">
                    <ListBox.ItemTemplate>
                        <!-- One row is either a folder header or a file (see
                             Models/SearchRow). IsHeader swaps which line shows:
                             the folder path once, or an indented filename under
                             it. -->
                        <DataTemplate>
                            <Grid>
                                <!-- Folder header: folder icon (gated by the
                                     same ShowFolderIcons toggle as the tree) +
                                     path. -->
                                <StackPanel x:Name="HeaderPanel"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed">
                                    <Image Source="{Binding Icon}"
                                            Width="{DynamicResource IconSize}"
                                            Height="{DynamicResource IconSize}"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Visibility="{DynamicResource FolderIconVisibility}"
                                            RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding DirectoryPath}"
                                            Foreground="{DynamicResource FolderNameForeground}"
                                            FontStyle="Italic"
                                            FontSize="{DynamicResource SearchHeaderFontSize}"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <!-- File row: per-extension file icon (gated by
                                     ShowFileIcons) + name, indented under the
                                     folder header - and, while 폴더별 묶기 is off
                                     and there is no header to indent under, the
                                     folder itself at the end of the line.

                                     A Grid rather than the StackPanel this was,
                                     and TWO EQUAL STAR COLUMNS rather than the
                                     Auto+star it was built as on 2026-08-31.
                                     Auto sized the name column to each row's own
                                     filename, so the folder started at a
                                     different x on every line and the column
                                     could not be read down (author's screenshot,
                                     the same day). Splitting the space by ratio
                                     gives the folder ONE left edge for the whole
                                     list, and both halves grow with the panel;
                                     whichever side runs out ellipsises on its
                                     own. The 1:1 is the only number here - a
                                     name that outgrows its half trims while the
                                     folder column still has room, which is the
                                     price of the straight edge. That price is
                                     paid ONLY while the folder is on screen: see
                                     SearchRowName's column span. -->
                                <Grid x:Name="FilePanel"
                                        Margin="14,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Cut marks bound as VALUES (SearchRow's
                                         CutOpacity / CutFontStyle), not as
                                         triggers: triggers here applied when a
                                         row was built but did not repaint a row
                                         already on screen when the mark changed
                                         under it. See the note on those
                                         properties. -->
                                    <Image x:Name="SearchRowIcon"
                                            Grid.Column="0"
                                            Source="{Binding Icon}"
                                            Opacity="{Binding CutOpacity}"
                                            Width="{DynamicResource IconSize}"
                                            Height="{DynamicResource IconSize}"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Visibility="{DynamicResource FileIconVisibility}"
                                            RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <!-- Inlines built by SearchHighlightBehavior
                                         (matched run in the highlight color)
                                         instead of a plain Text binding. -->
                                    <!-- Spans BOTH star columns by default, so
                                         with 폴더별 묶기 on - the folder column
                                         collapsed and the whole row empty beside
                                         the name - a long filename still gets
                                         the full width. Without the span it took
                                         one star and ellipsised at half the
                                         panel with nothing to its right
                                         (2026-08-31, seen in the author's own
                                         grouped screenshot). The ShowsFolder
                                         trigger below takes the span back to 1.
                                         Carried by a span rather than by
                                         swapping the ColumnDefinition's width,
                                         because a Setter on a named
                                         FrameworkElement is the mechanism this
                                         template already proves works. -->
                                    <TextBlock x:Name="SearchRowName"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            local:SearchHighlightBehavior.Row="{Binding}"
                                            Foreground="{DynamicResource FileNameForeground}"
                                            FontSize="{DynamicResource SearchFileFontSize}"
                                            FontStyle="{Binding CutFontStyle}"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"/>
                                    <!-- The header's font, one step down from
                                         the name, and the user's own folder
                                         colour taken a step towards the
                                         background - the same derived brush a
                                         hidden or cut row uses, not a second
                                         alpha over the live one (this app never
                                         dims text to mark it secondary). In the
                                         full folder colour it read at the same
                                         weight as the filename beside it and the
                                         eye had nothing to land on first
                                         (2026-08-31). MutedFolderNameForeground
                                         follows whatever palette is picked, so
                                         no colour row had to be invented for
                                         one line of text. -->
                                    <TextBlock x:Name="SearchRowFolder"
                                            Grid.Column="2"
                                            Text="{Binding DirectoryPath}"
                                            Foreground="{DynamicResource MutedFolderNameForeground}"
                                            FontSize="{DynamicResource SearchHeaderFontSize}"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="Collapsed"/>
                                </Grid>
                                <!-- "… 더 보기 (N개)" - clickable, raises the page
                                     limit (SearchResultsList_PreviewMouseLeftButtonUp). -->
                                <TextBlock x:Name="ShowMoreText"
                                        Text="{Binding ShowMoreLabel}"
                                        Foreground="{DynamicResource ShowMoreForeground}"
                                        FontStyle="Italic"
                                        FontWeight="Normal"
                                        FontSize="{DynamicResource SearchHeaderFontSize}"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsHeader}"
                                        Value="True">
                                    <Setter TargetName="HeaderPanel"
                                            Property="Visibility"
                                            Value="Visible"/>
                                    <Setter TargetName="FilePanel"
                                            Property="Visibility"
                                            Value="Collapsed"/>
                                </DataTrigger>
                                <!-- No header stands over this row, so the
                                     indent has nothing to indent under and the
                                     folder comes back onto the row itself. -->
                                <DataTrigger Binding="{Binding ShowsFolder}"
                                        Value="True">
                                    <Setter TargetName="FilePanel"
                                            Property="Margin"
                                            Value="0"/>
                                    <Setter TargetName="SearchRowName"
                                            Property="Grid.ColumnSpan"
                                            Value="1"/>
                                    <Setter TargetName="SearchRowFolder"
                                            Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsShowMore}"
                                        Value="True">
                                    <Setter TargetName="FilePanel"
                                            Property="Visibility"
                                            Value="Collapsed"/>
                                    <Setter TargetName="ShowMoreText"
                                            Property="Visibility"
                                            Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Where the path strip goes while search is up. The strip is
                     ONE control that moves between here and the footer
                     (MovePathBarInto) rather than a second copy: every bit of
                     its behaviour - the dirty flag, the deepest-existing-path
                     walk, the click-away reset - hangs off that one box, and a
                     twin would have needed all of it parameterised to stay
                     honest.
                     Reparented because the search view covers the footer it
                     normally lives in (rows 1-4), and the footer stays covered
                     on purpose: the filter chips beside it act on the TREE, and
                     leaving them showing over a result list would read as
                     though they were filtering it. -->
                <Border x:Name="SearchPathBarHost"
                        Grid.Row="3"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource PanelDividerBrush}"
                        Visibility="Collapsed"/>
            </Grid>

            <!-- The image viewer panel (round 1). Lives in one of the two
                 zero-width outer columns declared at the top of this grid;
                 OpenViewer picks which (screen-interior side), sizes the
                 column and widens the window by the same amount, so opening
                 it never takes a pixel from the tree. Below the header row
                 only - the header spans all three columns above it. The
                 divider border side is set in code to face the tree. -->
            <!-- TWO PIXELS OFF THE TOP, and they are the header divider's
                 (2026-08-11). That line is drawn 2px below the header row on
                 purpose, so it lands inside whatever sits at the top of row 1 -
                 on the tree's side that is a list's background and nobody ever
                 saw it, but here a zoomed picture reaches the panel's own top
                 edge and the line lay ON the photograph. The inset puts the
                 panel's backdrop under the line instead, so it reads as a
                 boundary above the picture rather than a scratch across it.
                 Full screen clears this along with the border and the margins -
                 see SetViewerFullscreen, where every pixel goes back to the
                 picture.
                 This edge FOLLOWS 영역 구분선, unlike the thumbnail strip's -
                 see the strip's own host for the asymmetry and why it was
                 chosen (2026-08-26). The split has a collapse chevron riding it
                 that says where it is even with the line switched off, which is
                 the other half of the reason. -->
            <Border x:Name="ViewerPanel"
                    Grid.Row="1"
                    Grid.RowSpan="5"
                    Grid.Column="2"
                    Visibility="Collapsed"
                    Padding="0,2,0,0"
                    Background="{DynamicResource ViewerBackground}"
                    BorderBrush="{DynamicResource PanelDividerBrush}"
                    BorderThickness="1,0,0,0"
                    PreviewMouseDown="ViewerPanel_PreviewMouseDown"
                    PreviewMouseMove="ViewerPanel_PreviewMouseMove"
                    MouseLeave="ViewerPanel_MouseLeave">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <!-- THE CAPTION SITS AGAINST THE PICTURE, and the strip
                             below both (2026-08-22, on report). It says what the
                             picture IS - name, size, date, the carousel's place
                             in the folder - so with the strip in between, the
                             answer and the thing it answers about were a
                             hundred pixels and a grid of other pictures apart:
                             "시선이 많이 분산됨".
                             The strip goes last, where a thing you pick FROM
                             belongs: everything above it is the one file, and
                             everything in it is the choice of another. -->
                        <RowDefinition Height="Auto"/>
                        <!-- The filmstrip. Auto, and collapsed when the strip is
                             off, so a viewer without one lays out exactly as it
                             did before this row existed. -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Zoom and pan (round 2) ride entirely on the Image's
                         RenderTransform - no re-layout and no re-decode in a
                         frame, which is the standing rule for anything that
                         runs while the mouse is moving. Stretch stays Uniform,
                         so WPF keeps doing the fit arithmetic for us and the
                         scale factor below is measured RELATIVE to fit: 1.0 is
                         the rest state, and 1:1 is whatever number makes the
                         bitmap's own pixels line up. The host Border is what
                         clips the zoomed-in image to the panel and what the
                         wheel and the drag listen on (an Image only gets mouse
                         events where it has actually drawn pixels, so the
                         letterboxed margins beside a wide picture would be
                         dead to both). -->
                    <Border x:Name="ViewerImageHost"
                            Grid.Row="0"
                            ClipToBounds="True"
                            Background="Transparent"
                            SizeChanged="ViewerImageHost_SizeChanged"
                            MouseEnter="ViewerPictureHover_Changed"
                            MouseLeave="ViewerPictureHover_Changed"
                            MouseWheel="ViewerImageHost_MouseWheel"
                            MouseDown="ViewerImageHost_MouseDown"
                            MouseLeftButtonDown="ViewerImageHost_MouseLeftButtonDown"
                            MouseMove="ViewerImageHost_MouseMove"
                            MouseLeftButtonUp="ViewerImageHost_MouseLeftButtonUp"
                            LostMouseCapture="ViewerImageHost_LostMouseCapture"
                            ContextMenuOpening="ViewerImageHost_ContextMenuOpening">
                        <!-- The picture's own right-click menu. Every file
                             action is the ROW menu's handler unchanged - the
                             viewer shows the tree's selection, so the row they
                             act on IS the picture on screen; the opening
                             handler suppresses the menu whenever that stops
                             being true (empty panel, icon fallback, or a
                             multi-selection, whose count the tree menu is the
                             one to announce). 배경 설정 is the one item of its
                             own, and only offered on a picture WIC actually
                             decoded (not a shell preview of a video/PSD). -->
                        <Border.ContextMenu>
                            <ContextMenu Style="{StaticResource DarkContextMenuStyle}"
                                    Opened="AnyMenu_Opened"
                                    Closed="AnyMenu_Closed"
                                    PreviewMouseRightButtonUp="ContextMenu_PreviewMouseRightButtonUp">
                                <!-- NOT the tree's bare "열기" (2026-08-11). In
                                     the tree that word is exactly right - it is
                                     Explorer's own verb and the row is not
                                     showing you anything yet. Here the file is
                                     already open, on the screen, being watched
                                     - so "열기" has nothing left to mean except
                                     "open something", which reads as a file
                                     dialog about to appear.
                                     Naming the destination fixes it, and the
                                     phrase is already in the app twice: the
                                     transport row's own external button and the
                                     line shown when a format will not play. The
                                     row below it (연결 프로그램) then reads as
                                     the pair it is - default, or choose.

                                     No "Enter" gesture on it: while a decoded
                                     image is showing, Enter is the full-screen
                                     toggle. -->
                                <!-- Tag="file" ON EVERY ROW THAT ACTS ON THE FILE,
                                     here and in the group near the bottom. The
                                     full cover collapses exactly these and
                                     nothing else (see ViewerImageHost_Context-
                                     MenuOpening): what is on screen is being
                                     watched there, and cutting or renaming it is
                                     not part of watching - while playing,
                                     seeking, subtitles and marks are, and that
                                     menu is the only way to reach them once the
                                     header has gone.
                                     A tag rather than a list of names in code:
                                     the next row added here says for itself
                                     which side it is on, in the place someone
                                     adding it is already looking. -->
                                <MenuItem Header="{x:Static services:Strings.ViewerOpenExternally}"
                                        Tag="file"
                                        Click="OpenItem_Click"/>
                                <MenuItem x:Name="ViewerOpenWithItem"
                                        Header="{x:Static services:Strings.MenuOpenWith}"
                                        Tag="file"
                                        Click="OpenWithPicker_Click"/>
                                <MenuItem x:Name="ViewerSetWallpaperItem"
                                        Header="{x:Static services:Strings.MenuSetWallpaper}"
                                        Tag="file"
                                        Click="ViewerSetWallpaper_Click"/>
                                <!-- The playback group, shown only while a film
                                     is up. Play/pause and back-to-start are
                                     here as well as in the strip because a
                                     right-click is where a hand already is when
                                     the strip is at the other end of a tall
                                     panel - and because a menu that offers to
                                     mark a position while offering no way to
                                     start the film again reads as half a menu. -->
                                <Separator x:Name="ViewerPlaybackSeparator"
                                        Visibility="Collapsed"/>
                                <!-- The bookmarks come FIRST and are fenced off
                                     on their own (2026-08-11). They are the one
                                     thing in this menu that is about THIS film
                                     rather than about playing it - marking a
                                     place is a decision, where play, rewind,
                                     size and subtitles are all the same act of
                                     watching. Fencing them also puts the row a
                                     hand comes here for at the top of the
                                     group, instead of below four rows the strip
                                     already carries. -->
                                <MenuItem x:Name="ViewerMarkAddItem"
                                        Header="{x:Static services:Strings.ViewerMarkAdd}"
                                        InputGestureText="P · Insert"
                                        Click="ViewerMediaMark_Click"
                                        Visibility="Collapsed"/>
                                <!-- The film's own marks. Built when the menu
                                     opens (ViewerMarkSubmenu_Opened) and shown
                                     only for a video that has any - a submenu
                                     that is always there and usually empty is a
                                     row of nothing to read past. -->
                                <MenuItem x:Name="ViewerMarkListItem"
                                        Header="{x:Static services:Strings.ViewerMarkList}"
                                        SubmenuOpened="ViewerMarkSubmenu_Opened"
                                        Visibility="Collapsed">
                                    <MenuItem Header=""/>
                                </MenuItem>
                                <Separator x:Name="ViewerMarkSeparator"
                                        Visibility="Collapsed"/>
                                <MenuItem x:Name="ViewerPlayPauseItem"
                                        Header="{x:Static services:Strings.ViewerPlay}"
                                        InputGestureText="Space"
                                        Click="ViewerMediaPlayPause_Click"
                                        Visibility="Collapsed"/>
                                <MenuItem x:Name="ViewerRewindItem"
                                        Header="{x:Static services:Strings.ViewerRewind}"
                                        InputGestureText="Home"
                                        Click="ViewerMediaRewind_Click"
                                        Visibility="Collapsed"/>
                                <!-- The film's zoom, HERE and not in the strip:
                                     the transport row is full, and the zoom
                                     strip it would have joined is the one the
                                     transport row replaces (the two describe
                                     the same picture in ways that can't both
                                     apply). A menu row costs nothing until it
                                     is opened. StaysOpenOnClick so stepping
                                     through 50 → 75 → 100 is one visit rather
                                     than three; the numpad's +/- do the same
                                     job without opening anything. -->
                                <MenuItem x:Name="ViewerMediaZoomItem"
                                        StaysOpenOnClick="True"
                                        Focusable="False"
                                        Padding="{DynamicResource MenuStepperRowPadding}"
                                        Visibility="Collapsed">
                                    <!-- MenuRowActionButtonStyle, not the
                                         footer's chip style: a chip carries the
                                         footer's own ink at 0.65, and inside a
                                         popup that resolves against the VIEWER
                                         panel's derived inks - so the row came
                                         out barely legible on the menu's own
                                         surface (reported with a screenshot,
                                         2026-08-10). This style is the one the
                                         other in-menu buttons already use, and
                                         it takes MenuForeground.
                                         The leading label went with it: it said
                                         맞춤, which is also what the button at
                                         the far end says, so the row read as
                                         two of the same word around a number. -->
                                    <!-- Built exactly like the options menu's
                                         own steppers (글꼴 크기, 최대 항목 수):
                                         label on the left, the two boxed
                                         glyphs hard against each other on the
                                         right, MenuStepperButtonStyle for both.
                                         A first attempt used the menu's plain
                                         text-button style and it read as a
                                         different kind of control in the same
                                         menu (reported with a screenshot,
                                         2026-08-10) - one app, one stepper.

                                         No percentage between them, which is
                                         the one place this row departs from
                                         those two. The row stays open while it
                                         is stepped, and the readout is written
                                         by the zoom STRIP's update - which does
                                         not run while a film is up, because
                                         that strip is not on screen. A number
                                         that holds still while the picture
                                         grows is worse than no number, and the
                                         film itself is the readout. -->
                                    <MenuItem.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- The label is written in code
                                                 because the row serves both
                                                 media now (2026-08-16): a film
                                                 wherever it plays, and a
                                                 picture in the full cover,
                                                 where the zoom strip that
                                                 usually carries these is gone
                                                 with the rest of the chrome. -->
                                            <TextBlock x:Name="ViewerMediaZoomLabel"
                                                    Grid.Column="0"
                                                    Text="{x:Static services:Strings.ViewerZoom}"
                                                    Foreground="{DynamicResource MenuForeground}"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,8,0"/>
                                            <!-- 맞춤 sits in the slot the other
                                                 steppers give to the value, and
                                                 that is the right place for it:
                                                 what those rows READ OUT there,
                                                 this row lets you GO to. A
                                                 separate 맞춤 line underneath
                                                 was tried first and the pair
                                                 read as two unrelated controls
                                                 (2026-08-10). Auto width
                                                 on the middle one - the style's
                                                 square box is cut for a single
                                                 glyph. -->
                                            <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal">
                                                <!-- The SAME fit mark the zoom
                                                     strip carries (Material
                                                     Symbols "fit_screen"),
                                                     not the word it used to
                                                     be. One idea drawn one way
                                                     wherever it appears: the
                                                     chip and this row do the
                                                     same thing and now say it
                                                     with the same shape, and a
                                                     word between two glyph
                                                     steppers was the last
                                                     place in the viewer where
                                                     an action was spelled out
                                                     rather than drawn. -->
                                                <Button Style="{StaticResource MenuStepperButtonStyle}"
                                                        ToolTip="{x:Static services:Strings.ViewerZoomFit}"
                                                        Click="ViewerFitChip_Click"
                                                        Margin="{DynamicResource MenuChipGap}">
                                                    <Path Data="M792-576v-120H672v-72h120q30 0 51 21.15T864-696v120h-72Zm-696 0v-120q0-30 21.15-51T168-768h120v72H168v120H96Zm576 384v-72h120v-120h72v120q0 30-21.15 51T792-192H672Zm-504 0q-30 0-51-21.15T96-264v-120h72v120h120v72H168Zm72-144v-288h480v288H240Zm72-72h336v-144H312v144Zm0 0v-144 144Z"
                                                            Stretch="Uniform"
                                                            Width="{DynamicResource MenuChipFontSize}"
                                                            Height="{DynamicResource MenuChipFontSize}"
                                                            Fill="{Binding Foreground,
                                                                RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                </Button>
                                                <!-- Material Symbols
                                                     "view_real_size", the same
                                                     drawn 1:1 the strip's chip
                                                     carries. It replaced the
                                                     − and + steppers that used
                                                     to flank the fit mark
                                                     (2026-08-18, on request:
                                                     "여기서 확대 축소는 거의
                                                     안쓰고(휠이 있어서) 1:1이
                                                     더 필요할거 같긴 해요").
                                                     The wheel already zooms
                                                     wherever the picture is,
                                                     and a double-click already
                                                     swaps 맞춤 ↔ 1:1 - so the
                                                     steppers were the one
                                                     control here with a faster
                                                     way to reach it, while the
                                                     third rest state had none
                                                     at all in this row.
                                                     The row is now the SAME
                                                     THREE the panel's chips
                                                     are, in the same order:
                                                     one set of answers, drawn
                                                     one way, wherever the
                                                     question is asked. -->
                                                <Button Style="{StaticResource MenuStepperButtonStyle}"
                                                        ToolTip="{x:Static services:Strings.ViewerZoomActual}"
                                                        Click="ViewerActualChip_Click"
                                                        Margin="{DynamicResource MenuChipGap}">
                                                    <Path Data="M288-288v-312h-96v-72h168v384h-72Zm156 0v-72h72v72h-72Zm204 0v-312h-96v-72h168v384h-72ZM444-456v-72h72v72h-72Z"
                                                            Stretch="Uniform"
                                                            Width="{DynamicResource MenuChipFontSize}"
                                                            Height="{DynamicResource MenuChipFontSize}"
                                                            Fill="{Binding Foreground,
                                                                RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                </Button>
                                                <!-- 채우기, LAST now. It used to be first, to keep this
                                                     row from ending a box further right than the other
                                                     steppers in this menu (2026-08-16) - and that reason
                                                     left with the − and + on 2026-08-18. Nothing here is
                                                     a stepper any more, so the three are peers and they
                                                     stand in the order the panel's own chips do.
                                                     The SAME mark that chip wears (Material Symbols
                                                     "aspect_ratio") - one idea drawn one way wherever it
                                                     appears, which is the rule the two marks beside it
                                                     already follow. -->
                                                <Button x:Name="ViewerMediaFillButton"
                                                        Style="{StaticResource MenuStepperButtonStyle}"
                                                        ToolTip="{x:Static services:Strings.ViewerZoomFill}"
                                                        Click="ViewerMediaFill_Click">
                                                    <Path Data="M624-384h96v-96h-72v48h-24v48Zm-384 0h72v-48h24v-48h-96v96Zm0-96h96v-48h-24v-48h-72v96Zm384 0h72v-96h-96v48h24v48ZM168-192q-29.7 0-50.85-21.15Q96-234.3 96-264v-432q0-29.7 21.15-50.85Q138.3-768 168-768h624q29.7 0 50.85 21.15Q864-725.7 864-696v432q0 29.7-21.15 50.85Q821.7-192 792-192H168Zm0-72h624v-432H168v432Zm0 0v-432 432Z M0-960H960M0 0H960"
                                                            Stretch="Uniform"
                                                            Width="{DynamicResource MenuChipFontSize}"
                                                            Height="{DynamicResource MenuChipFontSize}"
                                                            Fill="{Binding Foreground,
                                                                RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <!-- THE SAME QUESTION FROM THE OTHER SIDE
                                     (2026-08-19, on request). The row above
                                     decides how the film sits inside the window;
                                     this one moves the window to the film, so it
                                     stands directly under it rather than as a
                                     fourth button in it - those three are all
                                     about the picture, and this one is not.
                                     Only the HEIGHT moves: the width is the one
                                     the user already set, and the height that
                                     gives it the film's own proportions is what
                                     takes the black bands away.
                                     The key is written beside it because the
                                     menu cannot be opened over a PLAYING film -
                                     the media element is this menu owner's
                                     sibling, so the click never walks past it -
                                     which leaves the row for a paused film and
                                     the key for the rest. 8 does the same thing
                                     and is deliberately not written here (the
                                     author's own hand, borrowed from another
                                     player). -->
                                <MenuItem x:Name="ViewerFitWindowItem"
                                        Header="{x:Static services:Strings.ViewerFitWindow}"
                                        InputGestureText="F"
                                        Visibility="Collapsed"
                                        Click="ViewerFitWindowMenuItem_Click"/>
                                <!-- The two things the panel draws AROUND a
                                     picture, brought here for the cover
                                     (2026-08-16, on report). Their switches are
                                     a chip on the zoom strip and a button beside
                                     the counter, and the cover takes both away
                                     with the rest of the chrome - so wanting
                                     either meant leaving the mode, pressing,
                                     and going back in, which is a round trip
                                     someone doing it often will feel.
                                     The navigator is a PICTURE's, and stays
                                     there. The strip lists the FOLDER, so it is
                                     on screen over a film and a track too - it
                                     was held back from them on the belief that
                                     it hides itself during playback, which
                                     UpdateFilmstrip disproves (2026-08-16).
                                     Their rows follow the size row above, which
                                     is the same kind of question about the same
                                     surface. -->
                                <MenuItem x:Name="ViewerNavigatorItem"
                                        Header="{x:Static services:Strings.ViewerNavigator}"
                                        IsCheckable="True"
                                        Visibility="Collapsed"
                                        Click="ViewerNavigatorMenuItem_Click"/>
                                <MenuItem x:Name="ViewerFilmstripItem"
                                        Header="{x:Static services:Strings.ViewerFilmstrip}"
                                        IsCheckable="True"
                                        Visibility="Collapsed"
                                        Click="ViewerFilmstripMenuItem_Click"/>
                                <!-- THE DOOR ITSELF (2026-08-17). The mode had
                                     one way in and out - middle-click on the
                                     picture - which is a thing you have to be
                                     told about, so the mode was invisible to
                                     anyone who had not been. The key stays; this
                                     row is for the first time.
                                     Directly above 바탕화면 채우기 because the two
                                     are a pair read downward: the mode, then how
                                     far it reaches. -->
                                <MenuItem x:Name="ViewerFullscreenItem"
                                        Header="{x:Static services:Strings.ViewerFullscreen}"
                                        InputGestureText="{x:Static services:Strings.GestureWheelClick}"
                                        IsCheckable="True"
                                        Visibility="Collapsed"
                                        Click="ViewerFullscreenMenuItem_Click"/>
                                <!-- HOW FAR 앱 전체화면 REACHES, in the mode where
                                     there is a choice (2026-08-17, the author's
                                     shape: keep the key, put the SCOPE on a
                                     toggle). A floating window can either give
                                     the picture the whole desktop or keep the
                                     window it is in; docked there is nothing to
                                     ask, so the row is not there.
                                     It takes effect at once rather than at the
                                     next crossing - the window grows or comes
                                     back while full screen stays on, which is
                                     what a toggle in front of the thing it
                                     changes should do. -->
                                <!-- The tooltip carries the ONE thing that
                                     separates this row from 전체화면 above it,
                                     because the label cannot (2026-08-27, from
                                     the English review): "바탕화면" hints at the
                                     area outside the taskbar, and "Fill desktop"
                                     does not hint at anything. -->
                                <MenuItem x:Name="ViewerFullDesktopItem"
                                        Header="{x:Static services:Strings.ViewerFullDesktop}"
                                        ToolTip="{x:Static services:Strings.ViewerFullDesktopHint}"
                                        IsCheckable="True"
                                        Visibility="Collapsed"
                                        Click="ViewerFullDesktopMenuItem_Click"/>
                                <!-- BELOW THE TWO FULL-SCREEN ROWS (2026-08-17).
                                     The 간격 stepper is a wide row with its own
                                     controls, and with the plain rows following
                                     it the group's left edge stepped in and out.
                                     Plain rows first, the stepper last, so the
                                     block reads as one column.
                                     슬라이드 쇼, on the picture rather than in
                                     the options menu (moved 2026-08-14, the
                                     user's call and the right one): it is a
                                     thing done TO the pictures on screen, and
                                     the hand is already here. Present only
                                     while there is a set to walk - two or more
                                     images in the folder - which is this
