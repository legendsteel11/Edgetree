            <!-- The panel's list. It shared this row with FavoritesList until
                 2026-08-17, when the two lists became one - see
                 AppSettings.MergeFavoritesIntoBookmarks for why. In "none" mode
                 it is collapsed (MainWindow.xaml.cs's ApplySidePanelMode). -->
            <ListBox x:Name="BookmarkPanelList"
                    Grid.Row="2"
                    Grid.Column="1"
                    Style="{StaticResource FavoritesListBoxStyle}"
                    Background="{DynamicResource FavoritesBackground}"
                    BorderThickness="0"
                    Padding="4,6,4,4"
                    FontSize="{Binding FontSize, ElementName=ExplorerTree}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ItemContainerStyle="{StaticResource BookmarkPanelItemStyle}"
                    Visibility="Collapsed"
                    PreviewMouseLeftButtonDown="BookmarkPanelList_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="BookmarkPanelList_PreviewMouseMove"
                    PreviewMouseLeftButtonUp="BookmarkPanelList_PreviewMouseLeftButtonUp"
                    LostMouseCapture="BookmarkPanelList_LostMouseCapture"/>

            <!-- Where a dragged bookmark would land. Sits over the list rather
                 than inside the item template so it can be drawn BETWEEN two
                 rows, and never takes a hit-test - the drag needs every mouse
                 event to keep reaching the list underneath. Positioned from
                 code (북마크 드래그 재정렬 region). -->
            <Border x:Name="BookmarkDropIndicator"
                    Grid.Row="2"
                    Grid.Column="1"
                    Height="2"
                    Margin="0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource AccentForeground}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed"/>

            <!-- The splitter row's VISIBLE part is exactly this 1px divider -
                 which is why the tree's scrollbar (and first row) start flush
                 beneath the line. The line used to be FavoritesList's own
                 bottom border with the transparent grab zone taking 4px of
                 real space after it, leaving a visible gap between the line
                 and everything below. Position-mode flipping of that border
                 is gone too: the line IS the boundary now, same on either
                 side. -->
            <!-- Back to 1px, matching every other section divider (
                 2026-08-08). It spent 08-04~08-08 at 2px ("a hairline between
                 two alike lists read as a gap"), but once the viewer panel
                 added another 1px line the odd one out was this one. The
                 splitter's grab zone is unaffected - it floats over this row
                 at a fixed 9px and simply centres on whatever height the
                 line takes. -->
            <!-- This one FOLLOWS 영역 구분선, unlike the strip's edge, and that
                 asymmetry was chosen rather than arrived at (2026-08-26). The
                 strip's boundary earns its exemption because the rows above it
                 stack up - carousel, name, metadata, zoom, transport - and one
                 more horizontal line among a dozen is not findable. Nothing
                 stacks either side of this one; there is a list, a line, and a
                 list. -->
            <Border Grid.Row="3"
                    Grid.Column="1"
                    Height="1"
                    Background="{DynamicResource PanelDividerBrush}"/>
            <!-- Functionality unchanged (drag-resize, double-click fit); only
                 WHERE the grab zone lives did: negative margins float it over
                 the last few pixels of the panels on either side of the line
                 instead of occupying its own space (net desired height: 1px,
                 so the Auto row stays exactly the line). ZIndex wins the
                 overlapped strip's hit-testing from the rows beneath. -->
            <GridSplitter x:Name="FavoritesSplitter"
                    Grid.Row="3"
                    Grid.Column="1"
                    Height="9"
                    Margin="0,-4,0,-4"
                    Panel.ZIndex="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    ResizeDirection="Rows"
                    DragCompleted="FavoritesSplitter_DragCompleted"
                    MouseDoubleClick="FavoritesSplitter_MouseDoubleClick"/>

            <!-- ScrollUnit="Pixel": without it, ScrollUnit defaults to Item,
                 which with CanContentScroll=True (see ExplorerTreeViewStyle's
                 ScrollViewer) makes this root panel scroll in units of whole
                 drive-root items. An expanded C: rendering 2000px tall still
                 counts as exactly one unit there, so the scrollbar moved in a
                 few coarse steps and scroll offsets were meaningless as
                 pixels. Pixel makes the extent the actual rendered height.

                 CacheLength WAS "1000,1000" with CacheLengthUnit="Item", to
                 fix favorites navigation to a DIFFERENT drive: the walk failed
                 at its very first step, on the drive root itself - "step[0]
                 'E:' containerFound=False" until it gave up - because with C:
                 expanded taller than the viewport the E: row sits far outside
                 the default one-page cache, so ContainerFromItem returned null
                 for ever. Caching every drive root made it moot, and there are
                 only ever a handful of those, so it read as free.

                 IT WAS NOT FREE, AND IT REACHED FOLDERS. The value inherits,
                 and a nested panel does not read the attached property at all:
                 the parent panel hands each expanded container a
                 HierarchicalVirtualizationConstraints, and the cache length in
                 there is the parent's. Measured 2026-08-12 with both readings
                 side by side on a 2,405-item folder:

                   folder 1057 realized of 2405
                   local 1,1 Page   panel 1,1 Page
                   handed 1000,1000 Item   root 1000,1000 Item

                 So ExplorerTreeViewItemStyle's local re-set applied perfectly
                 and changed nothing, and a folder held 1,000 rows either side
                 of a 30-row viewport - which is the UI stall: realising +1000
                 rows costs 900-1900ms, and scrolling a big folder ran to 5.4
                 SECONDS in one step. Lowering the local number could never
                 have helped; the root's value is the only one anybody reads.

                 The drive-root miss is now fixed where it happens instead:
                 both walks call BringIndexIntoViewPublic on the items host
                 when a container is missing (RevealChainStep,
                 SelectVisibleItemStep), which realises the row on demand at
                 ANY level, root included. That fallback did not exist when the
                 cache was added. IF FAVORITES NAVIGATION TO ANOTHER DRIVE EVER
                 BREAKS AGAIN, look there first - not here. -->
            <!-- EXPERIMENT 2026-08-12, NOT a decision: VirtualizationMode was
                 Standard. Recycling reuses row containers as they scroll out of
                 view instead of discarding them, and a reused container whose
                 visual fails to refresh renders as a blank gap - one candidate
                 for the reported "rows disappear from the middle of the tree
                 until I click something", which is why it had never been tried.

                 It is tried now because two separate measurements point at the
                 same cost, and it is the only setting that addresses both.
                 Making a row container is what the window stops for (+500 rows
                 = 900-1900ms, releasing 1000 = 300ms), and dragging the scroll
                 thumb over a heavily expanded tree swings the realized count
                 between 191 and 2,935 - thousands of containers built and
                 thrown away per trip, which a forced collect showed to be
                 532MB of garbage in one minute of dragging. Recycling takes
                 containers from a pool rather than building them, so both the
                 pause and the debris come off the same lever.

                 IF BLANK ROWS APPEAR, this is the first thing to put back.

                 Also note: do NOT "fix" this by setting IsVirtualizing=False
                 here. That was tried; it silently un-virtualizes the ENTIRE
                 tree (the property inherits) and breaks scrolling app-wide. -->
            <!-- PUT BACK TO Standard the same day (2026-08-12). The experiment
                 went into 2.0.0 hours after it was written and cost a defect
                 within the day: a bookmark on ANOTHER DRIVE stopped reaching
                 the tree at all. The reveal walk holds a parent container
                 across dispatcher passes, and recycling hands that container
                 to a different row mid-walk - click.log caught it as
                 "itemIndex=-1 of 0", a drive row with no DataContext and no
                 children. RevealChainStep notices that now and re-walks from
                 the top, so the walk no longer depends on the mode either way.
                 The mode still goes back: it is an unmeasured change sitting
                 under every scroll in the app, and a release is not where it
                 gets its soak. Bring it in again with one, and with this
                 failure in the list of things to watch for. -->
            <!-- EXPERIMENT 2026-08-10, NOT a decision: ScrollUnit below was
                 "Pixel". In pixel mode the panel has to guess the height of
                 every row it hasn't realized, from the average of the ones it
                 has - and in a tree that average is meaningless, since a file
                 row is ~28px and an expanded folder's container is thousands.
                 Measured: the same folders reported 9,081px tall one moment and
                 36,072px the next, from ~290 realized rows out of ~1,200. Rows
                 arranged from those guesses land on top of each other, which is
                 what a filter toggle was showing for about a second.
                 Item mode has nothing to guess.
                 If this proves the cause, PinRowToTop and the bottom-gap
                 arithmetic must be reworked before it can stay - both are built
                 on exact pixel offsets (see PinRowToTop's own comment). -->
            <TreeView x:Name="ExplorerTree"
                    Grid.Row="4"
                    Grid.Column="1"
                    Style="{StaticResource ExplorerTreeViewStyle}"
                      Background="{DynamicResource SidebarBackground}"
                      Foreground="{DynamicResource FolderNameForeground}"
                    FontSize="12"
                    BorderThickness="0"
                    ContextMenu="{StaticResource ExplorerEmptySpaceContextMenu}"
                      ItemContainerStyle="{StaticResource ExplorerTreeViewItemStyle}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Standard"
                      VirtualizingPanel.ScrollUnit="Item"
                      VirtualizingPanel.CacheLengthUnit="Page"
                      VirtualizingPanel.CacheLength="1,1"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      MouseDoubleClick="ExplorerTree_MouseDoubleClick"
                      PreviewMouseLeftButtonDown="ExplorerTree_PreviewMouseLeftButtonDown"
                      PreviewMouseDown="ExplorerTree_PreviewMouseDown"
                      TreeViewItem.Expanded="ExplorerTree_ItemExpandedOrCollapsed"
                      TreeViewItem.Collapsed="ExplorerTree_ItemExpandedOrCollapsed"
                      SelectedItemChanged="ExplorerTree_SelectedItemChanged"
                      PreviewDragOver="ExplorerTree_PreviewDragOver"
                      DragLeave="ExplorerTree_DragLeave"
                      KeyDown="ExplorerTree_KeyDown"
                      PreviewKeyDown="ExplorerTree_PreviewKeyDown"
                      PreviewMouseWheel="ExplorerTree_PreviewMouseWheel"/>

            <!-- Same divider style FavoritesList already draws between itself
                 and the tree below, using the same dedicated "영역 구분선"
                 color (PanelDividerBrush) as that one - anyone who wants it
                 gone can already do that by picking a color that matches the
                 background. Declared last (not right after HeaderGrid) so it
                 paints on top of FavoritesList/ExplorerTree regardless of
                 which one ApplyFavoritesPosition currently has in RowUpper -
                 needed because the -2 bottom margin below deliberately
                 overlaps 2px into whichever of them sits in RowUpper's top edge
                 (see the TODO note: divider 2px lower, header content 1px
                 higher, without moving the header row's own height or the
                 OTHER divider between favorites and the tree). -->
            <!-- Spans all three columns like the header above it, so the line
                 keeps running across the viewer panel's top too. (The column
                 assignment matters at all because the unnamed dividers were
                 the two casualties of the viewer's column split - they sat at
                 the default column 0, which is the zero-width viewer column,
                 and vanished; 2026-08-08.) -->
            <!-- ...and spanning the columns was not enough on its own
                 (2026-08-11). The -2 below puts the line inside ROW 1, where the
                 viewer panel lives, and ViewerPanel is declared further down
                 this file - so over the viewer's column the panel's own
                 background painted straight over it and the line stopped dead at
                 the split. Declaration order cannot fix it here the way it did
                 for the tree: the panel has to come after the thumb and the rest
                 of the split. ZIndex 3 clears both the panel (0) and the split
                 thumb (2). Full screen collapses this Border outright, so the
                 raised line can never appear over a picture. -->
            <!-- The path strip's TOP seat (2026-08-30, on request: every other
                 explorer puts it up here, and this window is tall and narrow so
                 the bottom of it is a long way from the eye).

                 EMPTY UNTIL ASKED FOR. PlacePathBar moves the one PathBarRow
                 into whichever of three seats is right - this, the footer, or
                 the search view's own host - so there is still exactly one
                 strip and one set of handlers, which is what the footer/search
                 pair already bought and is worth keeping.

                 Column 1, like the footer border: the strip belongs to the
                 SIDEBAR, not to the viewer beside it. That is also why the
                 viewer's own four elements span this row rather than starting
                 below it - a picture should not be shortened by the tree's
                 address line. -->
            <Border x:Name="PathBarTopHost"
                    Grid.Row="1"
                    Grid.Column="1"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource PanelDividerBrush}"/>

            <Border x:Name="HeaderUnderline"
                    Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Height="1"
                    Panel.ZIndex="3"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,-2"
                    Background="{DynamicResource PanelDividerBrush}"/>

            <!-- Version footer - same dim treatment as the tree's own "더 보기"
                 row (inherited foreground at reduced opacity) rather than its
                 own color, so it reads as a quiet, out-of-the-way label.
                 Hidden along with the rest of the expanded content (see
                 SetExpandedContentVisibility) when collapsed to the icon-only
                 rail - too narrow for this text, which used to just clip. -->
            <Border x:Name="VersionFooterBorder"
                    Grid.Row="5"
                    Grid.Column="1"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource PanelDividerBrush}">
                <!-- This is the strip's BOTTOM seat, and it is still the default.
                     It rides inside the footer border rather than in a row of
                     its own, which costs nothing while it is down here:
                     SetExpandedContentVisibility already hides this border and
                     zeroes the row, and the search overlay already covers it.

                     THE NOTE HERE USED TO ARGUE AGAINST A ROW AT ALL - the price
                     being renumbering every child and bumping RowSpan on the five
                     that spanned rows 1-4. That price was paid on 2026-08-30 for
                     the top seat, and it came to thirteen edits made in one pass
                     with check-text's Grid.Row rule watching. The argument was
                     sound and simply stopped applying once the strip had somewhere
                     else to be. -->
                <StackPanel x:Name="FooterStack" Orientation="Vertical">
                    <!-- Collapsed unless the option is on (ApplyPathBarVisibility) -
                         a StackPanel child at Collapsed takes no height, so the
                         footer keeps being exactly the chip strip when it's off. -->
                    <!-- Bottom 5 → 2, and the chip strip's bottom 3 → 6. The
                         three pixels are MOVED rather than added: the footer's
                         total height is unchanged, so this row does not shift
                         on screen at all (asked for: lift the chips, leave the
                         path where it is) while the strip below comes off the
                         window's edge. The air was in the wrong half - there
                         was more of it between two things that are obviously
                         separate than under the last row, where the window
                         ends. -->
                    <!-- 트리 히스토리's two buttons live at the right end, OUTSIDE
                         the field's outline: they are not part of what the box
                         accepts. The field's three layers carry no Grid.Column
                         and so stay in the star column they always had. -->
                    <!-- FOLLOWS Ctrl +/- (2026-08-15). Every size in this row
                         used to be a literal, and the argument for that is
                         still sound in itself - a row where one control
                         answered the zoom and the rest did not would read as
                         broken. What it missed is that the row does not stand
                         alone: it is the last strip of a sidebar whose tree,
                         chips and menus all take the zoom, so the row holding
                         still WAS the odd one out, just at a level up. On a
                         1920-wide screen, where the font is turned down to fit
                         the sidebar in a quarter of the width, a 24px strip of
                         12pt text under a 9pt tree is the tallest thing on the
                         bottom of the window. So the literals become resources
                         - all of them together, which is what the original
                         comment actually asked for. -->
                    <Grid x:Name="PathBarRow"
                            Margin="{DynamicResource PathBarRowMargin}"
                            Height="{DynamicResource PathBarRowHeight}"
                            Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Same outline-only treatment as the search box: a
                             border, not a filled field. -->
                        <Border Background="Transparent"
                                BorderBrush="{DynamicResource ControlBorder}"
                                BorderThickness="1"
                                CornerRadius="3"/>
                        <TextBlock x:Name="PathBarPlaceholder"
                                Text="{x:Static services:Strings.PathBarPlaceholder}"
                                Foreground="{DynamicResource SecondaryForeground}"
                                Opacity="0.55"
                                FontSize="{DynamicResource PathBarFontSize}"
                                IsHitTestVisible="False"
                                VerticalAlignment="Center"
                                Margin="7,0,0,0"/>
                        <TextBox x:Name="PathBarBox"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource DialogForeground}"
                                CaretBrush="{DynamicResource ForegroundText}"
                                FontSize="{DynamicResource PathBarFontSize}"
                                Padding="6,0"
                                VerticalContentAlignment="Center"
                                TextChanged="PathBarBox_TextChanged"
                                PreviewKeyDown="PathBarBox_PreviewKeyDown"
                                PreviewMouseLeftButtonDown="PathBarBox_PreviewMouseLeftButtonDown"
                                GotKeyboardFocus="PathBarBox_GotKeyboardFocus"
                                LostKeyboardFocus="PathBarBox_LostKeyboardFocus"/>
                        <!-- The SAME chevrons the carousel walks a folder with,
                             which is the pair this app already means "one step
                             either way" by. They take the row's resources for
                             the reason the row's own comment gives: the whole
                             strip moves together or none of it does, and it now
                             moves.

                             The style brings its own disabled state (0.45), so
                             the end of the stack shows as a greyed chevron that
                             stays in place rather than a button that vanishes
                             and shifts its neighbour.

                             A RESTING OUTLINE, the path field's own brush: these
                             two stand alone on a strip with no other controls,
                             where a header button always has five neighbours to
                             read as a row with. The box beside them is drawn as
                             an outline rather than a filled field, so matching it
                             makes the three read as one strip. Only the disabled
                             state drops the fill; the outline stays either way,
                             which is what keeps the row from twitching as the
                             ends of the stack come and go. -->
                        <Button x:Name="TreeHistoryBackButton"
                                Grid.Column="1"
                                Style="{StaticResource ToggleButtonStyle}"
                                BorderBrush="{DynamicResource ControlBorder}"
                                BorderThickness="1"
                                Width="{DynamicResource PathBarButtonSize}"
                                Height="{DynamicResource PathBarButtonSize}"
                                Margin="4,0,0,0"
                                Click="TreeHistoryBackButton_Click"
                                PreviewMouseRightButtonUp="TreeHistoryChevron_PreviewMouseRightButtonUp"
                                ToolTip="{x:Static services:Strings.TreeHistoryBack}">
                            <Path Data="M576-240 336-480l240-240 51 51-189 189 189 189-51 51Z"
                                    Fill="{DynamicResource ForegroundText}"
                                    Stretch="Uniform"
                                    Width="{DynamicResource PathBarGlyphSize}"
                                    Height="{DynamicResource PathBarGlyphSize}"/>
                        </Button>
                        <Button x:Name="TreeHistoryForwardButton"
                                Grid.Column="2"
                                Style="{StaticResource ToggleButtonStyle}"
                                BorderBrush="{DynamicResource ControlBorder}"
                                BorderThickness="1"
                                Width="{DynamicResource PathBarButtonSize}"
                                Height="{DynamicResource PathBarButtonSize}"
                                Margin="2,0,0,0"
                                Click="TreeHistoryForwardButton_Click"
                                PreviewMouseRightButtonUp="TreeHistoryChevron_PreviewMouseRightButtonUp"
                                ToolTip="{x:Static services:Strings.TreeHistoryForward}">
                            <Path Data="M522-480 333-669l51-51 240 240-240 240-51-51 189-189Z"
                                    Fill="{DynamicResource ForegroundText}"
                                    Stretch="Uniform"
                                    Width="{DynamicResource PathBarGlyphSize}"
                                    Height="{DynamicResource PathBarGlyphSize}"/>
                        </Button>
                        <!-- The stack the two chevrons walk, as a list. It is the
                             SAME "list_arrow" the search box uses for its own
                             history, because it is the same promise - a list
                             comes down - and the app should not learn a second
                             glyph for it.
                             OUTSIDE the field's outline, with the chevrons and
                             wearing their outline rather than the search
                             button's borderless look. Position is what says
                             which history this is: inside the box it would read
                             as "paths typed into this box", which is not what
                             the stack holds - most of its places were reached by
                             clicking a row.
                             It stays usable when either chevron is dead: a
                             disabled WPF button takes no mouse events at all, so
                             right-clicking 뒤로 at the start of the stack does
                             nothing, and this button is then the only way in. -->
                        <Button x:Name="TreeHistoryListButton"
                                Grid.Column="3"
                                Style="{StaticResource ToggleButtonStyle}"
                                BorderBrush="{DynamicResource ControlBorder}"
                                BorderThickness="1"
                                Width="{DynamicResource PathBarButtonSize}"
                                Height="{DynamicResource PathBarButtonSize}"
                                Margin="2,0,0,0"
                                Click="TreeHistoryListButton_Click"
                                ToolTip="{x:Static services:Strings.TreeHistoryList}">
                            <!-- Its own size, larger than the chevrons': this
                                 mark carries the "M0-960H960M0 0H960" tail, which
                                 fits the ink to the whole 960 box and so draws
                                 smaller than a mark without it at the same
                                 number. -->
                            <Path Data="M240-192 96-336l50-50 58 57v-391h72v391l57-57 51 50-144 144Zm240-48v-72h384v72H480Zm0-204v-72h384v72H480Zm0-204v-72h384v72H480Z M0-960H960M0 0H960"
                                    Fill="{DynamicResource ForegroundText}"
                                    Stretch="Uniform"
                                    Width="{DynamicResource PathBarListGlyphSize}"
                                    Height="{DynamicResource PathBarListGlyphSize}"/>
                        </Button>

                        <!-- Opens UPWARD: this strip sits at the bottom of the
                             window, and it follows the search view down there
                             too, so Bottom placement would put the list off the
                             screen and let WPF flip it back on its own terms.
                             Anchored to the whole row rather than the button so
                             a long path has the full strip width to be read in.
                             The popup lives inside PathBarRow so MovePathBarInto
                             carries it between the two views along with
                             everything else on the strip. -->
                        <Popup x:Name="TreeHistoryPopup"
                                PlacementTarget="{Binding ElementName=PathBarRow}"
                                Placement="Top"
                                StaysOpen="False"
                                AllowsTransparency="True"
                                PopupAnimation="Fade">
                            <Border Background="{DynamicResource PanelBackground}"
                                    BorderBrush="{DynamicResource PanelBorder}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Width="{Binding ActualWidth, ElementName=PathBarRow}"
                                    Effect="{DynamicResource MenuDropShadow}"
                                    Margin="0,8,0,2">
                                <ListBox x:Name="TreeHistoryList"
                                        Style="{StaticResource FavoritesListBoxStyle}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        MaxHeight="220"
                                        Padding="2"
                                        ItemContainerStyle="{StaticResource PopupListItemStyle}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        ScrollViewer.CanContentScroll="False"
                                        PreviewMouseLeftButtonUp="TreeHistoryList_PreviewMouseLeftButtonUp">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Where the tree is standing now.
                                                     A bar rather than lighter text:
                                                     nothing in this app marks a
                                                     state by fading the words.
                                                     NOT the accent blue: blue is
                                                     this app's word for BOOKMARK
                                                     (the tree's marker glyph, the
                                                     bookmark panel's own bar), so a
                                                     blue bar here read as "this
                                                     folder is bookmarked" rather
                                                     than "you are here" (user,
                                                     2026-08-14). The parent line's
                                                     grey below is already proven in
                                                     both themes, and a grey bar
                                                     reads as structure, not as a
                                                     mark on the folder. -->
                                                <Border x:Name="CurrentMark"
                                                        Grid.Column="0"
                                                        Width="3"
                                                        CornerRadius="1.5"
                                                        Background="Transparent"
                                                        Margin="0,1,7,1"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}"
                                                            Foreground="{DynamicResource DialogForeground}"
                                                            FontSize="12"
                                                            TextTrimming="CharacterEllipsis"/>
                                                    <!-- The parent, one size down -
                                                     two folders called "img" are
                                                     the whole reason this line is
                                                     here. CharacterEllipsis, never
                                                     MiddleEllipsis: that one parses
                                                     and then throws at runtime. -->
                                                    <TextBlock x:Name="ParentLine"
                                                            Text="{Binding Parent}"
                                                            Foreground="{DynamicResource SecondaryForeground}"
                                                            FontSize="10"
                                                            TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}"
                                                        Value="True">
                                                    <Setter TargetName="CurrentMark"
                                                            Property="Background"
                                                            Value="{DynamicResource SecondaryForeground}"/>
                                                </DataTrigger>
                                                <!-- A drive root has no parent to
                                                     show; an empty line would still
                                                     take its height. -->
                                                <DataTrigger Binding="{Binding Parent}"
                                                        Value="">
                                                    <Setter TargetName="ParentLine"
                                                            Property="Visibility"
                                                            Value="Collapsed"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- The version, and then one toggle per file-kind filter
                         (built in code from the same table the menus use - see
                         RebuildFooterFilterChips). Putting them here rather than
                         only in the menus is the point: this strip is where a
                         filter announces itself, so it is where the hand already
                         is when it needs changing.

                         WrapPanel, so a narrow window costs a second line instead
                         of cutting chips off the end. -->
                    <!-- The gap BETWEEN wrapped rows is a top margin on the chips
                         themselves (see AddFooterFilterChip) - a panel's margin
                         sits outside all of them and leaves two lines touching.
                         Top rather than bottom so this panel keeps owning the space
                         under the last row: the two together read as one strip with
                         even air above and below, which a chip-side bottom margin
                         could not do without this going to zero and the strip
                         sitting on the window's edge.
                         Which is what it was doing anyway at 3 (reported with a
                         screenshot, 2026-08-10: "칩버튼이 바닥에 아예 붙어서
                         보입니다"). Now 6, taken from the path row above rather
                         than added, so the footer is the same height with the
                         path bar showing. With it hidden - the default - this
                         panel IS the footer, so there the footer does grow by
                         those 3px, which is the same fix in the configuration
                         that needed it just as much. -->
                    <WrapPanel x:Name="VersionFooterPanel"
                            Orientation="Horizontal"
                            Margin="8,1,4,6">
                    </WrapPanel>
                    <!-- WHAT IS STILL PLAYING WITH THE PANEL SHUT.
                         배경 재생 keeps a track going when the tree moves
                         elsewhere, and closing the viewer is the same kind of
                         move - so the sound carries on. That leaves a state with
                         no transport on screen: nothing says what is playing,
                         nothing stops it, and the track is held open so it
                         cannot be renamed or deleted either. This row is the
                         answer to all three.

                         Only while the viewer is SHUT. Open, the transport says
                         and does the same things a few pixels up, and two of
                         them would be two places to look.

                         A plain row rather than something that slides or
                         toggles: hiding it behind a gesture costs more than the
                         line it saves (the user's call). It costs no height at
                         all when there is nothing to say - a Collapsed
                         StackPanel child takes none, which is how the path bar
                         above comes and goes - so the footer only grows while a
                         track is held, which is a state the user switched on. -->
                    <Grid x:Name="FooterNowPlayingRow"
                            Margin="8,2,8,6"
                            Visibility="Collapsed">
                        <!-- FIVE: mark, name, the sound mark, play/pause, stop.
                             Columns 2 and 3 both arrived 2026-08-26 and each
                             time the plate's ColumnSpan and the stop button's
                             own column had to move with them - WPF says nothing
                             about a child addressing a column that was never
                             defined, it just files the overflow into the last
                             one. Three places, every time. -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- THE SAME PLATE THE TRANSPORT WEARS, on purpose
                             (2026-08-13, user request: "우측의 음악 콘트롤 영역
                             톤으로 맞춰"). Same brush, same opacity, same corner
                             as ViewerMediaPlate's detached state - not a colour
                             copied across, because the two are the same thing
                             said in two places and a second number would drift
                             from the first.

                             ...AND THAT WAS NOT ENOUGH. Copying the recipe was
                             tried first and measured: the plate landed on
                             #252628 over a #191619 ground, i.e. exactly the
                             colour the transport's own plate resolves to, and
                             still read as far weaker ("좀 많이 약한데요"). Same
                             colour, different job - the transport's plate is a
                             tall block under a whole bank of controls, while
                             this is one thin strip, and twelve levels of lift
                             that carry a block do not carry a line.
                             So the brush moves up a step: a raised surface,
                             not a hover wash, for about thirty levels over the
                             ground. That the two are no longer the same value
                             is the point - matching them by number was what
                             failed to match them by eye.

                             Its own element behind the row rather than a
                             background on the Grid, for the reason the viewer's
                             carries: opacity on the container would take the
                             name and the buttons down with it. -->
                        <!-- Spans the row and reaches a little past the content
                             on every side, so the mark and the stop button sit
                             INSIDE it rather than on its rim - the padding the
                             user allowed for ("영역과 패딩이 살짝 들어와도
                             괜찮습니다"). The row's own margin was widened by the
                             same amounts, so the plate lands where the content
                             used to and nothing moves outward. -->
                        <!-- AND THE WHOLE PLATE LIFTS UNDER THE POINTER, keyed
                             off the ROW rather than off itself: the plate sits
                             behind its own siblings, so its own IsMouseOver
                             would only be true in the gaps between them and the
                             lift would flicker as the hand crossed the name.
                             The row is the thing the hand is over.

                             One step, deliberately small (the user's "살짝").
                             The name keeps its own brighter fill on top, and
                             the two are saying different things - the plate
                             says this row is live, the fill says which part of
                             it you are about to hit. -->
                        <Border Grid.ColumnSpan="5"
                                Margin="-4,-2,-4,-2"
                                Background="{DynamicResource ControlBackground}"
                                CornerRadius="6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0.85"/>
                                    <Style.Triggers>
                                        <DataTrigger Value="True"
                                                Binding="{Binding IsMouseOver,
                                                    ElementName=FooterNowPlayingRow}">
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <!-- Material Symbols "music_note" at optical size 20, the
                             file the author supplied (2026-08-19). The app had the
                             opsz24 cut, which is a different drawing.
                             The row's first job: a track 배경 재생 is holding. The
                             film mark below is the second. -->
                        <Path x:Name="FooterNowPlayingMusicMark"
                                Grid.Column="0"
                                Data="M306-186q-42-42-42-102t42-102q42-42 102-42 20 0 38 5.5t34 14.5v-404h216v144H552v384q0 60-42 102t-102 42q-60 0-102-42Z"
                                Stretch="Uniform"
                                Width="{DynamicResource ViewerChipIconSize}"
                                Height="{DynamicResource ViewerChipIconSize}"
                                Fill="{DynamicResource ForegroundText}"
                                VerticalAlignment="Center"
                                Margin="0,0,5,0">
                            <!-- Comes up with the plate, off the same row, so
                                 the strip answers the pointer as ONE thing
                                 rather than as a lit background with a dim mark
                                 still sitting on it. Opacity is the right tool
                                 here and only here in this row - see the note
                                 on the name below. -->
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Opacity" Value="0.65"/>
                                    <Style.Triggers>
                                        <DataTrigger Value="True"
                                                Binding="{Binding IsMouseOver,
                                                    ElementName=FooterNowPlayingRow}">
                                            <Setter Property="Opacity" Value="0.9"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <!-- Material Symbols "play_arrow", for the OTHER thing
                             this row can name (2026-08-19): a film that was
                             stopped when the tree moved away, waiting to be
                             continued. Both marks live in the XAML and one is
                             shown, the way the transport's own play/pause pair
                             does - a Path assigned from code would put the
                             artwork out of reach of the row's sizing.
                             A play triangle rather than a film reel because the
                             row is not reporting a state here, it is offering
                             one press: continue watching this.
                             The style is repeated rather than shared. It is
                             twelve lines either way once a resource key and its
                             lookup are counted, and a local style is read where
                             it is used. -->
                        <Path x:Name="FooterNowPlayingFilmMark"
                                Grid.Column="0"
                                Data="M336-216v-528l408 264-408 264Zm73-265Zm-1 133 204-132-204-132v264Z"
                                Stretch="Uniform"
                                Visibility="Collapsed"
                                Width="{DynamicResource ViewerChipIconSize}"
                                Height="{DynamicResource ViewerChipIconSize}"
                                Fill="{DynamicResource ForegroundText}"
                                VerticalAlignment="Center"
                                Margin="0,0,5,0">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Opacity" Value="0.65"/>
                                    <Style.Triggers>
                                        <DataTrigger Value="True"
                                                Binding="{Binding IsMouseOver,
                                                    ElementName=FooterNowPlayingRow}">
                                            <Setter Property="Opacity" Value="0.9"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <!-- The name is the way BACK: clicking it opens the
                             viewer on the track it names, which is the same
                             direction the tree row menu's 보기 goes. One rule,
                             two places. -->
                        <!-- Deliberately NOT one of the footer's chip buttons.
                             Those templates draw Content THROUGH a TextBlock, so
                             a TextBlock put in one renders as nothing at all -
                             which is what happened here first, and is the same
                             trap the ...GlyphChipStyle variants exist for. A
                             chip's outlined box would be wrong besides: the row
                             has one button in it, and this is a label that
                             happens to be clickable.

                             Background=Transparent so it hit-tests across its
                             whole width rather than only where the glyphs are. -->
                        <!-- The hover is the chips' own - their fill, their
                             corner, and the same step from 0.65 to full ink -
                             because this sits in their row and has to answer to
                             the pointer the way they do. Without it the name
                             read as dead text and nobody would learn it could be
                             pressed (2026-08-12).

                             The Border carries the press rather than the
                             TextBlock: it fills the column, so the target is the
                             whole strip between the mark and the stop button,
                             not just the glyphs. -->
                        <Border x:Name="FooterNowPlayingHit"
                                Grid.Column="1"
                                Background="Transparent"
                                CornerRadius="3"
                                Padding="4,2"
                                Margin="0,0,4,0"
                                Cursor="Hand"
                                MouseLeftButtonUp="FooterNowPlaying_Click">
                            <!-- THE NAME IS NO LONGER DIMMED AT REST (2026-08-13).
                                 It sat at 0.65 so the row would read as quiet,
                                 which measured out as #7A7C7F ink on the plate
                                 - the "hover를 해도 글자가 잘 안보이구요" half of
                                 the same report, and the exact thing
                                 [[never-dim-menu-text]] is about: text says
                                 "secondary" with size, never with opacity. The
                                 mark to its left keeps its own 0.65, because
                                 that rule is about text and a glyph is where
                                 opacity is the right tool.

                                 The hover fill moved up with the plate. The
                                 tree's own hover ink is #2A2C32, which was a
                                 step above the bare footer and is a step BELOW
                                 the plate now - so hovering did nothing
                                 visible. A hover has to be brighter than
                                 whatever it lands on, and what it lands on
                                 here is a raised surface. -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource ControlHoverBackground}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <!-- Foreground lives in the STYLE, not on the
                                 element: a local value would silently beat the
                                 row-hover trigger below and the name would be
                                 the one thing on the strip that failed to
                                 answer (the local-Margin lesson, same rule).
                                 The step is ForegroundText -> HighlightForeground,
                                 the same pair the chips' own hover uses. -->
                            <TextBlock x:Name="FooterNowPlayingText"
                                    FontSize="{DynamicResource FooterChipFontSize}"
                                    TextTrimming="CharacterEllipsis"
                                    VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource ForegroundText}"/>
                                        <Style.Triggers>
                                            <DataTrigger Value="True"
                                                    Binding="{Binding IsMouseOver,
                                                        ElementName=FooterNowPlayingRow}">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource HighlightForeground}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <!-- STOP, not pause. Half of what this row is for is
                             that the switch which releases the file lives in the
                             transport, and the transport is gone - so the button
                             here has to be the one that lets go, or the lock
                             stays with no way out of it. -->
                        <!-- A SOUND MARK THAT MOVES, because the row itself was
                             not catching the eye of someone working in the tree
                             (2026-08-26, relayed request). See SoundPulseStyle
                             for the shape, the periods, and why it is not a
                             meter. The viewer's 지금 재생 중 line carries the
                             same mark.

                             Only for a TRACK. This row also carries a held
                             FILM, which has no sound going at all, and a mark
                             that means "playing" cannot appear over one that is
                             not (UpdateFooterNowPlaying hides it).

                             FULL STRENGTH AND IN THE ACCENT (2026-09-14). It
                             used to rest at 0.65 in the row's text colour and
                             step to 0.9 under the pointer, so the strip
                             brightened as one quiet thing (2026-08-13). That
                             made it the thing hardest to find: this row is how
                             a playing track is reached again, and an indicator
                             drawn in the same ink as the file name beside it
                             does not stand out from a glance across the screen.
                             The moving bars are the one mark that means
                             "playing", so they are the one that gets the colour.

                             The colour arrives by re-pointing ForegroundText
                             HERE rather than by editing SoundPulseStyle: the
                             bars take their Fill from that key inside the
                             template, a DynamicResource lookup finds this
                             element's own entry first, and the viewer's copy
                             of the pulse sits in a different strip with a
                             different contract and keeps its own ink. -->
                        <ContentControl x:Name="FooterNowPlayingPulse"
                                Grid.Column="2"
                                Margin="0,0,6,0"
                                Visibility="Collapsed">
