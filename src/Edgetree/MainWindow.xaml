                    </Grid>
                </StackPanel>
            </Border>

            <!-- File-search view. Overlays the whole content area below the
                 header (rows 1-4: favorites, splitter, tree, version footer) -
                 opaque background, so toggling it on replaces "the screen except
                 the title bar" exactly as the spec asks, while the tree
                 underneath keeps its state for an instant toggle back. Declared
                 last so it paints on top of everything it covers; Collapsed
                 until the search button / Ctrl+F activates it (see
                 SetSearchViewActive). -->
            <Grid x:Name="SearchView"
                    Grid.Row="2"
                    Grid.RowSpan="4"
                    Grid.Column="1"
                    Background="{DynamicResource SidebarBackground}"
                    Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Controls group: scope row + input row, on the same slightly-
                     darker background the favorites panel uses, with the same
                     bottom divider. -->
                <StackPanel Grid.Row="0"
                        Background="{DynamicResource FavoritesBackground}">
                    <!-- Scope row: path + the two things that change WHAT is
                         searched and HOW it is ordered. Reindexing moved out of
                         here to the status line (2026-07-28) - it acts on the
                         results, so it belongs beside the line that describes
                         them, and the path gets the width back. -->
                    <Grid Margin="6,6,6,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SearchScopeText"
                                Grid.Column="0"
                                Text="{x:Static services:Strings.SearchScopeNone}"
                                Foreground="{DynamicResource ForegroundText}"
                                Opacity="0.75"
                                FontSize="11"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <Button x:Name="SearchBrowseButton"
                                Grid.Column="1"
                                Style="{StaticResource ToggleButtonStyle}"
                                Width="26"
                                Height="26"
                                Margin="4,0,0,0"
                                Click="SearchBrowseButton_Click"
                                ToolTip="{x:Static services:Strings.SearchTooltipBrowseFolder}">
                            <!-- Material Symbols "folder" (
                                 2026-08-10), replacing a hand-drawn solid
                                 folder. Outlined like the rest of the family,
                                 which also stops it competing with the FILLED
                                 folder icons the tree draws for real folders -
                                 this button picks a folder, it is not one. -->
                            <Path Data="M168-192q-29 0-50.5-21.5T96-264v-432q0-29.7 21.5-50.85Q139-768 168-768h216l96 96h312q29.7 0 50.85 21.15Q864-629.7 864-600v336q0 29-21.15 50.5T792-192H168Zm0-72h624v-336H450l-96-96H168v432Zm0 0v-432 432Z M0-960H960M0 0H960"
                                    Fill="{DynamicResource ForegroundText}"
                                    Stretch="Uniform"
                                    Width="{DynamicResource HeaderGlyphBox}"
                                    Height="{DynamicResource HeaderGlyphBox}"/>
                        </Button>
                        <!-- Results-only sort (folder grouping / name / date,
                             asc/desc). Click opens the menu below rather than
                             stepping to the next of five states - the same call
                             the tree's own sort icon made on 2026-07-26, for the
                             same reason: five states already took four clicks to
                             reach the last one, and a picture that has to encode
                             all five explains none of them.

                             The glyph is the tree's own sort geometry (set from
                             UpdateSearchSortIcon), so it takes the row brush and
                             follows light/dark with no second asset - this was
                             the last PNG pair in the app. ToolTip is set there
                             too, since it names the active mode. -->
                        <Button x:Name="SearchSortButton"
                                Grid.Column="2"
                                Style="{StaticResource ToggleButtonStyle}"
                                Width="26"
                                Height="26"
                                Margin="0"
                                ContextMenu="{StaticResource SearchSortContextMenu}"
                                Click="SearchSortButton_Click">
                            <Path x:Name="SearchSortIcon"
                                    Width="10"
                                    Height="14"
                                    Stretch="Uniform"
                                    Fill="{DynamicResource ForegroundText}"/>
                        </Button>
                        <!-- The way out, inside the view it leaves. The header's
                             search button already does this, but it is anchored
                             to the top of the WINDOW - and the window grows by a
                             whole panel when the viewer opens, so the button
                             walks away from the hand exactly when the search
                             view is being used most (2026-08-11). A control that
                             ends something belongs next to the thing it ends.

                             Material Symbols "close". The X was freed when the
                             header's own close button became a minimize bar
                             (see CloseButton) - and unlike that one, this really
                             does end what it sits on, so the glyph is honest
                             here.

                             Set apart from its two neighbours by the margin:
                             those change WHAT is searched and HOW it is ordered,
                             this leaves. -->
                        <Button x:Name="SearchCloseButton"
                                Grid.Column="3"
                                Style="{StaticResource ToggleButtonStyle}"
                                Width="26"
                                Height="26"
                                Margin="6,0,0,0"
                                Click="SearchCloseButton_Click"
                                ToolTip="{x:Static services:Strings.ToolTipExitSearch}">
                            <Path Data="M256-200l-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z M0-960H960M0 0H960"
                                    Fill="{DynamicResource ForegroundText}"
                                    Stretch="Uniform"
                                    Width="{DynamicResource HeaderGlyphBox}"
                                    Height="{DynamicResource HeaderGlyphBox}"/>
                        </Button>
                    </Grid>

                    <!-- Input row: search box + history caret. The placeholder is
                         a TextBlock behind the box, hidden once there's text
                         (see SearchBox_TextChanged). -->
                    <Grid Margin="6,0,6,6"
                            Height="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Outline only (transparent fill), per request - the
                             box reads as a border, not a filled field. -->
                        <Border Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Background="Transparent"
                                BorderBrush="{DynamicResource ControlBorder}"
                                BorderThickness="1"
                                CornerRadius="3"/>
                        <Grid Grid.Column="0">
                            <TextBlock x:Name="SearchPlaceholder"
                                    Text="{x:Static services:Strings.SearchBoxPlaceholder}"
                                    Foreground="{DynamicResource SecondaryForeground}"
                                    Opacity="0.55"
                                    FontSize="12"
                                    IsHitTestVisible="False"
                                    VerticalAlignment="Center"
                                    Margin="7,0,0,0"/>
                            <TextBox x:Name="SearchBox"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource DialogForeground}"
                                    CaretBrush="{DynamicResource ForegroundText}"
                                    FontSize="12"
                                    Padding="6,0"
                                    VerticalContentAlignment="Center"
                                    TextChanged="SearchBox_TextChanged"
                                    PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                        </Grid>
                        <!-- Kept a few px shorter than the 26px box and centered
                             so its hover highlight sits inside the outline
                             instead of covering the top/bottom border line. -->
                        <Button x:Name="SearchHistoryButton"
                                Grid.Column="1"
                                Style="{StaticResource ToggleButtonStyle}"
                                Width="22"
                                Height="20"
                                VerticalAlignment="Center"
                                Margin="0,0,3,0"
                                Click="SearchHistoryButton_Click"
                                ToolTip="{x:Static services:Strings.SearchTooltipHistory}">
                            <!-- Material Symbols "list_arrow" (
                                 2026-08-10), replacing a bare down-chevron.
                                 The chevron only said "down"; this says a LIST
                                 comes down, which is what the button opens -
                                 and it stops reading as the same caret the
                                 tree's expanders use for something else
                                 entirely. -->
                            <Path Data="M240-192 96-336l50-50 58 57v-391h72v391l57-57 51 50-144 144Zm240-48v-72h384v72H480Zm0-204v-72h384v72H480Zm0-204v-72h384v72H480Z M0-960H960M0 0H960"
                                    Fill="{DynamicResource ForegroundText}"
                                    Stretch="Uniform"
                                    Width="{DynamicResource HeaderGlyphBox}"
                                    Height="{DynamicResource HeaderGlyphBox}"/>
